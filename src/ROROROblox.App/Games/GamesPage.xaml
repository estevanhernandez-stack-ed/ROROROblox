<UserControl x:Class="ROROROblox.App.Games.GamesPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:ROROROblox.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ROROROblox.App.Controls"
             xmlns:games="clr-namespace:ROROROblox.App.Games">

    <!--
        The Library (v1.36 item 9): grid or list of everything RoRoRo can launch, one box that filters
        what you have and takes a pasted link, kind chips, and Play / Play as on every entry. Built to the
        C1 mock (square icon tiles) and D2 (Play as picker). The page decides nothing: every rule lives in
        LibraryViewModel; the code-behind wires events, opens the rename window and the picker, and
        focuses the box.

        THREE RULES FROM THE CYCLE'S OWN MISTAKES.
        1. A button style's triggers carry Visibility / IsEnabled setters only. The chips' check glyph is
           its own TextBlock whose Visibility binds to the view model; no trigger swaps Content.
        2. Nothing here prints English from a format string: every sentence is a resx key (the
           NoRawXamlProseFence), and the creator / player lines come from FromRobloxItem.
        3. No stock dialog box. Remove asks in the bar under the box.
    -->

    <UserControl.Resources>
        <!-- Pill-less chip: the rank is the app's secondary toggle; the check glyph beside the label is the
             second signal, so flatline (which collapses colour) can still tell on from off. -->
        <Style x:Key="LibraryChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource SecondaryToggleButtonStyle}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="LibraryViewToggleStyle" TargetType="RadioButton" BasedOn="{StaticResource SecondaryToggleButtonStyle}">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- The container draws nothing and takes no focus: the buttons inside each tile are the tab stops,
             so Tab walks Play, Play as, more for every entry in order. -->
        <Style x:Key="LibraryItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,0,10,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource LibraryItemContainerStyle}" />
        </Style>

        <!-- The entry's themed menu: the same recipe as the Play as picker, text items only. -->
        <Style x:Key="LibraryMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Chrome" Padding="{TemplateBinding Padding}" CornerRadius="4"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DividerBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource InteractiveEdgeBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryMenuStyle" TargetType="ContextMenu">
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource NavyBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="4" SnapsToDevicePixels="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One menu per entry (x:Shared false), shared by the grid tile, the list row and the more button.
             The items read the entry's own words, so a Recent place (not saved) offers nothing it cannot do. -->
        <ContextMenu x:Key="LibraryEntryMenu" x:Shared="False" Style="{StaticResource LibraryMenuStyle}">
            <MenuItem Header="{loc:Loc GamesPage_SetDefault}" Tag="{Binding}" Click="OnSetDefaultClick"
                      AutomationProperties.Name="{loc:Loc GamesPage_SetDefault}"
                      Style="{StaticResource LibraryMenuItemStyle}"
                      IsEnabled="{Binding CanSetDefault}" />
            <MenuItem Header="{loc:Loc GamesPage_ClearDefault}" Tag="{Binding}" Click="OnClearDefaultClick"
                      AutomationProperties.Name="{loc:Loc GamesPage_ClearDefault}"
                      Style="{StaticResource LibraryMenuItemStyle}"
                      IsEnabled="{Binding CanClearDefault}" />
            <MenuItem Header="{loc:Loc GamesPage_Rename}" Tag="{Binding}" Click="OnRenameClick"
                      AutomationProperties.Name="{loc:Loc GamesPage_Rename}"
                      Style="{StaticResource LibraryMenuItemStyle}"
                      IsEnabled="{Binding IsSaved}" />
            <MenuItem Header="{loc:Loc GamesPage_ResetName}" Tag="{Binding}" Click="OnResetNameClick"
                      AutomationProperties.Name="{loc:Loc GamesPage_ResetName}"
                      Style="{StaticResource LibraryMenuItemStyle}"
                      IsEnabled="{Binding CanResetName}" />
            <MenuItem Header="{loc:Loc GamesPage_Remove}" Tag="{Binding}" Click="OnRemoveClick"
                      AutomationProperties.Name="{loc:Loc GamesPage_Remove}"
                      Style="{StaticResource LibraryMenuItemStyle}"
                      IsEnabled="{Binding IsSaved}" />
        </ContextMenu>

        <!-- List column widths, shared by the header and every row so they line up. The right block is one fixed cell:
             Play, Play as and the more button, wide enough for the longest of the six languages. -->
        <GridLength x:Key="ListKindWidth">84</GridLength>
        <GridLength x:Key="ListLastWidth">108</GridLength>
        <GridLength x:Key="ListTotalWidth">56</GridLength>
        <GridLength x:Key="ListActionsWidth">216</GridLength>

        <!-- DEFAULT / PRIVATE as words in an outlined tag (item 7's recipe): the word carries it, colour does not. -->
        <DataTemplate x:Key="LibraryTagsTemplate" DataType="{x:Type games:LibraryItem}">
            <StackPanel Orientation="Horizontal">
                <Border BorderBrush="{DynamicResource MutedTextBrush}" BorderThickness="1" CornerRadius="3"
                        Padding="5,0" Margin="0,0,4,0" VerticalAlignment="Center"
                        Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{loc:Loc Shell_Panel_Tag_Default}"
                               FontSize="{DynamicResource MetaFontSize}" FontWeight="Bold"
                               Foreground="{DynamicResource WhiteBrush}" />
                </Border>
                <Border BorderBrush="{DynamicResource MutedTextBrush}" BorderThickness="1" CornerRadius="3"
                        Padding="5,0" Margin="0,0,4,0" VerticalAlignment="Center"
                        Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{loc:Loc Shell_Panel_Tag_Private}"
                               FontSize="{DynamicResource MetaFontSize}" FontWeight="Bold"
                               Foreground="{DynamicResource WhiteBrush}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- C1: a square icon tile. Fixed size, because the grid virtualises on a known item size. -->
        <DataTemplate x:Key="LibraryTileTemplate" DataType="{x:Type games:LibraryItem}">
            <Border Width="144" Height="246" Padding="8" CornerRadius="8"
                    Background="{DynamicResource RowBgBrush}"
                    ToolTip="{Binding TooltipText}"
                    ContextMenu="{StaticResource LibraryEntryMenu}"
                    Loaded="OnTileLoaded">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Width="128" Height="128" CornerRadius="8" ClipToBounds="True"
                            Background="{DynamicResource NavyBrush}">
                        <Grid>
                            <TextBlock Text="{Binding Initials}"
                                       FontSize="{DynamicResource DisplayFontSize}" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                            <Button Content="&#x22EF;"
                                    AutomationProperties.Name="{Binding MoreName}"
                                    ToolTip="{Binding MoreName}"
                                    Click="OnMoreClick"
                                    ContextMenu="{StaticResource LibraryEntryMenu}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    FontSize="{DynamicResource BodyFontSize}"
                                    Padding="0" Width="24" Height="24" Margin="4"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Cursor="Hand"
                                    Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1" Margin="0,6,0,0" Text="{Binding DisplayName}"
                               FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                               Foreground="{DynamicResource WhiteBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Row="2" Margin="0,2,0,0">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LibraryTagsTemplate}" />
                        <TextBlock Text="{Binding MetaText}"
                                   FontSize="{DynamicResource MetaFontSize}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{loc:Loc Library_Play}"
                                AutomationProperties.Name="{Binding PlayName}"
                                AutomationProperties.AutomationId="DangerPlay"
                                Click="OnPlayClick"
                                Style="{StaticResource CtaButtonStyle}"
                                FontSize="{DynamicResource MetaFontSize}"
                                Padding="8,4" Margin="0,0,4,0" />
                        <Button Grid.Column="1" Content="{loc:Loc Library_PlayAs}"
                                AutomationProperties.Name="{Binding PlayAsName}"
                                AutomationProperties.AutomationId="DangerPlayAs"
                                Click="OnPlayAsClick"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="{DynamicResource MetaFontSize}"
                                Padding="5,4" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- The list: one row per entry, the SessionHistoryPage shape (RowBg, radius 6, 12 x 8 padding). The
             column widths are fixed so the header above lines up with every row. -->
        <DataTemplate x:Key="LibraryRowTemplate" DataType="{x:Type games:LibraryItem}">
            <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="6"
                    Background="{DynamicResource RowBgBrush}"
                    ToolTip="{Binding TooltipText}"
                    ContextMenu="{StaticResource LibraryEntryMenu}"
                    Loaded="OnTileLoaded">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource ListKindWidth}" />
                        <ColumnDefinition Width="{StaticResource ListLastWidth}" />
                        <ColumnDefinition Width="{StaticResource ListTotalWidth}" />
                        <ColumnDefinition Width="{StaticResource ListActionsWidth}" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="5" ClipToBounds="True"
                            Background="{DynamicResource NavyBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{Binding Initials}"
                                       FontSize="{DynamicResource MetaFontSize}" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <DockPanel Grid.Column="1" VerticalAlignment="Center" LastChildFill="True">
                        <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource LibraryTagsTemplate}" />
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WhiteBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    </DockPanel>

                    <TextBlock Grid.Column="2" Text="{Binding KindText}" VerticalAlignment="Center"
                               FontSize="{DynamicResource MetaFontSize}" Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="3" Text="{Binding LastPlayedText}" VerticalAlignment="Center"
                               FontSize="{DynamicResource MetaFontSize}" Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="4" Text="{Binding TotalText}" VerticalAlignment="Center"
                               FontSize="{DynamicResource MetaFontSize}" Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{loc:Loc Library_Play}"
                                AutomationProperties.Name="{Binding PlayName}"
                                AutomationProperties.AutomationId="DangerPlay"
                                Click="OnPlayClick"
                                Style="{StaticResource CtaButtonStyle}"
                                FontSize="{DynamicResource MetaFontSize}"
                                Padding="10,4" Margin="0,0,6,0" />
                        <Button Content="{loc:Loc Library_PlayAs}"
                                AutomationProperties.Name="{Binding PlayAsName}"
                                AutomationProperties.AutomationId="DangerPlayAs"
                                Click="OnPlayAsClick"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="{DynamicResource MetaFontSize}"
                                Padding="8,4" Margin="0,0,6,0" />
                        <Grid Width="28">
                            <Button Content="&#x22EF;"
                                    AutomationProperties.Name="{Binding MoreName}"
                                    ToolTip="{Binding MoreName}"
                                    Click="OnMoreClick"
                                    ContextMenu="{StaticResource LibraryEntryMenu}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    FontSize="{DynamicResource BodyFontSize}"
                                    Padding="0" Height="26"
                                    Cursor="Hand"
                                    Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A "From Roblox" search result: the existing Add affordance. -->
        <DataTemplate x:Key="LibraryRobloxResultTemplate" DataType="{x:Type games:FromRobloxItem}">
            <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="6" Background="{DynamicResource RowBgBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4"
                            Background="{DynamicResource NavyBrush}" ClipToBounds="True" VerticalAlignment="Center">
                        <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WhiteBrush}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CreatorText}"
                                       FontSize="{DynamicResource MetaFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="  -  " FontSize="{DynamicResource MetaFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}" Opacity="0.5" />
                            <TextBlock Text="{Binding PlayersText}"
                                       FontSize="{DynamicResource MetaFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2" Content="{loc:Loc GamesPage_Add}"
                            AutomationProperties.Name="{Binding AddName}"
                            Tag="{Binding Result}"
                            Click="OnAddSearchResultClick"
                            Style="{StaticResource CtaButtonStyle}"
                            FontSize="{DynamicResource BodyFontSize}"
                            Padding="12,6" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Title -->
            <RowDefinition Height="Auto" />  <!-- The one box + layout toggle -->
            <RowDefinition Height="Auto" />  <!-- Chips -->
            <RowDefinition Height="Auto" />  <!-- Status, remove confirm, Roblox results -->
            <RowDefinition Height="*" />     <!-- Grid / list / empty -->
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Heading="{loc:Loc GamesPage_Games}" />

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0" x:Name="LibraryBox"
                        PlaceholderText="{loc:Loc Library_Box_Placeholder}"
                        AutomationProperties.Name="{loc:Loc Library_Box_Name}"
                        ToolTip="{loc:Loc Library_Box_Tip}"
                        Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        Icon="{ui:SymbolIcon Search24}"
                        ClearButtonEnabled="True"
                        FontSize="{DynamicResource BodyFontSize}"
                        KeyDown="OnBoxKeyDown" />

            <StackPanel Grid.Column="1" x:Name="LibraryViewToggle" Orientation="Horizontal" Margin="8,0,0,0"
                        AutomationProperties.Name="{loc:Loc Library_View_Name}">
                <RadioButton GroupName="LibraryLayout" Content="{loc:Loc Library_View_Grid}"
                             AutomationProperties.Name="{loc:Loc Library_View_Grid}"
                             IsChecked="{Binding IsGridView, Mode=TwoWay}"
                             Style="{StaticResource LibraryViewToggleStyle}" />
                <RadioButton GroupName="LibraryLayout" Content="{loc:Loc Library_View_List}"
                             AutomationProperties.Name="{loc:Loc Library_View_List}"
                             IsChecked="{Binding IsListView, Mode=TwoWay}"
                             Style="{StaticResource LibraryViewToggleStyle}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" x:Name="LibraryFiltersRow" Orientation="Horizontal" Margin="0,10,0,0"
                    AutomationProperties.Name="{loc:Loc Library_Filters_Name}">
            <ToggleButton AutomationProperties.Name="{loc:Loc Library_Chip_Recent}"
                          IsChecked="{Binding IsRecentOn, Mode=TwoWay}"
                          Style="{StaticResource LibraryChipStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2713;" Margin="0,0,6,0"
                               Visibility="{Binding IsRecentOn, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{loc:Loc Library_Chip_Recent}" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton AutomationProperties.Name="{loc:Loc Library_Chip_Favourites}"
                          IsChecked="{Binding IsFavouritesOn, Mode=TwoWay}"
                          Style="{StaticResource LibraryChipStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2713;" Margin="0,0,6,0"
                               Visibility="{Binding IsFavouritesOn, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{loc:Loc Library_Chip_Favourites}" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton AutomationProperties.Name="{loc:Loc Library_Chip_PrivateServers}"
                          IsChecked="{Binding IsPrivateServersOn, Mode=TwoWay}"
                          Style="{StaticResource LibraryChipStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2713;" Margin="0,0,6,0"
                               Visibility="{Binding IsPrivateServersOn, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{loc:Loc Library_Chip_PrivateServers}" />
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="{DynamicResource BodyFontSize}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}" />

            <!-- The themed remove confirm: a bar in the page, not a window and not a stock dialog. Cancel takes
                 focus when it opens, so Enter and Space do the safe thing. -->
            <Border x:Name="RemoveConfirmBar" Margin="0,8,0,0" Padding="12,8" CornerRadius="6"
                    Background="{DynamicResource RowBgBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                    Visibility="{Binding IsRemoveConfirmOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                    KeyDown="OnRemoveBarKeyDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding RemoveConfirmText}"
                               FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{DynamicResource WhiteBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" x:Name="ConfirmRemoveButton" Content="{loc:Loc GamesPage_Remove}"
                            AutomationProperties.Name="{loc:Loc GamesPage_Remove}"
                            AutomationProperties.AutomationId="DangerRemove"
                            Click="OnConfirmRemoveClick"
                            Style="{StaticResource DestructiveButtonStyle}"
                            FontSize="{DynamicResource BodyFontSize}"
                            Padding="12,6" Margin="12,0,8,0" />
                    <Button Grid.Column="2" x:Name="CancelRemoveButton" Content="{loc:Loc Library_Cancel}"
                            AutomationProperties.Name="{loc:Loc Library_Cancel}"
                            Click="OnCancelRemoveClick"
                            Style="{StaticResource SecondaryStrongButtonStyle}"
                            FontSize="{DynamicResource BodyFontSize}"
                            Padding="12,6" />
                </Grid>
            </Border>

            <Border Margin="0,8,0,0" MaxHeight="220" Padding="8" CornerRadius="8"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                    Visibility="{Binding HasFromRoblox, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{loc:Loc Library_FromRoblox}"
                               FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="{DynamicResource MetaFontSize}" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}" Margin="2,0,0,6" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FromRobloxItems}"
                                      ItemTemplate="{StaticResource LibraryRobloxResultTemplate}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <!-- C1 grid. The panel is WPF-UI's VirtualizingWrapPanel, so 100 saved games realise one screenful of
                 tiles and a scroll recycles them. -->
            <ListBox x:Name="LibraryGrid" Style="{StaticResource LibraryListBoxStyle}"
                     ItemsSource="{Binding Items}"
                     ItemTemplate="{StaticResource LibraryTileTemplate}"
                     Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ui:VirtualizingWrapPanel Orientation="Vertical" ItemSize="144,246" SpacingMode="BetweenItemsOnly" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <Grid x:Name="LibraryList"
                  Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="12,0,29,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource ListKindWidth}" />
                        <ColumnDefinition Width="{StaticResource ListLastWidth}" />
                        <ColumnDefinition Width="{StaticResource ListTotalWidth}" />
                        <ColumnDefinition Width="{StaticResource ListActionsWidth}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="{loc:Loc Library_Col_Game}"
                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="{DynamicResource MetaFontSize}"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Column="2" Text="{loc:Loc Library_Col_Kind}"
                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="{DynamicResource MetaFontSize}"
                               Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{loc:Loc Library_Col_LastPlayed}"
                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="{DynamicResource MetaFontSize}"
                               Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Text="{loc:Loc Library_Col_Total}"
                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="{DynamicResource MetaFontSize}"
                               Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <ListBox Grid.Row="1" x:Name="LibraryRows" Style="{StaticResource LibraryListBoxStyle}"
                         ItemsSource="{Binding Items}"
                         ItemTemplate="{StaticResource LibraryRowTemplate}" />
            </Grid>

            <StackPanel x:Name="EmptyInvitation" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,40"
                        Visibility="{Binding ShowEmptyInvitation, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{loc:Loc GamesPage_EmptyLibrary}"
                           FontSize="{DynamicResource HeadingFontSize}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Text="{loc:Loc GamesPage_EmptyLibrary_Hint}"
                           FontSize="{DynamicResource BodyFontSize}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,6,0,0" MaxWidth="460" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="NoMatchLine" Text="{loc:Loc Library_NoMatch}"
                       FontSize="{DynamicResource BodyFontSize}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,24" TextWrapping="Wrap"
                       Visibility="{Binding ShowNoMatch, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
    </Grid>
