<Window x:Class="ROROROblox.App.Games.GamesWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ROROROblox.App.Controls"
        xmlns:core="clr-namespace:ROROROblox.Core;assembly=ROROROblox.Core"
        Title="Games"
        Height="820" Width="700"
        MinHeight="600" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Icon="/ROROROblox.App;component/Tray/Resources/tray-on.ico">

    <Window.Resources>
        <!-- MUST be defined BEFORE the DataTemplates that consume it: StaticResource resolves
             in document order, and a forward reference inside the same ResourceDictionary throws
             "Cannot find resource" at template-APPLY time — invisible to builds and unit tests,
             fatal on the first rendered row (live-crash caught 2026-07-09). -->
        <Style x:Key="InverseBoolToVisibilityStyle" TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type core:GameSearchResult}">
            <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="6"
                    Background="{DynamicResource RowBgBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="4"
                            Background="{DynamicResource NavyBrush}" ClipToBounds="True"
                            VerticalAlignment="Center">
                        <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WhiteBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding CreatorName, StringFormat='by {0}'}"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="  -  "
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Opacity="0.5" />
                            <TextBlock Text="{Binding PlayerCount, StringFormat='{}{0:N0} playing'}"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Style="{StaticResource CtaButtonStyle}" Grid.Column="2" Content="+ Add"
                            Tag="{Binding}"
                            Click="OnAddSearchResultClick"
                            Padding="12,6"
                            FontSize="11" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type core:FavoriteGame}">
            <Border Margin="0,0,0,8" Padding="14,10"
                    CornerRadius="8"
                    Background="{DynamicResource RowBgBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- v1.3.x — right-click rename context menu (item 7 surface 5).
                     Tag="{Binding}" passes the full FavoriteGame to the click handler. -->
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Rename…"
                                  Tag="{Binding}"
                                  Click="OnRenameGameClick" />
                        <MenuItem Header="Reset name"
                                  Tag="{Binding}"
                                  Click="OnResetGameNameClick">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LocalName}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="6"
                            Background="{DynamicResource NavyBrush}" ClipToBounds="True"
                            VerticalAlignment="Center">
                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- v1.3.x — RenderName = LocalName ?? Name. -->
                            <TextBlock Text="{Binding RenderName}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WhiteBrush}" />
                            <Border Background="{DynamicResource CyanBrush}" CornerRadius="3"
                                    Margin="10,2,0,0" Padding="6,1"
                                    Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="DEFAULT"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource NavyBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding PlaceId, StringFormat='Place ID {0}'}"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Style trigger, NOT a bool->Visibility converter binding: InverseBoolConverter
                             returns bool, WPF silently drops it for a Visibility DP, and the button stayed
                             visible on the default row (shipped bug, fixed alongside the server row's). -->
                        <Button Content="Set default"
                                Tag="{Binding PlaceId}"
                                Click="OnSetDefaultClick"
                                Padding="10,6" Margin="0,0,8,0"
                                FontSize="11"
                                Style="{StaticResource InverseBoolToVisibilityStyle}" />
                        <Button Content="Clear default"
                                Click="OnClearDefaultClick"
                                Padding="10,6" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11"
                                ToolTip="Stop using this as the default. Launch As will open Roblox home until you set a default game."
                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <!-- v1.3.x — visible Rename button. Right-click context menu still works
                             for users who find that first; this is the discoverable surface. -->
                        <Button Content="Rename"
                                Tag="{Binding}"
                                Click="OnRenameGameClick"
                                Padding="10,6" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11"
                                ToolTip="Give this game a custom name shown only in RoRoRo. The Roblox-side name stays untouched." />
                        <Button Content="Remove"
                                Tag="{Binding PlaceId}"
                                Click="OnRemoveClick"
                                Padding="10,6"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- v1.3.x — saved private server row template. Visible Rename button + right-click. -->
        <DataTemplate DataType="{x:Type core:SavedPrivateServer}">
            <Border Margin="0,0,0,8" Padding="14,10"
                    CornerRadius="8"
                    Background="{DynamicResource RowBgBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Rename…"
                                  Tag="{Binding}"
                                  Click="OnRenameServerClick" />
                        <MenuItem Header="Reset name"
                                  Tag="{Binding}"
                                  Click="OnResetServerNameClick">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LocalName}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6"
                            Background="{DynamicResource NavyBrush}" ClipToBounds="True"
                            VerticalAlignment="Center">
                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- v1.3.x — RenderName = LocalName ?? Name. -->
                            <TextBlock Text="{Binding RenderName}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WhiteBrush}" />
                            <Border Background="{DynamicResource MagentaBrush}" CornerRadius="3"
                                    Margin="10,2,0,0" Padding="6,1">
                                <TextBlock Text="PRIVATE"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource WhiteBrush}" />
                            </Border>
                            <Border Background="{DynamicResource CyanBrush}" CornerRadius="3"
                                    Margin="6,2,0,0" Padding="6,1"
                                    Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="DEFAULT"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource NavyBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding PlaceName}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Set default"
                                Tag="{Binding Id}"
                                Click="OnSetDefaultServerClick"
                                Padding="10,6" Margin="0,0,8,0"
                                FontSize="11"
                                ToolTip="Pre-select this server when you launch all accounts to a private server."
                                Style="{StaticResource InverseBoolToVisibilityStyle}" />
                        <Button Content="Clear default"
                                Click="OnClearDefaultServerClick"
                                Padding="10,6" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11"
                                ToolTip="Stop pre-selecting this server. You'll pick one each time again."
                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <!-- v1.3.x — visible Rename button. Spec §10 — Library is the discoverable
                             home for renaming saved private servers; right-click works too. -->
                        <Button Content="Rename"
                                Tag="{Binding}"
                                Click="OnRenameServerClick"
                                Padding="10,6" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11"
                                ToolTip="Give this server a custom name shown only in RoRoRo." />
                        <Button Content="Remove"
                                Tag="{Binding Id}"
                                Click="OnRemoveServerClick"
                                Padding="10,6"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Title -->
            <RowDefinition Height="Auto" />  <!-- Search box -->
            <RowDefinition Height="Auto" />  <!-- Search results -->
            <RowDefinition Height="Auto" />  <!-- Or paste URL -->
            <RowDefinition Height="Auto" />  <!-- Add status -->
            <RowDefinition Height="*" />     <!-- Shared scroll: games + servers -->
            <RowDefinition Height="Auto" />  <!-- Footer -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <controls:PageHeader Heading="Games" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="SearchInput"
                     FontSize="13"
                     Padding="10,8"
                     Background="{DynamicResource RowBgBrush}"
                     CaretBrush="{DynamicResource CyanBrush}"
                     KeyDown="OnSearchKeyDown"
                     ToolTip="Search Roblox games by name. Enter to search." Style="{StaticResource AppTextBoxStyle}"/>
            <Button Style="{StaticResource CtaButtonStyle}" Grid.Column="1" x:Name="SearchButton" Content="Search"
                    Padding="14,8" Margin="8,0,0,0"
                    Click="OnSearchClick" />
        </Grid>

        <Border Grid.Row="2" x:Name="SearchResultsContainer"
                Margin="0,8,0,0"
                MaxHeight="220"
                Visibility="Collapsed"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SearchResultsList" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="UrlInput"
                     FontSize="12"
                     FontFamily="Consolas"
                     Padding="10,8"
                     Background="{DynamicResource RowBgBrush}"
                     CaretBrush="{DynamicResource CyanBrush}"
                     ToolTip="Or paste a roblox.com/games/&lt;id&gt;/&lt;name&gt; URL or place id" Style="{StaticResource AppTextBoxStyle}"/>
            <Button Grid.Column="1" x:Name="AddButton" Content="+ Add by URL"
                    Padding="14,8" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryStrongButtonStyle}"
                    FontSize="12"
                    Click="OnAddClick" />
        </Grid>

        <TextBlock Grid.Row="4" x:Name="StatusText"
                   FontSize="11"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap" />

        <!-- v1.3.x — saved private servers section lives in this shared scroll too. Add path
             stays in Squad Launch sheet ("Add by URL" pasting + auto-launch); this surface
             manages existing entries. -->
        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="Saved games"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,0,0,8" />
                <ItemsControl x:Name="FavoritesList" />
                <StackPanel x:Name="EmptyState" Margin="0,4,0,0">
                    <TextBlock Text="No saved games yet."
                               FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Text="Search above or paste a Roblox game URL to add your first one."
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0"
                               Opacity="0.7" />
                </StackPanel>

                <TextBlock Text="Saved private servers"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,16,0,8" />
                <ItemsControl x:Name="ServersList" />
                <StackPanel x:Name="ServersEmptyState" Margin="0,4,0,0">
                    <TextBlock Text="No saved private servers."
                               FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <!-- F-021: this used to read "Use the Squad Launch toolbar button to add one",
                         which named a window that is not open and an "add" action that does not
                         exist. There is no way to add a private server here or anywhere else — the
                         only site that persists one is SquadLaunchWindow's add-and-launch path
                         (:371), which calls IPrivateServerStore.AddAsync as a side effect of
                         launching a pasted link. The copy now names that mechanism. -->
                    <TextBlock Text="Paste a private server link into Squad Launch and launch it. It saves here automatically."
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0"
                               Opacity="0.7" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="6" Content="Close" Padding="16,8"
                HorizontalAlignment="Right" Margin="0,12,0,0"
                Style="{StaticResource SecondaryStrongButtonStyle}"
                IsCancel="True"
                Click="OnCloseClick" />
    </Grid>
</Window>
