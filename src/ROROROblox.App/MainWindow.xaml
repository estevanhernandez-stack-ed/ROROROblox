<ui:FluentWindow x:Class="ROROROblox.App.MainWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:loc="clr-namespace:ROROROblox.App.Localization"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:ROROROblox.App.ViewModels"
                 xmlns:app="clr-namespace:ROROROblox.App"
                 xmlns:controls="clr-namespace:ROROROblox.App.Controls"
                 Title="{loc:Loc MainWindow_Rororo}"
        AutomationProperties.AutomationId="MainWindow"
                 Height="600" Width="900"
                 MinHeight="400" MinWidth="860"
                 WindowStartupLocation="CenterScreen"
                 AllowDrop="True"
                 Background="{DynamicResource BgBrush}"
                 Icon="/ROROROblox.App;component/Tray/Resources/tray-on-titlebar.png"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Default">

    <ui:FluentWindow.Resources>
        <!-- Carries the window's DataContext (the ViewModel) into ContextMenus, which live in a
             separate popup tree and can't reach the VM via RelativeSource AncestorType=Window.
             Context-menu items bind commands as {Binding Data.SomeCommand, Source={StaticResource VmProxy}}.
             See BindingProxy.cs for why the old PlacementTarget.DataContext.SomeCommand bindings
             silently resolved to null. -->
        <app:BindingProxy x:Key="VmProxy" Data="{Binding}" />

        <!-- Themed brushes are app-level (App.xaml). ThemeService.ApplySlot REPLACES each brush
             instance on theme change, so every themed reference in this file must be
             {DynamicResource}; a {StaticResource} would keep the discarded instance and stop
             repainting after first paint. (This comment said "mutates in place" until 2026-08-30.) -->

        <!-- Compact-mode row template: tighter, single-line, only the live ops info.
             Used by the ItemsControl that renders CompactRows in the compact strip. -->
        <DataTemplate x:Key="CompactAccountTemplate" DataType="{x:Type vm:AccountSummary}">
            <Border Margin="0,0,0,6" Padding="10,8"
                    CornerRadius="6"
                    Background="{DynamicResource RowBgBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="{DynamicResource NavyBrush}" ClipToBounds="True"
                            VerticalAlignment="Center">
                        <Image Source="{Binding AvatarDisplaySource}" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- v1.3.x — RenderName = LocalName ?? DisplayName. Compact-mode row. -->
                            <TextBlock Text="{Binding RenderName}"
                                       FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WhiteBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Background="{DynamicResource MagentaBrush}" CornerRadius="2"
                                    Margin="6,2,0,0" Padding="4,1"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsMain, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{loc:Loc Badge_Main}"
                                           FontSize="{DynamicResource MetaFontSize}" FontWeight="Bold"
                                           Foreground="{DynamicResource OnMagentaBrush}" />
                            </Border>
                            <!-- Memory chip (compact mode) — same MemoryText/MemoryWarning + the same
                                 warn/quiet Style as the full row template (below). Compact rows are
                                 the exact unattended/parked-on-a-second-monitor scenario the watchdog
                                 exists for, so this can't be full-row-only: without it, a compact
                                 user gets no chip, no Recycle, and only a tray icon Windows 11
                                 hides by default. Collapses entirely via StringToVisibilityConverter
                                 when there's no reading yet. -->
                            <Border Visibility="{Binding MemoryText, Converter={StaticResource StringToVisibilityConverter}}"
                                    Background="Transparent"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding MemoryText}"
                                           FontSize="{DynamicResource MetaFontSize}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MemoryWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource RowExpiredAccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock FontSize="{DynamicResource MetaFontSize}" Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding SelectedGame.Name, FallbackValue='(default game)', TargetNullValue='(default game)'}" />
                            <Run Text=" · " />
                            <Run Text="{Binding SecondaryStatusText, Mode=OneWay}" />
                        </TextBlock>
                        <!-- Compact mode: tags READ-ONLY — labels only, no "×", no add box. Whole
                             strip collapses when there are no tags so the compact row stays tight. -->
                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,3,0,0">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tags.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8"
                                            Margin="0,0,4,3"
                                            Padding="6,1"
                                            Background="{DynamicResource NavyBrush}"
                                            BorderBrush="{DynamicResource CyanBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="{DynamicResource MetaFontSize}"
                                                   Foreground="{DynamicResource WhiteBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="120" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Recycle (compact mode) — same RecycleAccountCommand + MemoryWarning
                             trigger as the full row template. Icon-only (not "Recycle" as text):
                             a full-width labeled button is too heavy for a single-line compact
                             row, but the one-click remedy still needs to exist here — a compact
                             user who never opens the full window otherwise has no way to act on
                             the warning short of Stop. -->
                        <Button Content="&#x21BB;"
                                Command="{Binding DataContext.RecycleAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="7,3" Margin="0,0,6,0"
                                FontSize="{DynamicResource BodyFontSize}"
                                ToolTip="{loc:Loc MainWindow_RecycleCloseAndRelaunchThis}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WarningButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MemoryWarning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <!-- Same opt-in as the full row template. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                                <Condition Binding="{Binding DataContext.AlwaysShowRecycle, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource AccentActionButtonStyle}" Content="{loc:Loc MainWindow_Stop}"
                                AutomationProperties.AutomationId="DangerStop"
                                Command="{Binding DataContext.StopAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="10,4"
                                FontSize="{DynamicResource MetaFontSize}"
                                ToolTip="{loc:Loc MainWindow_CloseTheRobloxWindowFor}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- v1.36 panel entry (one template for Recent, Favourites and Private servers). Every entry's launch button
             shares the AutomationId DangerPanelLaunch on purpose: entries are named by game, so the id is their guard
             (docs/ui-routes.json denyAids), and a route that names it resolves to many matches, which is an error. A Ghost Button is the
             launch surface (hover sheen, keyboard focus, the entry's whole name) and the visible content sits
             over it, not hit-testable: the shared button template centres its content and sizes it to fit, which
             would never trim a long name to the column. The name and meta TextBlocks trim with an ellipsis, and
             the full text lives in the tooltip and the accessible name. Save is its own button beside it (a
             Button cannot nest in a Button), shown only on an unsaved Recent entry. The click calls the panel's
             LaunchCommand, which calls the main view model's launch path and nothing else. -->
        <DataTemplate x:Key="PanelEntryTemplate" DataType="{x:Type vm:PanelEntry}">
            <Grid Margin="0,0,0,1" MinHeight="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        AutomationProperties.Name="{Binding AccessibleName}"
                        AutomationProperties.AutomationId="DangerPanelLaunch"
                        Command="{Binding DataContext.Panel.LaunchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding TooltipText}"
                        ToolTipService.ShowOnDisabled="True"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsLaunching, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.SessionLimited, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Grid Grid.Column="0" Margin="6,4" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanLaunch}" Value="False">
                                    <Setter Property="Opacity" Value="0.6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="5" ClipToBounds="True"
                            Background="{DynamicResource NavyBrush}" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{Binding Initials}"
                                       FontSize="{DynamicResource MetaFontSize}" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Entry.IconUrl}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="{DynamicResource BodyFontSize}"
                                   Foreground="{DynamicResource WhiteBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MetaText}"
                                   FontSize="{DynamicResource MetaFontSize}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border BorderBrush="{DynamicResource MutedTextBrush}" BorderThickness="1" CornerRadius="3"
                                Padding="5,0" Margin="0,0,4,0"
                                Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{loc:Loc Shell_Panel_Tag_Private}"
                                       FontSize="{DynamicResource MetaFontSize}" FontWeight="Bold"
                                       Foreground="{DynamicResource WhiteBrush}" />
                        </Border>
                        <Border BorderBrush="{DynamicResource MutedTextBrush}" BorderThickness="1" CornerRadius="3"
                                Padding="5,0"
                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{loc:Loc Shell_Panel_Tag_Default}"
                                       FontSize="{DynamicResource MetaFontSize}" FontWeight="Bold"
                                       Foreground="{DynamicResource WhiteBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
                <Button Grid.Column="1" Content="{loc:Loc Shell_Panel_Save}"
                        AutomationProperties.Name="{Binding SaveAccessibleName}"
                        Command="{Binding DataContext.Panel.SaveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        FontSize="{DynamicResource MetaFontSize}"
                        Padding="8,2" Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowSave, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <!-- Account row template -->
        <DataTemplate DataType="{x:Type vm:AccountSummary}">
            <!-- AllowDrop + Tag={Binding} together with the Window-level drag handlers (in
                 MainWindow.xaml.cs) implement drag-to-reorder: MouseDown on the row's
                 grip-style left edge starts a drag; dropping on another row triggers
                 MainViewModel.MoveAccountAsync. The row no longer carries a MinWidth — the
                 parent Window.MinWidth=860 floors the available width, and the column layout
                 (Auto + * + Auto SharedSizeGroup) settles within that. -->
            <!-- Wrap row in a StackPanel so the cyan insertion-line indicator renders ABOVE
                 the row when this row is the active drop target. Visibility=Collapsed when
                 inactive so the layout doesn't reserve space — the appearance + small layout
                 shift is the visual cue for "drop lands here."
                 v1.6.0 (7b): the whole row collapses when an active tag/name filter excludes it
                 (IsFilteredOut). The underlying Accounts collection + order are untouched — only
                 visibility flips — so drag-reorder index math stays valid (and reorder itself is
                 disabled while filtered, see the OnAccountRow* guards in code-behind). -->
            <StackPanel Margin="0,0,0,8"
                        Visibility="{Binding IsFilteredOut, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Border Height="3"
                    Margin="0,0,0,4"
                    CornerRadius="2"
                    Background="{DynamicResource CyanBrush}"
                    Visibility="{Binding IsDropTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
            <!-- Padding is asymmetric on purpose: the left 14px moved into the row grid's first
                 column so the expired rule can sit flush against the row's own edge instead of
                 floating inside the padding. Content geometry is unchanged — 3px of rule plus
                 11px of gap is the same 14px inset it always had. -->
            <Border x:Name="AccountRowBorder"
                    Padding="0,10,14,10"
                    AllowDrop="True"
                    Tag="{Binding}"
                    DragEnter="OnAccountRowDragEnter"
                    DragLeave="OnAccountRowDragLeave"
                    DragOver="OnAccountRowDragOver"
                    Drop="OnAccountRowDrop"
                    Background="{DynamicResource RowBgBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- CornerRadius is a Style setter, not an attribute, so the open panel's trigger can
                             square the bottom corners (a local value would outrank it). -->
                        <Setter Property="CornerRadius" Value="8" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Panel.IsExpanded}" Value="True">
                                <Setter Property="CornerRadius" Value="8,8,0,0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SessionExpired}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RowExpiredBgBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource RowExpiredAccentBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </DataTrigger>
                            <!-- Task 8 — highlights the row a tray memory-warning balloon click
                                 (RequestFocusAccount -> MainWindow.FocusAccountRow -> IsFocused)
                                 points at. Listed after SessionExpired so it wins the border if a
                                 focused row also happens to be expired. -->
                            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- v1.3.x — right-click context menu for the rename overlay. Existing row buttons
                     (Launch As, Re-authenticate, Remove) stay as buttons. Rename / Reset are
                     context-menu only because they're per-account-rare actions. The PlacementTarget
                     pattern reaches up to MainWindow's DataContext for the commands; CommandParameter
                     is the row's data context (AccountSummary). -->
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Loc MainWindow_Rename}"
                                  Command="{Binding Data.RenameItemCommand, Source={StaticResource VmProxy}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="{loc:Loc MainWindow_ResetName}"
                                  Command="{Binding Data.ResetItemNameCommand, Source={StaticResource VmProxy}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlacementTarget.DataContext.LocalName, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <!-- Trust-aware squad launch (v1.9.0). Command reaches the VM via VmProxy —
                             a ContextMenu lives in its own popup tree, and PlacementTarget.DataContext
                             here is the row's AccountSummary, which has no VM commands (the old
                             PlacementTarget.DataContext.ToggleJoinViaFriendCommand silently bound null).
                             IsCheckable is deliberately omitted — WPF-UI's themed MenuItem only shows a
                             check glyph when IsCheckable="True", so the check state is driven through the
                             Header text via a DataTrigger on the row's JoinViaFriend instead. -->
                        <MenuItem Command="{Binding Data.ToggleJoinViaFriendCommand, Source={StaticResource VmProxy}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  ToolTip="{loc:Loc MainWindow_SquadLaunchesRouteThisAccount}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{loc:Loc MainWindow_JoinViaFriendChallengeProne}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlacementTarget.DataContext.JoinViaFriend, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                            <Setter Property="Header" Value="{loc:Loc MainWindow_JoinViaFriendChallengeProne_2}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>

                        <!-- Part B auto-rejoin (task 5, 2026-09-29). Same Header-DataTrigger check
                             pattern as Join via friend above — no IsCheckable, because WPF-UI's
                             themed MenuItem only draws a glyph when IsCheckable="True", so the check
                             state is driven through the Header text instead. Never available for the
                             main: a second DataTrigger collapses the whole item when the row's
                             IsMain is true, since "rejoin the main automatically" is a rule that
                             never applies (global-constraints.md — the main is never rejoined
                             automatically). -->
                        <MenuItem Command="{Binding Data.ToggleAutoRejoinCommand, Source={StaticResource VmProxy}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  ToolTip="{loc:Loc MainWindow_RejoinIfItDropsOutTip}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{loc:Loc MainWindow_RejoinIfItDropsOut}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlacementTarget.DataContext.AutoRejoin, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                            <Setter Property="Header" Value="{loc:Loc MainWindow_RejoinIfItDropsOut_2}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsMain, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <!-- No Roblox user id: presence is never polled, so auto-rejoin
                                             couldn't tell in game from out of it. Hidden while off;
                                             still shown while on, so it can be turned off. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding PlacementTarget.DataContext.RobloxUserId, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="{x:Null}" />
                                                <Condition Binding="{Binding PlacementTarget.DataContext.AutoRejoin, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>

                        <!-- Per-account Discord alert mute. Lives in the context menu rather than
                             the row's action group deliberately: the row is already dense, and a
                             mute is a set-once preference, not a per-session control. Same
                             Header-DataTrigger check pattern as Join via friend above (WPF-UI's
                             themed MenuItem only draws a glyph when IsCheckable="True"). -->
                        <MenuItem Command="{Binding Data.ToggleAlertsMutedCommand, Source={StaticResource VmProxy}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  ToolTip="{loc:Loc MainWindow_StopDiscordAlertsForThis}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{loc:Loc MainWindow_MuteDiscordAlerts}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlacementTarget.DataContext.AlertsMuted, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                            <Setter Property="Header" Value="{loc:Loc MainWindow_MutedNoDiscordAlerts}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>

                        <Separator />

                        <!-- Streamer mode (v1.10, Task 10) — per-row reroll. CommandParameter binds
                             straight to the row's Id (a Guid), not the AccountSummary itself, so
                             RerollAccountCommand can't hold a dangling row reference. -->
                        <!-- F-045. The glyph STAYS — the campaign ruling is that the die and the clipboard are
                             thematic, not decoration. What changes is the announcement: without a name a
                             screen reader reads the emoji aloud before the words. -->
                        <MenuItem AutomationProperties.Name="{loc:Loc MainWindow_RerollIdentity}"
                                  Header="{loc:Loc MainWindow_RerollIdentity_2}"
                                  Command="{Binding Data.RerollAccountCommand, Source={StaticResource VmProxy}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  ToolTip="{loc:Loc MainWindow_AssignThisAccountAFresh}" />
                    </ContextMenu>
                </Border.ContextMenu>

                <controls:RowGrid>
                    <!-- Row 0 is everything the row was in v1.35 and is Star, not Auto: it replaces the
                         implicit single star row, and an Auto row 0 measured the collapsed row 8 px taller
                         than v1.35 (AccountRowCollapsedRenderTests). Row 1 is the v1.36 facts line and is
                         zero height while its panel is Collapsed. The expired rule, the grip and the
                         avatar span both rows (they draw the row's full height, centred); the name and
                         actions columns stay in row 0 so the actions never overlap the facts line. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Expired rule + the gap that used to be the Border's left padding.
                             Reserved whether or not the rule is showing, so a session going stale
                             does not shove the row's own content sideways — same reason the nav
                             rail reserves its 3px column for every item, selected or not. -->
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <!-- Name column: MinWidth keeps it readable when the action stack on the
                             right grows wide. At default window (780w) this gives ~180px for the
                             name; longer usernames truncate via TextTrimming below. -->
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <!-- Actions column shares its width across every row so the caption-color
                             swatch + star (the first items) line up vertically. Different action
                             stacks (Stop vs Launch As, expired-only Re-authenticate) would
                             otherwise size each row's column independently and shift the swatch. -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="RowActions" />
                    </Grid.ColumnDefinitions>

                    <!-- Expired-session left rule (spec §6.2). SELECTION IS A SHAPE, NOT A FILL is
                         already this app's vocabulary — Preferences' nav rail carries its selected
                         state on a 3px accent BAR plus weight, deliberately, because a fill is the
                         first thing a theme that flattens surfaces takes away (F-002). Same device,
                         same width, same radius, applied to the one other row state the app paints
                         only in colour. The amber fill and border stay; this is what is left when
                         RowExpiredBg and RowBg land on the same value.
                         Ships for every theme. There is no theme condition here and there must not
                         be one (numbered non-goal 6).
                         The Hidden default lives in the Style setter, not on the element: a local
                         Visibility="Hidden" would outrank the DataTrigger and the rule would never
                         appear. -->
                    <Rectangle Grid.Column="0" Grid.RowSpan="2"
                               Width="3"
                               HorizontalAlignment="Left"
                               RadiusX="1.5" RadiusY="1.5"
                               Fill="{DynamicResource RowExpiredAccentBrush}">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SessionExpired}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>

                    <!-- Drag-grip — visual cue that the row is reorderable. Press-and-drag the
                         grip to move the row; drop on another row to swap. Tag={Binding} so the
                         Window-level handler knows which AccountSummary started the drag. -->
                    <Border Grid.Column="1" Grid.RowSpan="2" Width="14" Margin="0,0,4,0"
                            Background="Transparent"
                            Cursor="SizeAll"
                            Tag="{Binding}"
                            ToolTip="{loc:Loc MainWindow_DragToReorderThisAccount}"
                            PreviewMouseLeftButtonDown="OnAccountGripMouseDown"
                            PreviewMouseMove="OnAccountGripMouseMove">
                        <TextBlock Text="&#x2630;"
                                   FontSize="{DynamicResource BodyFontSize}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Opacity="0.5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Border>

                    <!-- Avatar — wrapped in a colored ring driven by the per-account caption color.
                         The ring is what makes the per-account color visible inside the app even
                         when Roblox's window chrome refuses the DWM caption tint. -->
                    <Grid Grid.Column="2" Grid.RowSpan="2" Width="52" Height="52" VerticalAlignment="Center">
                        <Ellipse>
                            <Ellipse.Fill>
                                <MultiBinding Converter="{StaticResource CaptionColorBrushConverter}">
                                    <Binding Path="CaptionColorHex" />
                                    <Binding Path="IsMain" />
                                    <Binding Path="Id" />
                                </MultiBinding>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Border Width="44" Height="44" CornerRadius="22"
                                Background="{DynamicResource NavyBrush}" ClipToBounds="True"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="{Binding AvatarDisplaySource}" Stretch="UniformToFill" />
                        </Border>
                    </Grid>

                    <!-- Name + status -->
                    <StackPanel Grid.Column="3" Margin="14,0,14,0" VerticalAlignment="Center">
                        <!-- v1.36 item 13: the name line is a Grid, not a horizontal StackPanel. A StackPanel measures
                             the name at infinite width, so its CharacterEllipsis never engaged and the pills after it
                             were clipped at the column edge instead: the MAIN pill read HAUP in German at 900 px, and
                             clipped in all six translated languages (LabelWrapMeasurementTests). Now the name takes the
                             star column and trims (its tooltip carries the full name); the pills keep their width.
                             HorizontalAlignment="Left" is load-bearing: the Grid sizes to its content, so the star
                             column is the name's own width and MAIN sits right after it. Stretched, the star column
                             took the whole name column and MAIN floated to its far edge on a wide window (found in the
                             1180 px marketing frames, 2026-11-03). When space runs out the Grid is clamped to the
                             column, the star column shrinks, and the name trims as before. -->
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- v1.36 panel expander (spec 3.6; moved here by the C2 ruling E1, 2026-11-02): first on the
                                 name line, before the name, the disclosure-triangle convention (the toggle leads the
                                 thing it opens). It left the actions column because its 32 px there is what pushed Remove
                                 off the declared 900 px. A ToggleButton on PanelExpanderToggleButtonStyle: open is a Cyan
                                 outline and glyph, drawn by that template's IsChecked trigger, so this element carries no
                                 colour and no trigger. The glyph is bound from the row (PanelExpanderGlyph) for the same
                                 reason. Named from the account, so a screen reader hears whose games it opens, and
                                 keyboard-reachable. SIZE IS LOAD-BEARING: the name line is the heading's own line, 19 DIP
                                 tall on an ordinary row (21 with the MAIN pill), shorter than the 24 px button this used to be
                                 in the actions column. The expander is 20x20 with -1 vertical margins, so it LAYS OUT at 18 DIP:
                                 the name line does not grow and the collapsed row stays at its v1.35 height
                                 (AccountRowCollapsedRenderTests pins it). Measured: with no margin the 20 px box grew the
                                 collapsed row from 92 to 93 and the pins failed; a 24 px button grows the line by 5. -->
                            <ToggleButton AutomationProperties.Name="{Binding PanelExpanderName}"
                                          ToolTip="{Binding PanelExpanderName}"
                                          IsChecked="{Binding Panel.IsExpanded, Mode=TwoWay}"
                                          Width="20" Height="20" Padding="0" Margin="0,-1,8,-1"
                                          VerticalAlignment="Center"
                                          FontSize="{DynamicResource MetaFontSize}"
                                          Style="{StaticResource PanelExpanderToggleButtonStyle}"
                                          Content="{Binding PanelExpanderGlyph}"
                                          Cursor="Hand" />
                            <!-- v1.3.x — RenderName = LocalName ?? DisplayName. Regular row primary
                                 label + tooltip both flip; tooltip shows the un-truncated rename. -->
                            <TextBlock Grid.Column="1" Text="{Binding RenderName}"
                                       FontSize="{DynamicResource HeadingFontSize}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WhiteBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding RenderName}" />
                            <!-- MAIN pill — magenta, only when this account IsMain. Tells the user
                                 at a glance which row is their default for compact mode + tray double-click. -->
                            <Border Grid.Column="2" Background="{DynamicResource MagentaBrush}" CornerRadius="3"
                                    Margin="10,2,0,0" Padding="6,2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsMain, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{loc:Loc Badge_Main}"
                                           FontSize="{DynamicResource MetaFontSize}" FontWeight="Bold"
                                           Foreground="{DynamicResource OnMagentaBrush}" />
                            </Border>
                        </Grid>
                        <!-- Item 13 (2026-11-03): a Grid, not a horizontal StackPanel, so the status sentence trims (full
                             text in its tooltip) instead of being cut mid-word at the column edge. The chips and the
                             selection dot after it sit in the Auto column and keep their width. Left-aligned for the
                             same reason as the name line: the chips follow the text instead of floating to the edge. -->
                        <Grid Margin="0,4,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Live status dot. Every state resolves from a theme slot, so the dot
                                 repaints with the theme instead of holding a brand hue the theme
                                 cannot reach (spec §5.3). Active takes WhiteBrush rather than the
                                 tempting CyanBrush: under flatline Cyan and RowExpiredAccent are the
                                 same value, which would land active and expired at 1.00:1 of each
                                 other. The four states measure 13.17:1 / 9.68:1 / 4.98:1 / 2.81:1
                                 against the row under flatline. Grey/idle is the Setter rather than
                                 a trigger — it is also the fallback for a StatusDot string nobody
                                 planned for, which is what the deleted converter's `_ => Grey` did. -->
                            <Ellipse Width="8" Height="8"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusDot}" Value="green">
                                                <Setter Property="Fill" Value="{DynamicResource WhiteBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusDot}" Value="yellow">
                                                <Setter Property="Fill" Value="{DynamicResource RowExpiredAccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusDot}" Value="magenta">
                                                <Setter Property="Fill" Value="{DynamicResource MagentaBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{Binding SecondaryStatusText}"
                                       FontSize="{DynamicResource BodyFontSize}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SecondaryStatusText}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SessionExpired}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource RowExpiredAccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <!-- Idle chip — shows "idle {duration}" once a running account has been
                                 quiet for at least a minute. RowExpiredAccentBrush when IdleWarn
                                 (crossed the warn threshold), MutedTextBrush otherwise. Task 7;
                                 driven by ActivitySnapshotApplier (Task 8) via SinceActivity/IdleWarn. -->
                            <Border Visibility="{Binding ShowIdleChip, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="Transparent"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding IdleText}"
                                           FontSize="{DynamicResource BodyFontSize}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IdleWarn}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource RowExpiredAccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <!-- Memory chip (Task 7) — per-account private-bytes reading from the
                                 memory watchdog, e.g. "2.3 GB" or "▲ 2.3 GB · ~45 min" once a cap/
                                 projection trigger has latched. Collapsed entirely when MemoryText is
                                 null/empty — no reading yet, or the last pid read failed (never show a
                                 stale or zero figure). RowExpiredAccentBrush when warning, via the same
                                 warn/quiet Style the idle chip above uses, so both warning states read
                                 as one visual system in every theme. -->
                            <Border Visibility="{Binding MemoryText, Converter={StaticResource StringToVisibilityConverter}}"
                                    Background="Transparent"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding MemoryText}"
                                           FontSize="{DynamicResource BodyFontSize}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MemoryWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource RowExpiredAccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <!-- Selection toggle for batch launches. Filled cyan = included; hollow = skipped.
                                 Defaults to selected; user toggles to exclude an account from Launch multiple
                                 / Private server runs. Persisted to accounts.dat so the choice sticks. -->
                            <ToggleButton Style="{StaticResource SelectionDotStyle}" AutomationProperties.Name="{loc:Loc MainWindow_IncludeThisAccountInLaunch}"
                                          IsChecked="{Binding IsSelected}"
                                          Margin="12,0,4,0"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding DataContext.HasMultipleAccounts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"
                                          ToolTip="{loc:Loc MainWindow_IncludeThisAccountInLaunch_2}" />
                            <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.HasMultipleAccounts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"
                                       ToolTip="{loc:Loc MainWindow_WhetherThisAccountJoinsLaunch}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{loc:Loc MainWindow_InBatches}" />
                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                <Setter Property="Text" Value="{loc:Loc MainWindow_Skipped}" />
                                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                <Setter Property="Opacity" Value="0.65" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            </StackPanel>
                        </Grid>

        <!-- Follow strip — "Follow:" label + chips of OTHER accounts. Click a chip to
                             launch THIS row's account into that account's current Roblox server
                             (LaunchTarget.FollowFriend). Self-chip hides via EqualsToCollapseConverter
                             on Id. Whole strip (label + chips) collapses when there's nothing to
                             follow (≤ 1 saved account). -->
                        <!-- F-119: DockPanel, not a horizontal StackPanel. A horizontal StackPanel
                             measures its children with INFINITE width, so the WrapPanel below never
                             saw a boundary and never wrapped — the chips just ran past the column
                             edge and were clipped. DockPanel gives its last child the width that is
                             actually left, which is the number the WrapPanel needs. -->
                        <DockPanel Margin="0,6,0,0" LastChildFill="True">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.Accounts.Count, RelativeSource={RelativeSource AncestorType=Window}}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.Accounts.Count, RelativeSource={RelativeSource AncestorType=Window}}" Value="1">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <TextBlock Text="{loc:Loc MainWindow_Follow}"
                                       DockPanel.Dock="Left"
                                       FontSize="{DynamicResource MetaFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Top"
                                       Margin="0,3,6,0"
                                       ToolTip="{loc:Loc MainWindow_ClickAChipToLaunch}" />
                            <ItemsControl ItemsSource="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=Window}}">
                            <!-- F-119. A horizontal StackPanel gives its children infinite width and
                                 lets the container clip whatever does not fit, so it never wraps and
                                 never scrolls — it just stops drawing the end of an account name,
                                 with nothing reporting that it did. Same class as F-113.
                                 It was already truncating before the type ladder; raising the row's
                                 buttons from 11px to 12px widened them, squeezed this column, and
                                 took the tail chip down to four characters. A WrapPanel costs row
                                 height when somebody follows many accounts and costs nothing when
                                 they follow few — and a name nobody can read is not cheaper than a
                                 taller row. -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AccountSummary}">
                                    <Button Click="OnFollowChipClick"
                                            AutomationProperties.Name="{Binding RenderName}"
                                            Tag="{Binding}"
                                            Margin="0,0,6,0"
                                            Padding="6,3"
                                            Cursor="Hand">
                                        <!-- Hide the chip that represents the row's own account so
                                             you can't follow yourself. -->
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Value="Collapsed">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource EqualsToCollapseConverter}">
                                                                <Binding Path="Id" />
                                                                <Binding Path="DataContext.Id" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.ToolTip>
                                            <TextBlock>
                                                <Run Text="{loc:Loc MainWindow_Follow_2}" /><Run Text="{Binding RenderName, Mode=OneWay}" /><Run Text="{loc:Loc MainWindow_IntoTheirServer}" />
                                            </TextBlock>
                                        </Button.ToolTip>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" CornerRadius="7"
                                                    Background="{DynamicResource NavyBrush}"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,5,0">
                                                <Image Source="{Binding AvatarDisplaySource}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Text="{Binding RenderName}"
                                                       FontSize="{DynamicResource MetaFontSize}"
                                                       Foreground="{DynamicResource WhiteBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="80" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </DockPanel>

                        <!-- Tags strip (v1.5.0) — free-text per-account labels (PS99, RCU, PLAZA).
                             Chips wrap; the AccountSummary normalization caps them at 8 tags / 24
                             chars each so the row stays bounded. Each chip carries a "×" that fires
                             RemoveTagCommand on the row's AccountSummary (the chip's own DataContext
                             is the tag string, so the command reaches up via the ItemsControl's
                             DataContext, mirroring the Follow strip). The inline "add tag" box fires
                             AddTagCommand on Enter (handled in MainWindow.xaml.cs). -->
                        <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="9"
                                                Margin="0,0,5,5"
                                                Padding="8,2,4,2"
                                                Background="{DynamicResource NavyBrush}"
                                                BorderBrush="{DynamicResource CyanBrush}"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding}"
                                                           FontSize="{DynamicResource MetaFontSize}"
                                                           Foreground="{DynamicResource WhiteBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="160" />
                                                <!-- Remove "×". DataContext here is the tag string; reach
                                                     up to the ItemsControl whose DataContext is the row's
                                                     AccountSummary for the command. -->
                                                <Button Style="{StaticResource GhostButtonStyle}" Content="&#x00D7;" AutomationProperties.Name="{loc:Loc MainWindow_RemoveThisTag}"
                                                        Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="4,0,0,0"
                                                        Padding="3,0"
                                                        FontSize="{DynamicResource BodyFontSize}"
                                                        Cursor="Hand"
                                                        ToolTip="{loc:Loc MainWindow_RemoveThisTag_2}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Add affordance (v1.6.0, item 7a) — a collapsed "+" pill that engages
                                 an inline input. Visible when !IsAddingTag; clicking it sets
                                 IsAddingTag=true (OnAddTagPlusClick) and focuses the box. The box is
                                 visible when IsAddingTag: Enter commits the tag + collapses;
                                 Escape / LostFocus collapses unchanged (OnAddTagKeyDown /
                                 OnAddTagBoxLostFocus). Tag={Binding} so the handlers resolve the row's
                                 AccountSummary. So the row shows existing chips + a quiet "+", never an
                                 empty open text bar. -->
                            <Border x:Name="AddTagPlus"
                                    CornerRadius="9"
                                    Margin="0,0,5,5"
                                    Padding="8,2"
                                    Background="{DynamicResource NavyBrush}"
                                    BorderBrush="{DynamicResource CyanBrush}"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Tag="{Binding}"
                                    MouseLeftButtonUp="OnAddTagPlusClick"
                                    ToolTip="{loc:Loc MainWindow_AddALabelPs99Rcu}"
                                    Visibility="{Binding IsAddingTag, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <!-- Muted until hover so it stays quiet next to the chips. -->
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="+"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource CyanBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Border>
                            <ui:TextBox x:Name="AddTagBox" AutomationProperties.Name="{loc:Loc MainWindow_AddATagToThis}"
                                        PlaceholderText="{loc:Loc MainWindow_AddTag}"
                                        Tag="{Binding}"
                                        Width="84"
                                        MaxLength="24"
                                        FontSize="{DynamicResource MetaFontSize}"
                                        Margin="0,0,0,5"
                                        Padding="6,1"
                                        VerticalContentAlignment="Center"
                                        KeyDown="OnAddTagKeyDown"
                                        LostFocus="OnAddTagBoxLostFocus"
                                        IsVisibleChanged="OnAddTagBoxVisibleChanged"
                                        Visibility="{Binding IsAddingTag, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="{loc:Loc MainWindow_TypeALabelPs99Rcu}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Actions -->
                    <controls:ActionsRunPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Title-bar color swatch. Click opens a popup with the 8-palette + Auto +
                             custom hex. The swatch shows whatever color the Roblox window's title
                             bar currently uses (manual override OR auto-derived from Id hash). -->
                        <!-- F-077. A Border by tag, a control by behaviour — Cursor="Hand" and a
                             click handler below. WCAG 1.4.11 governs it, so it takes the derived
                             edge like any other control. The fence test permits this because it
                             decides by role, not element name; an earlier version of that test
                             hard-listed Border as decorative and would have failed the build here. -->
                        <Border Width="22" Height="14"
                                CornerRadius="3"
                                Margin="0,0,8,0"
                                BorderBrush="{DynamicResource InteractiveEdgeBrush}"
                                BorderThickness="1"
                                Cursor="Hand"
                                ToolTip="{loc:Loc MainWindow_PickARobloxWindowTitle}"
                                MouseLeftButtonUp="OnCaptionColorSwatchClick"
                                Tag="{Binding}">
                            <Border.Background>
                                <MultiBinding Converter="{StaticResource CaptionColorBrushConverter}">
                                    <Binding Path="CaptionColorHex" />
                                    <Binding Path="IsMain" />
                                    <Binding Path="Id" />
                                </MultiBinding>
                            </Border.Background>
                        </Border>

                        <!-- Set / unset main. Magenta filled star = main; outlined grey star = not.
                             Click toggles. Lives leftmost so it groups visually with the MAIN pill on
                             the name line above. -->
                        <Button Style="{StaticResource GhostButtonStyle}" AutomationProperties.Name="{loc:Loc MainWindow_SetAsMainAccount}" Command="{Binding DataContext.SetMainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="6,4" Margin="0,0,8,0"
                                Cursor="Hand">
                            <Button.ToolTip>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{loc:Loc MainWindow_SetAsMainAccountDrives}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMain}" Value="True">
                                                    <Setter Property="Text" Value="{loc:Loc MainWindow_ThisIsYourMainAccount}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.ToolTip>
                            <TextBlock FontSize="{DynamicResource HeadingFontSize}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x2606;" />
                                        <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMain}" Value="True">
                                                <Setter Property="Text" Value="&#x2605;" />
                                                <Setter Property="Foreground" Value="{DynamicResource MagentaBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <!-- Re-authenticate (visible when SessionExpired OR SessionLimited) -->
                        <Button Content="{loc:Loc MainWindow_Reauthenticate}"
                                Command="{Binding DataContext.ReauthenticateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="8,6" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WarningButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SessionExpired}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SessionLimited}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Friends — opens per-account follow modal. Disabled when expired. -->
                        <Button Content="{loc:Loc MainWindow_Friends}"
                                Command="{Binding DataContext.OpenFriendFollowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="10,6" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="{DynamicResource BodyFontSize}"
                                ToolTip="{loc:Loc MainWindow_SeeThisAccountSFriends}"
                                IsEnabled="{Binding SessionExpired, Converter={StaticResource InverseBoolConverter}}" />

                        <!-- Per-account game picker. Empty-state hint overlays the ComboBox until
                             at least one game is in the library, otherwise it looks broken.
                             MinWidth tuned down from 200 to give the name column room to breathe;
                             ComboBox grows naturally if the row width allows. 160 to 132 on 2026-11-02 (C2):
                             the expander moved into the name column, and at the declared 900 px the main row's
                             name line (expander, name, MAIN pill) wanted 142 DIP of a 132 DIP column, so the pill
                             clipped. Remove did not (an earlier "clips by 14" over-counted the roster's padding).
                             (MainWindowOneAccountFitsTests.AtTheDeclared900px_RemoveAndTheMainPillBothFit).
                             132 to 120 on 2026-11-03 (item 13), the FPS cap's width: the name line now trims, so the
                             pill no longer sets this, but Remove was cut by up to 10 DIP on badge rows and on French
                             rows (Launch As reads "Lancer en tant que"). The room came from here rather than from the
                             name column because the actions column is shared across rows, so a narrower name column
                             would trim every main account's name in French. Game names trim inside the picker.
                             (LabelWrapMeasurementTests.OnEveryBadgeRow_RemoveStaysInsideTheRow_InEverySupportedLanguage) -->
                        <Grid Margin="0,0,8,0" MinWidth="120" VerticalAlignment="Center" controls:ActionsRunPanel.GivesWay="True">
                            <ComboBox AutomationProperties.Name="{loc:Loc MainWindow_GameOrPrivateServerTo}"
                                      ItemsSource="{Binding DataContext.AvailableGames, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding SelectedGame}"
                                      VerticalAlignment="Center"
                                      SelectionChanged="OnGameComboBoxSelectionChanged"
                                      ToolTip="{loc:Loc MainWindow_GameOrSavedPrivateServer}">
                                <!-- The name, then a quiet "(private server)" suffix on a saved server (v1.36 item 9). The suffix
                                     used to be English prose hardcoded in Core and read through a display-member path;
                                     it is a resx key now. -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding RenderName}" />
                                            <TextBlock Text="{loc:Loc Shell_Games_PrivateSuffix}" Margin="4,0,0,0"
                                                       Visibility="{Binding IsPrivateServer, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <!-- v1.3.x — right-click any item in the dropdown for Rename / Reset.
                                     Skips the JoinByLink sentinel because BuildRenameTarget guards on
                                     PlaceId > 0 and returns null for the sentinel. -->
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:Loc MainWindow_Rename}"
                                                              Command="{Binding Data.RenameItemCommand, Source={StaticResource VmProxy}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="{loc:Loc MainWindow_ResetName}"
                                                              Command="{Binding Data.ResetItemNameCommand, Source={StaticResource VmProxy}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Style>
                                                            <Style TargetType="MenuItem">
                                                                <Setter Property="IsEnabled" Value="True" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.LocalName, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="{x:Null}">
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </MenuItem.Style>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <!-- Wave 3 moved Games off the toolbar into the Tools menu. This line
                                 tells a user where to go, so it has to name where the thing now is. -->
                            <!-- 2026-11-10: the picker gives way. It stretches to fit this hint, the translated
                                 hints are longer, and the stretch used to push Remove off a new user's first
                                 row in five of six languages (French by 54 DIP). The cell is marked GivesWay
                                 above, so the actions run hands it only the width that is left, and this text
                                 trims to fit it. See Controls/RowActionsLayout.cs. -->
                            <TextBlock Text="{loc:Loc MainWindow_AddGamesFromToolsGames}"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource BodyFontSize}"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Opacity="0.85"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="10,0,30,0"
                                       Visibility="{Binding DataContext.AvailableGames.Count, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ZeroToVisibilityConverter}}" />
                        </Grid>

                        <!-- Per-account FPS cap. ComboBox is populated with static items; code-behind
                             handles Loaded (initial selection) and SelectionChanged (persist + route to VM).
                             Tag on each item carries the int value (or x:Null for "no cap"). -->
                        <ComboBox
                            Width="120"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            SelectionChanged="FpsCombo_SelectionChanged" AutomationProperties.Name="{loc:Loc MainWindow_FpsCapAppliedAtLaunch}"
                            Loaded="FpsCombo_Loaded"
                            ToolTip="{loc:Loc MainWindow_FpsCapAppliedAtLaunch_2}">
                            <ComboBoxItem Content="{loc:Loc MainWindow_Fps}"         Tag="{x:Null}" />
                            <ComboBoxItem Content="{loc:Loc MainWindow_20Fps}"        Tag="20" />
                            <ComboBoxItem Content="{loc:Loc MainWindow_30Fps}"        Tag="30" />
                            <ComboBoxItem Content="{loc:Loc MainWindow_45Fps}"        Tag="45" />
                            <ComboBoxItem Content="{loc:Loc MainWindow_60Fps}"        Tag="60" />
                            <ComboBoxItem Content="{loc:Loc MainWindow_75Fps}"        Tag="75" />
                            <ComboBoxItem Content="{loc:Loc MainWindow_90Fps}"        Tag="90" />
                            <ComboBoxItem Content="{loc:Loc MainWindow_100Fps}"       Tag="100" />
                            <ComboBoxItem Content="{loc:Loc MainWindow_120Fps}"       Tag="120" />
                            <ComboBoxItem Content="{loc:Loc MainWindow_144Fps}"       Tag="144" />
                            <ComboBoxItem Content="{loc:Loc MainWindow_165Fps}"       Tag="165" />
                            <ComboBoxItem Content="{loc:Loc MainWindow_180Fps}"       Tag="180" />
                            <ComboBoxItem Content="{loc:Loc MainWindow_240Fps}"       Tag="240" />
                            <ComboBoxItem Content="{loc:Loc MainWindow_UnlimitedFps}" Tag="9999" />
                        </ComboBox>

                        <!-- Launch As (hidden while running — Stop takes its place) -->
                        <Button Content="{loc:Loc MainWindow_LaunchAs}"
                                AutomationProperties.AutomationId="DangerLaunchAs"
                                Command="{Binding DataContext.LaunchAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="14,6" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CtaButtonStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <!-- Item 13 (2026-11-03): on an expired row Re-authenticate takes this slot. Side by side
                                             they pushed Remove past the declared 900 px (shipped that way through v1.35). -->
                                        <DataTrigger Binding="{Binding SessionExpired}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <!-- Item 13: collapsed, not just disabled, on a limited row too. Disabled it still took
                                             its width and pushed Remove past 900 px beside Re-authenticate; the facts-line badge
                                             and the status line say why it cannot launch. -->
                                        <DataTrigger Binding="{Binding SessionLimited}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Recycle (Task 8, memory watchdog) — one-click stop+relaunch remedy for
                             a memory-warned row. MemoryWarning is the SAME amber flag driving the
                             memory chip above (Task 7) and the RowExpiredAccentBrush/amber pairing
                             used by Re-authenticate below — same "this row needs an action" visual
                             language, so the button appears exactly where/when the fix applies and
                             disappears once the watchdog reports clear. -->
                        <Button Content="{loc:Loc MainWindow_Recycle}"
                                AutomationProperties.AutomationId="DangerRecycle"
                                Command="{Binding DataContext.RecycleAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="12,6" Margin="0,0,8,0"
                                FontSize="{DynamicResource BodyFontSize}"
                                ToolTip="{loc:Loc MainWindow_CloseAndRelaunchThisClient}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WarningButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MemoryWarning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <!-- Opt-in (Preferences): Recycle also puts an account back
                                             in the server it's in, which is a reason to press it
                                             that has nothing to do with memory. Off by default —
                                             an untouched install keeps the v1.12 row silhouette. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                                <Condition Binding="{Binding DataContext.AlwaysShowRecycle, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Stop (visible while running) -->
                        <Button Style="{StaticResource AccentActionButtonStyle}" Content="{loc:Loc MainWindow_Stop}"
                                AutomationProperties.AutomationId="DangerStop"
                                Command="{Binding DataContext.StopAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="14,6" Margin="0,0,8,0"
                                ToolTip="{loc:Loc MainWindow_CloseTheRobloxWindowFor}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Remove. One of the three sites DestructiveButtonStyle is assigned to by
                             name (spec §6): it destroys a saved account and its cookie, and the
                             cookie cannot be recovered — re-authentication is the only way back.
                             Deliberately NOT an accent fill; on a row that also carries Launch As
                             and Stop, the loudest control must not be the one that deletes. -->
                        <Button Content="{loc:Loc MainWindow_Remove}"
                                AutomationProperties.AutomationId="DangerRemove"
                                Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="10,6"
                                Style="{StaticResource DestructiveButtonStyle}" />
                    </controls:ActionsRunPanel>

                    <!-- v1.36 facts line (A1, picked 2026-11-02): its own line under the whole row, in grid row 1 and
                         spanning the name and actions columns, so it has the row's width rather than the 160 px name
                         column. Row 1 is Auto and the panel is Collapsed (not Hidden) when it has nothing to say, so an
                         account with no facts, no history and no note renders exactly as in v1.35. Last played comes
                         from local history and counts as something to say; the age hint alone never opens the line.
                         Each badge shows only when its own fact is known. Robux, membership and friends online read the
                         masked placeholder under streamer mode and the note is hidden; last played and the age are not
                         masked. A WrapPanel, so it is one line in the common case and wraps only on a very narrow row or
                         a long language (F-119 precedent). Membership is built but collapsed whenever membership is not
                         a membership: the probes have not run. -->
                    <WrapPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"
                               Orientation="Horizontal" Margin="14,2,0,0"
                               Visibility="{Binding HasFactsLine, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- v1.36 health badge: one Button for the three states that stop a launch (expired,
                             needs verification, limited). Word, glyph and action differ per state, so flatline
                             can tell them apart with colour removed; colour is only the third carrier. It leads the
                             facts line (Este's item-13 ruling, 2026-11-03): on the name line it pushed the account name
                             to zero width at 900 px, even in English. A badge row always shows the facts line. The face
                             colour is the child TextBlock's (a Button may not paint itself). One command, HealthActionCommand,
                             dispatches on the row's Health. -->
                        <Button AutomationProperties.Name="{Binding HealthBadgeName}"
                                ToolTip="{Binding HealthBadgeName}"
                                Command="{Binding DataContext.HealthActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="6,1" Margin="0,0,6,3" MinHeight="0"
                                VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowHealthBadge}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding HealthBadgeText}"
                                       FontSize="{DynamicResource MetaFontSize}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource RowExpiredAccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HealthKind}" Value="verify">
                                                <Setter Property="Foreground" Value="{DynamicResource HealthVerifyBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HealthKind}" Value="limited">
                                                <Setter Property="Foreground" Value="{DynamicResource HealthLimitedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <!-- v1.36 Follow-marked badge: the per-account Join via friend flag, named as a health
                             state. Permanent while the mark is set (it coexists with the three states above);
                             clicking it toggles the mark, the same command the context menu carries. -->
                        <Button Command="{Binding DataContext.ToggleJoinViaFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding FollowMarkBadgeName}"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="6,1" Margin="0,0,6,3" MinHeight="0"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowFollowMarkBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding FollowMarkBadgeText}"
                                       FontSize="{DynamicResource MetaFontSize}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource CyanBrush}" />
                        </Button>
                        <!-- C2 colour (F2, 2026-11-02), all from ControlStyles.xaml: Robux is a Cyan chip with Cyan text, Plus a
                             Magenta outline with the lightened-magenta text in bold, friends online a Cyan outline with a
                             small Cyan dot before white text. The dot is decoration inside a badge that names itself. -->
                        <Border Style="{StaticResource FactBadgeAccentTextStyle}"
                                AutomationProperties.Name="{Binding RobuxAccessibleName}"
                                Visibility="{Binding ShowRobuxBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding RobuxText}" />
                        </Border>
                        <Border Style="{StaticResource FactBadgePlusStyle}"
                                AutomationProperties.Name="{Binding MembershipAccessibleName}"
                                Visibility="{Binding ShowMembershipBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- Our own plus glyph, not Roblox's hexagon mark (Este, 2026-11-03: their icon is a trademark
                                 and the listing claims no affiliation). Its stroke follows the word, so the expired-row
                                 white fallback reaches it; 8 px fits inside the text line, so the badge keeps its height. -->
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="PlusGlyph" Data="M4,0 V8 M0,4 H8"
                                      Width="8" Height="8" Margin="0,0,4,0" VerticalAlignment="Center"
                                      StrokeThickness="2" SnapsToDevicePixels="True"
                                      Stroke="{Binding Foreground, ElementName=PlusWord}" />
                                <TextBlock x:Name="PlusWord" Text="{Binding MembershipText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FactBadgeAccentStyle}"
                                AutomationProperties.Name="{Binding FriendsOnlineAccessibleName}"
                                Visibility="{Binding ShowFriendsOnlineBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,1,5,0" VerticalAlignment="Center"
                                         Fill="{DynamicResource CyanBrush}" />
                                <TextBlock Text="{Binding FriendsOnlineText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FactBadgeStyle}"
                                AutomationProperties.Name="{Binding LastPlayedAccessibleName}"
                                Visibility="{Binding ShowLastPlayedBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding LastPlayedText}" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Border Style="{StaticResource FactBadgeStyle}"
                                AutomationProperties.Name="{Binding NoteAccessibleName}"
                                Visibility="{Binding ShowNoteBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding NoteFirstLine}" MaxWidth="240"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </Border>
                        <TextBlock Text="{Binding FactsAgeText}" Margin="0,0,0,3" TextWrapping="Wrap"
                                   FontSize="{DynamicResource MetaFontSize}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ShowFactsAge, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FactsFailed}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource RowExpiredAccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>
                </controls:RowGrid>
            </Border>
            <!-- v1.36 account panel (B1, three columns; spec 3.6). The THIRD child of the row's outer StackPanel,
                 below AccountRowBorder and not inside it: the drag ghost and the drop targets still capture the
                 header only, the panel gets the row's full width, and FindRowAccountSummary / FocusAccountRow still
                 resolve because the panel is inside the same item container. Collapsed (so out of layout and out
                 of the tab order) while the panel is closed; FallbackValue keeps a row with no panel closed.
                 The header holds the private note (hidden under streamer mode) and Open Roblox home, which is
                 the one-account install's two-click path from Add account to a client. -->
            <Border x:Name="AccountPanelBorder"
                    Padding="44,12,14,12"
                    CornerRadius="0,0,8,8"
                    Background="{DynamicResource RowBgBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding Panel.IsExpanded, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="NoteBox"
                                    Grid.Column="0"
                                    AutomationProperties.Name="{Binding PanelNoteName}"
                                    PlaceholderText="{loc:Loc Shell_Panel_Note_Placeholder}"
                                    Text="{Binding NoteText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    MaxLength="200"
                                    FontSize="{DynamicResource BodyFontSize}"
                                    Padding="8,5"
                                    Margin="0,0,10,0"
                                    VerticalContentAlignment="Center"
                                    KeyDown="OnNoteBoxKeyDown"
                                    Visibility="{Binding ShowNoteBox, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button Grid.Column="1"
                                Content="{loc:Loc Shell_Panel_OpenHome}"
                                AutomationProperties.Name="{Binding PanelOpenHomeName}"
                                AutomationProperties.AutomationId="DangerOpenRobloxHome"
                                Command="{Binding Panel.OpenHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="{DynamicResource BodyFontSize}"
                                Padding="10,6"
                                VerticalAlignment="Center" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="{loc:Loc Shell_Panel_Heading_Recent}"
                                       FontFamily="{DynamicResource MonoFontFamily}"
                                       FontSize="{DynamicResource MetaFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Panel.Recent}" ItemTemplate="{StaticResource PanelEntryTemplate}" />
                            <TextBlock Text="{loc:Loc Shell_Panel_Empty_Recent}" TextWrapping="Wrap"
                                       FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="6,4"
                                       Visibility="{Binding Panel.Recent.Count, Converter={StaticResource ZeroToVisibilityConverter}, FallbackValue=Collapsed}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <!-- Favourites header (C2 ruling P1, 2026-11-02): the heading word, the TOTAL after it (hidden when there are
                                 none, where the empty state already reads), and, only when the column hides entries, a "See all"
                                 link that opens the Library page. Count and link share the header line, so they add no height: the link is 15 DIP tall
                                 against the 13 DIP mono heading, so its -1 vertical margins give it a 13 DIP layout height
                                 (measured: without them the Favourites column grew 2 DIP and the heavy panel scrolled). -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{loc:Loc Shell_Panel_Heading_Favourites}"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="{DynamicResource MetaFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Panel.FavouritesCountText}"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="{DynamicResource MetaFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding Panel.ShowFavouritesCount, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                                <Button Command="{Binding Panel.OpenLibraryCommand}"
                                        AutomationProperties.Name="{loc:Loc Shell_Panel_SeeAll_Favourites_Name}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="6,0" Margin="6,-1,0,-1" MinHeight="0"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Visibility="{Binding Panel.ShowFavouritesSeeAll, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <TextBlock Text="{loc:Loc Shell_Panel_SeeAll}"
                                               FontSize="{DynamicResource MetaFontSize}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource CyanBrush}" />
                                </Button>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Panel.Favourites}" ItemTemplate="{StaticResource PanelEntryTemplate}" />
                            <TextBlock Text="{loc:Loc Shell_Panel_Empty_Favourites}" TextWrapping="Wrap"
                                       FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="6,4"
                                       Visibility="{Binding Panel.Favourites.Count, Converter={StaticResource ZeroToVisibilityConverter}, FallbackValue=Collapsed}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <!-- Private servers header (C2 ruling P1, 2026-11-02): the same shape as the Favourites header above, count
                                 and See all link included, and the same -1 vertical margins on the link so the header stays 13 DIP. -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{loc:Loc Shell_Panel_Heading_PrivateServers}"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="{DynamicResource MetaFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Panel.PrivateServersCountText}"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="{DynamicResource MetaFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding Panel.ShowPrivateServersCount, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                                <Button Command="{Binding Panel.OpenLibraryCommand}"
                                        AutomationProperties.Name="{loc:Loc Shell_Panel_SeeAll_PrivateServers_Name}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="6,0" Margin="6,-1,0,-1" MinHeight="0"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Visibility="{Binding Panel.ShowPrivateServersSeeAll, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <TextBlock Text="{loc:Loc Shell_Panel_SeeAll}"
                                               FontSize="{DynamicResource MetaFontSize}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource CyanBrush}" />
                                </Button>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Panel.PrivateServers}" ItemTemplate="{StaticResource PanelEntryTemplate}" />
                            <TextBlock Text="{loc:Loc Shell_Panel_Empty_PrivateServers}" TextWrapping="Wrap"
                                       FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="6,4"
                                       Visibility="{Binding Panel.PrivateServers.Count, Converter={StaticResource ZeroToVisibilityConverter}, FallbackValue=Collapsed}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- TitleBar -->
            <RowDefinition Height="Auto" />  <!-- Header -->
            <RowDefinition Height="Auto" />  <!-- Roblox-updating banner (v1.7.0 pre-warm) -->
            <RowDefinition Height="Auto" />  <!-- StatusBanner -->
            <RowDefinition Height="Auto" />  <!-- Compat banner -->
            <RowDefinition Height="Auto" />  <!-- Bloxstrap warning banner -->
            <RowDefinition Height="*" />     <!-- Account list -->
            <RowDefinition Height="Auto" />  <!-- Footer -->
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{loc:Loc MainWindow_Rororo}"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True">
            <ui:TitleBar.Icon>
                <!-- 64x64 PNG source so WPF downsamples cleanly. Width/Height shrunk + center
                     alignment so the icon never collides with the title bar's icon-slot height
                     (the WPF-UI TitleBar slot is shorter than 18px on some Win11 chrome configs). -->
                <ui:ImageIcon Source="/ROROROblox.App;component/Tray/Resources/tray-on-titlebar.png"
                              Width="16" Height="16"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Header — two rows so the title block can never be clipped by the action buttons.
             Hidden entirely in compact mode (the bottom-bar Compact toggle is the way back out). -->
        <Border Grid.Row="1" Padding="24,18" Background="{DynamicResource NavyBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 1: title block (left) + primary actions (right). -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- VerticalAlignment matters now that the subtitle below is gone: without it
                         this panel stretches to the row height set by the + Add account button and
                         the title top-aligns a few pixels above that button's centreline. -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <controls:PageHeader ShowWordmark="True" Heading="{loc:Loc MainWindow_Accounts}" />
                        <!-- F-010: the Store-listing pitch used to live here — "Run multiple Roblox
                             clients side by side. Add a saved account, click Launch As to open it."
                             — read on every launch by someone who already has eight accounts on
                             screen. WelcomeWindow.xaml:45 carries the same pitch to the first-run
                             user, who is the one it was written for.

                             The empty state does NOT repeat it; it says "No saved accounts yet." and
                             names the next click. That is deliberate: the empty state's job is the
                             next action, not the elevator pitch.

                             docs/store/rename-plan.md had an open item to KEEP this line for
                             nominative use of the Roblox name. That reason survives without it —
                             WelcomeWindow.xaml:45 and AboutWindow.xaml:73 both still make the
                             nominative statement. The plan is updated rather than silently broken. -->

                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource CtaButtonStyle}" Content="{loc:Loc MainWindow_AddAccount}"
                                Command="{Binding AddAccountCommand}"
                                Padding="16,8"
                                AutomationProperties.AcceleratorKey="Ctrl+N"
                                ToolTip="{loc:Loc MainWindow_LogInToARoblox}"
                                FontSize="{DynamicResource HeadingFontSize}" />
                    </StackPanel>
                </Grid>

                <!-- Row 2: toolbar — secondary nav (left) + batch-launch CTAs (right). -->
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Six identically-weighted buttons became two (F-009). Settings is the only one
                         that writes settings.json, so it is the only one that earns the band; the rest
                         are verb-shaped and episodic — you go there, do a thing, and leave — which is
                         what "tool" means here (F-001).

                         The gear glyph is gone (F-012): one of six peers wore an icon for no
                         distinction the other five had.

                         TWO DELIBERATE DEPARTURES FROM THE REGISTER, so a later reader does not
                         "restore" them:

                         1. F-009 says the menu should rename Games -> Library. It must not. F-006
                            shipped in wave 1 and swept "Library" out of every user-visible string,
                            including the title of the window this item opens. F-009's direction was
                            written before that landed; following it would undo a merged wave.

                         2. F-009 says Tools should mirror the tray's item list. It does not exactly:
                            the tray runs Preferences/History/Diagnostics/Plugins, while this adds
                            About. Settings and Games are peer buttons here rather than menu items,
                            and Games and About are main-window destinations the tray never carried.

                         F-001 is closed: Stop all, Open log folder and the Welcome tour now sit in
                         groups 2 and 3 below, each bound to a MainViewModel command. Stop all and
                         Open log folder are the same commands the tray invokes (see
                         Tray/TrayWiring.cs), so those two surfaces cannot drift; the Welcome tour
                         has no tray equivalent. Spec:
                         docs/superpowers/specs/2026-08-09-rororo-f001-tools-verbs-design.md -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Games is a peer button, not a Tools entry. It was a toolbar button before
                             wave 3, wave 3 folded it into the menu, and it comes back out here: the
                             game library is a destination a player reaches for mid-session, and the
                             default-game widget one column over already sends people to the same
                             window. Two paths to Games where one of them was two clicks behind a
                             chevron. Removed from the Tools menu in the same change so the app has
                             one route per destination, not two. -->
                        <Button Content="{loc:Loc MainWindow_Games}"
                                AutomationProperties.AutomationId="ToolbarGames"
                                Command="{Binding OpenGamesCommand}"
                                Padding="10,6" Margin="0,0,6,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="{DynamicResource BodyFontSize}"
                                AutomationProperties.AcceleratorKey="Ctrl+G"
                                ToolTip="{loc:Loc MainWindow_SavedGamesAndPrivateServers}" />
                        <Button Content="{loc:Loc MainWindow_Settings}"
                                AutomationProperties.AutomationId="ToolbarSettings"
                                Command="{Binding OpenPreferencesCommand}"
                                Padding="10,6" Margin="0,0,6,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="{DynamicResource BodyFontSize}"
                                AutomationProperties.AcceleratorKey="Ctrl+,"
                                ToolTip="{loc:Loc MainWindow_StartupAccountsAlertsDiscordAnd}" />
                        <!-- A ToolsDropDownButton: a Button that owns its ContextMenu and adds what a
                             bare Button-with-ContextMenu lacked. The first cut announced to a screen
                             reader as a plain button (no ExpandCollapse pattern, no expanded state,
                             no hint that five destinations sat behind it); a real Menu was tried next
                             and rejected (Controls/ToolsDropDownButton.cs records why). The control
                             reports ExpandCollapse, focuses its first item on keyboard open, and
                             toggles shut on a second click. This comment said "a real Menu, not a
                             Button" until 2026-08-30; the element below is authoritative.

                             AutomationProperties.Name strips the chevron from what gets announced;
                             the glyph is a visual affordance, not part of the name. -->
                        <controls:ToolsDropDownButton Content="{loc:Loc MainWindow_Tools}"
                                AutomationProperties.AutomationId="ToolbarTools"
                                           AutomationProperties.Name="{loc:Loc MainWindow_Tools_2}"
                                           Padding="10,6" Margin="0,0,6,0"
                                           Style="{StaticResource SecondaryButtonStyle}"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           ToolTip="{loc:Loc MainWindow_HistoryDiagnosticsPluginsLogFolder}">
                            <controls:ToolsDropDownButton.ContextMenu>
                                <ContextMenu Background="{DynamicResource NavyBrush}"
                                             BorderBrush="{DynamicResource DividerBrush}"
                                             BorderThickness="1"
                                             Foreground="{DynamicResource WhiteBrush}">
                                <MenuItem Header="{loc:Loc MainWindow_History}"
                                AutomationProperties.AutomationId="ToolsHistory"
                                          Command="{Binding OpenHistoryCommand}"
                                          InputGestureText="Ctrl+H"
                                          ToolTip="{loc:Loc MainWindow_RecentSessionsPerAccountWhat}" />
                                <MenuItem Header="{loc:Loc MainWindow_Diagnostics}"
                                AutomationProperties.AutomationId="ToolsDiagnostics"
                                          Command="{Binding OpenDiagnosticsCommand}"
                                          InputGestureText="Ctrl+D"
                                          ToolTip="{loc:Loc MainWindow_SystemHealthRobloxWebview2Versions}" />
                                <MenuItem Header="{loc:Loc MainWindow_Plugins}"
                                AutomationProperties.AutomationId="ToolsPlugins"
                                          Command="{Binding OpenPluginsCommand}"
                                          InputGestureText="Ctrl+P"
                                          ToolTip="{loc:Loc MainWindow_InstallAndManageRororoPlugins}" />
                                <MenuItem Header="{Binding KnownIssuesMenuHeader}"
                                AutomationProperties.AutomationId="ToolsKnownRobloxIssues"
                                          Command="{Binding OpenKnownIssuesCommand}"
                                          ToolTip="{loc:Loc MainWindow_KnownRobloxIssuesTooltip}" />
                                <!-- F-001 group 2 — verbs that reach outside the app. Kept apart
                                     from the destinations above so the one destructive item is not
                                     a row away from Plugins; the confirm catches a mis-click, but
                                     distance is cheaper than a dialog. -->
                                <Separator Background="{DynamicResource DividerBrush}" />
                                <MenuItem Header="{loc:Loc MainWindow_OpenLogFolder}"
                                          Command="{Binding OpenLogFolderCommand}"
                                          ToolTip="{loc:Loc MainWindow_OpenTheFolderHoldingRororo}" />
                                <MenuItem Header="{loc:Loc MainWindow_StopAllRobloxInstances}"
                                AutomationProperties.AutomationId="DangerStopAll"
                                          Command="{Binding StopAllCommand}"
                                          ToolTip="{loc:Loc MainWindow_ForceCloseEveryRunningRoblox}" />
                                <!-- Explicitly themed. WPF-UI's default Separator draws a 4%-alpha
                                     white rule from its own dictionary, which ThemeService never
                                     touches (it owns ten RoRoRo slots and nothing else) — so on any
                                     user theme with a light field the divider vanishes. That is the
                                     same flatten-the-fill failure the popup border defends against,
                                     and it would have shipped one element away from it. -->
                                    <Separator Background="{DynamicResource DividerBrush}" />
                                    <MenuItem Header="{loc:Loc MainWindow_WelcomeTour}"
                                              AutomationProperties.AutomationId="ToolsWelcomeTour"
                                              Command="{Binding ShowWelcomeTourCommand}"
                                              ToolTip="{loc:Loc MainWindow_ReplayTheFirstRunTour}" />
                                    <MenuItem Header="{loc:Loc MainWindow_About}"
                                              AutomationProperties.AutomationId="ToolsAbout"
                                              Command="{Binding OpenAboutCommand}"
                                              InputGestureText="F1"
                                              ToolTip="{loc:Loc MainWindow_VersionLinksLicense}" />
                                </ContextMenu>
                            </controls:ToolsDropDownButton.ContextMenu>
                        </controls:ToolsDropDownButton>
                    </StackPanel>

                    <!-- v1.3.x — default-game widget. Lives between the left-side nav and the
                         right-side launch CTAs. Click toggles a popup of saved games; pick one
                         to set it default. Empty state hides the widget and shows a one-click
                         "Add games" entry in the same slot. Compact mode hides the entire header
                         (line 547), so the widget gets compact-mode hide for free. -->
                    <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Filled state: ToggleButton + dropdown Popup. -->
                        <ToggleButton x:Name="DefaultGameWidget"
                                      AutomationProperties.Name="{loc:Loc MainWindow_DefaultGamePickWhichGame}"
                                      MinWidth="220" MaxWidth="340"
                                      Padding="12,6"
                                      Background="{DynamicResource RowBgBrush}"
                                      Foreground="{DynamicResource WhiteBrush}"
                                      BorderBrush="{DynamicResource CyanBrush}"
                                      BorderThickness="1"
                                      Cursor="Hand"
                                      ToolTip="{Binding DefaultGameTooltip}"
                                      IsChecked="{Binding IsDefaultGameDropdownOpen, Mode=TwoWay}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource SecondaryToggleButtonStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WidgetGames.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Cyan default dot. -->
                                <Ellipse Grid.Column="0"
                                         Width="8" Height="8"
                                         Fill="{DynamicResource CyanBrush}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0" />

                                <!-- Mono-micro label. Brand: uppercase + tracking, magenta tint. -->
                                <TextBlock Grid.Column="1"
                                           Text="{loc:Loc Shell_Squad_Badge_Default}"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="{DynamicResource MetaFontSize}"
                                           Foreground="{DynamicResource MagentaBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />

                                <!-- The current default game's display name (LocalName ?? Name).
                                     Bound to MainViewModel.DefaultGameDisplay. -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DefaultGameDisplay}"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WhiteBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- Chevron — flips visually via the ToggleButton's IsChecked
                                     state if a future style upgrade wants it. For v1.3.x just
                                     a static down-pointing glyph. -->
                                <TextBlock Grid.Column="3"
                                           Text="&#x25BE;"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>
                        </ToggleButton>

                        <!-- Empty state: replaces the toggle when no games are saved.
                             One click → the Games window, the same destination as the Games button
                             in the toolbar. It was a toolbar button before wave 3, spent wave 3
                             through v1.19 inside the Tools menu, and is back in the toolbar. -->
                        <Button Content="{loc:Loc MainWindow_NoSavedGamesYetAdd}"
                                Command="{Binding OpenGamesCommand}"
                                MinWidth="220" MaxWidth="340"
                                Padding="12,6"
                                FontSize="{DynamicResource BodyFontSize}"
                                Cursor="Hand">
                            <Button.Style>
                                <!-- BasedOn rather than an attribute: this button already carries an
                                     inline Style for its empty-state visibility trigger, and Style
                                     can only be set once. Basing it on the shared secondary style
                                     keeps the themed edge AND the trigger. -->
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WidgetGames.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Dropdown popup: ListBox of saved games + Manage games footer. Closes on
                             pick (StaysOpen=False) or on outside-click. -->
                        <Popup IsOpen="{Binding ElementName=DefaultGameWidget, Path=IsChecked}"
                               PlacementTarget="{Binding ElementName=DefaultGameWidget}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="{DynamicResource RowBgBrush}"
                                    BorderBrush="{DynamicResource CyanBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4"
                                    Margin="0,4,0,0"
                                    MinWidth="280" MaxWidth="360">
                                <DockPanel>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Bottom"
                                            Content="{loc:Loc MainWindow_ManageGames}"
                                            Command="{Binding OpenGamesCommand}"
                                            Padding="10,6"
                                            Margin="0,4,0,0"
                                            HorizontalContentAlignment="Left"
                                            FontSize="{DynamicResource BodyFontSize}"
                                            Cursor="Hand" />
                                    <ListBox ItemsSource="{Binding WidgetGames}"
                                             SelectedItem="{Binding CurrentDefaultGame, Mode=OneWay}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             MaxHeight="280"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,1" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource GhostButtonStyle}" Padding="10,6"
                                                        AutomationProperties.Name="{Binding RenderName}"
                                                        HorizontalContentAlignment="Stretch"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.SetDefaultGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <!-- v1.3.x — right-click on a widget dropdown row for the
                                                         four-item action menu per spec §5.6. Click on the row
                                                         (the Button itself) is set-as-default; right-click is
                                                         the rest. -->
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{loc:Loc MainWindow_SetAsDefault}"
                                                                      Command="{Binding Data.SetDefaultGameCommand, Source={StaticResource VmProxy}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <Separator />
                                                            <MenuItem Header="{loc:Loc MainWindow_Rename}"
                                                                      Command="{Binding Data.RenameItemCommand, Source={StaticResource VmProxy}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="{loc:Loc MainWindow_ResetName}"
                                                                      Command="{Binding Data.ResetItemNameCommand, Source={StaticResource VmProxy}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                <MenuItem.Style>
                                                                    <Style TargetType="MenuItem">
                                                                        <Setter Property="IsEnabled" Value="True" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.LocalName, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="{x:Null}">
                                                                                <Setter Property="IsEnabled" Value="False" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </MenuItem.Style>
                                                            </MenuItem>
                                                            <Separator />
                                                            <MenuItem Header="{loc:Loc MainWindow_Remove}"
                                AutomationProperties.AutomationId="DangerRemove"
                                                                      Command="{Binding Data.RemoveGameCommand, Source={StaticResource VmProxy}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Cyan dot for the current default; transparent otherwise. -->
                                                        <Ellipse Grid.Column="0"
                                                                 Width="6" Height="6"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,8,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="Transparent" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource CyanBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>

                                                        <!-- Display name: LocalName ?? Name via the FavoriteGame.RenderName
                                                             computed property. PriorityBinding doesn't work here because
                                                             a null LocalName is a successful binding result, not a
                                                             fall-through trigger. -->
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding RenderName}"
                                                                   FontSize="{DynamicResource BodyFontSize}"
                                                                   Foreground="{DynamicResource WhiteBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />

                                                        <!-- DEFAULT pill on the current default. -->
                                                        <Border Grid.Column="2"
                                                                Background="{DynamicResource MagentaBrush}"
                                                                CornerRadius="2"
                                                                Padding="5,1"
                                                                Margin="8,0,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{loc:Loc Shell_Squad_Badge_Default}"
                                                                       FontFamily="{DynamicResource MonoFontFamily}"
                                                                       FontSize="{DynamicResource MetaFontSize}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource OnMagentaBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{loc:Loc MainWindow_LaunchMultiple}"
                                AutomationProperties.AutomationId="DangerLaunchMultiple"
                                Command="{Binding LaunchAllCommand}"
                                Visibility="{Binding HasMultipleAccounts, Converter={StaticResource BoolToVisibilityConverter}}"
                                Padding="14,6" Margin="0,0,8,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                FontSize="{DynamicResource BodyFontSize}"
                                FontWeight="SemiBold"
                                ToolTip="{loc:Loc MainWindow_LaunchEverySelectedAccountInto}"
                                AutomationProperties.AcceleratorKey="Ctrl+L" />
                        <!-- Labelled "Private server" until v1.14, when the modal stopped being
                             private-server-only: a plain game link now puts the squad in one public
                             server. The old label described the input, not what the button does. -->
                        <Button Style="{StaticResource AccentActionButtonStyle}" Content="{loc:Loc MainWindow_SquadLaunch}"
                                AutomationProperties.AutomationId="DangerSquadLaunch"
                                Command="{Binding OpenSquadLaunchCommand}"
                                Visibility="{Binding HasMultipleAccounts, Converter={StaticResource BoolToVisibilityConverter}}"
                                Padding="14,6"
                                FontSize="{DynamicResource BodyFontSize}"
                                ToolTip="{loc:Loc MainWindow_SendEverySelectedAccountInto}"
                                AutomationProperties.AcceleratorKey="Ctrl+J" />
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <!-- Roblox-updating banner (v1.7.0 install-deferral pre-warm).
             Shown while RobloxUpdating is true — i.e. a batch launched the first account and is
             holding the rest until a pending Roblox update lands (WaitForPreWarmAsync). Distinct,
             branded treatment so a slow update reads as an intended hold, not a hang. Cyan accent
             + indeterminate progress on the navy field, magenta dot pairing the brand. Auto-clears
             when RobloxUpdating flips false (the batch releases). All brushes are DynamicResource
             so ThemeService theme flips carry through. -->
        <Border Grid.Row="2" Padding="24,12"
                Background="{DynamicResource NavyBrush}"
                BorderBrush="{DynamicResource CyanBrush}"
                BorderThickness="0,0,0,2"
                Visibility="{Binding RobloxUpdating, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!-- Brand dot pairing — cyan + magenta, always together. -->
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{DynamicResource CyanBrush}" />
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="4,0,10,0"
                             Fill="{DynamicResource MagentaBrush}" />
                    <TextBlock Text="{loc:Loc MainWindow_RobloxIsUpdating}"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource HeadingFontSize}" FontWeight="SemiBold"
                               Foreground="{DynamicResource CyanBrush}" />
                </StackPanel>
                <TextBlock Text="{loc:Loc MainWindow_HoldingYourOtherAccountsUntil}"
                           Margin="0,4,0,0"
                           FontSize="{DynamicResource BodyFontSize}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WhiteBrush}" />
                <!-- Indeterminate spinner — same pattern as CookieCapture's loading overlay. -->
                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             Margin="0,10,0,0"
                             HorizontalAlignment="Stretch"
                             Foreground="{DynamicResource CyanBrush}"
                             Background="{DynamicResource RowBgBrush}"
                             BorderThickness="0" />
            </StackPanel>
        </Border>

        <!-- Status banner + idle summary strip + runtime contested-lock banner. Three
             independently-collapsing children share one Border so each can show/hide on its
             own without a Grid row renumber — mirrors how StatusBanner itself shows/hides via
             StringToVisibilityConverter. -->
        <Border Grid.Row="3" Padding="24,8"
                Background="{DynamicResource RowBgBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding StatusBanner}" Value="" />
                                <Condition Binding="{Binding IdleSummaryText}" Value="" />
                                <Condition Binding="{Binding ContestedBannerText}" Value="" />
                                <Condition Binding="{Binding FpsCapWarningText}" Value="" />
                                <Condition Binding="{Binding KnownIssueNoticeText}" Value="" />
                                <Condition Binding="{Binding CrashNoticeText}" Value="" />
                                <Condition Binding="{Binding RatingAskText}" Value="" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding StatusBanner}"
                           FontSize="{DynamicResource BodyFontSize}"
                           Foreground="{DynamicResource WhiteBrush}"
                           Visibility="{Binding StatusBanner, Converter={StaticResource StringToVisibilityConverter}}" />
                <!-- Passive idle-summary strip (v1.8) — "N accounts idle > Mm". Driven by
                     ActivitySnapshotApplier + IdleSummary on the 30s ticker; never blocks or
                     acts on the client, display-only. -->
                <TextBlock Text="{Binding IdleSummaryText}"
                           FontSize="{DynamicResource BodyFontSize}"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Visibility="{Binding IdleSummaryText, Converter={StaticResource StringToVisibilityConverter}}" />
                <!-- Runtime contested-lock banner (tray-residence): shown when Roblox holds the
                     multi-instance lock post-startup. Same recovery actions as the startup modal. -->
                <StackPanel Orientation="Vertical" Margin="0,4,0,0"
                            Visibility="{Binding ContestedBannerText, Converter={StaticResource StringToVisibilityConverter}}">
                    <!-- The third warning surface on this window, and the last literal in this file.
                         #F1B232 was brand's RowExpiredAccent value frozen in place, so under
                         flatline it stayed amber on an achromatic field exactly as the Bloxstrap
                         banner did. Bound rather than left, per item 1's ruling that warning
                         surfaces share one themed vocabulary. This text sits on the PAGE field
                         rather than a banner fill, so it was measured against Bg rather than
                         RowExpiredBg: 8.85 brand, 7.23 midnight, 9.85 magenta-heat, 12.84 flatline,
                         all clear of 4.5. Byte-identical in brand and magenta-heat. -->
                    <TextBlock Text="{Binding ContestedBannerText}"
                               FontSize="{DynamicResource BodyFontSize}" TextWrapping="Wrap"
                               Foreground="{DynamicResource RowExpiredAccentBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Style="{StaticResource CtaButtonStyle}" Content="{loc:Loc MainWindow_CloseRobloxForMe}" Command="{Binding CloseRobloxForMeCommand}"
                                Padding="10,4" Margin="0,0,8,0" FontSize="{DynamicResource BodyFontSize}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="{loc:Loc MainWindow_Retry}" Command="{Binding RetryMutexCommand}"
                                Padding="10,4" FontSize="{DynamicResource BodyFontSize}" />
                    </StackPanel>
                </StackPanel>
                <!-- FPS-cap mismatch (2026-08-02). Roblox keeps one shared settings file per
                     install, so differing per-account caps force a settle window between
                     launches. Display only — it never blocks launching. Dismissible per
                     distinct-cap-set signature (see MainViewModel.RefreshFpsCapWarning) — sticks
                     until the set of distinct caps actually changes, so acknowledging today's
                     mismatch doesn't silence a genuinely new one later. DockPanel (not a Grid
                     row) so the button docks right while the text keeps wrapping in the
                     remaining width — same shape as the Bloxstrap banner below, just quieter. -->
                <!-- F-073's second half, and the reason a Grid replaced the DockPanel here.
                     A screen reader and the Tab key both follow DECLARATION order, and DockPanel
                     forced the action to be declared first so it could dock right — so "Dismiss the
                     frame-rate cap warning" was offered before the warning it dismisses had been
                     read. The earlier pass named both buttons and then stopped, recording that
                     swapping the order under LastChildFill would need the layout re-proved rather
                     than reasoned about. That was the right call and this is the other half of it:
                     a Grid decouples declaration order from visual position entirely, which is
                     precisely what DockPanel cannot do. Star column wraps the message, Auto column
                     holds the button, and the pixels are unchanged. -->
                <Grid Margin="0,4,0,0"
                      Visibility="{Binding FpsCapWarningText, Converter={StaticResource StringToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding FpsCapWarningText}"
                               FontSize="{DynamicResource BodyFontSize}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource GhostButtonStyle}"
                            Content="{loc:Loc MainWindow_Dismiss}"
                            AutomationProperties.Name="{loc:Loc MainWindow_DismissTheFrameRateCap}"
                            Command="{Binding DismissFpsCapWarningCommand}"
                            Margin="8,0,0,0"
                            Padding="0"
                            FontSize="{DynamicResource BodyFontSize}"
                            VerticalAlignment="Top"
                            Cursor="Hand" />
                </Grid>
                <!-- Known Roblox issues (spec 2026-09-23). Suppressed while the contested warning shows
                     (KnownIssuesNoticeModel.SetSuppressed, fed from SetContested). A Grid for the same
                     reason as the frame-rate row above: declaration order is reading order, so the
                     message is read before its two actions. -->
                <Grid Margin="0,4,0,0"
                      Visibility="{Binding KnownIssueNoticeText, Converter={StaticResource StringToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding KnownIssueNoticeText}"
                               FontSize="{DynamicResource BodyFontSize}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WhiteBrush}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{loc:Loc MainWindow_SeeKnownIssues}"
                            Command="{Binding OpenKnownIssuesCommand}"
                            Padding="10,4"
                            Margin="8,0,0,0"
                            FontSize="{DynamicResource BodyFontSize}" />
                    <Button Grid.Column="2"
                            Style="{StaticResource GhostButtonStyle}"
                            Content="{loc:Loc MainWindow_Dismiss}"
                            AutomationProperties.Name="{loc:Loc MainWindow_DismissKnownIssueNotice}"
                            Command="{Binding DismissKnownIssueNoticeCommand}"
                            Padding="10,4"
                            Margin="4,0,0,0"
                            FontSize="{DynamicResource BodyFontSize}" />
                </Grid>
                <!-- The crash notice (2026-11-10). Shown on the start after a RECORDED crash (never after
                     a kill, a Store update or a power cut, which leave no record). With no telemetry, a
                     support bundle the person chooses to send is the only way a crash reaches us. The
                     same shape as the known-issues row: message first, then its two actions. A start
                     that shows this does not also show the rating ask below. -->
                <Grid Margin="0,4,0,0"
                      Visibility="{Binding CrashNoticeText, Converter={StaticResource StringToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding CrashNoticeText}"
                               FontSize="{DynamicResource BodyFontSize}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WhiteBrush}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{loc:Loc MainWindow_OpenDiagnostics}"
                            Command="{Binding OpenDiagnosticsFromCrashNoticeCommand}"
                            Padding="10,4"
                            Margin="8,0,0,0"
                            FontSize="{DynamicResource BodyFontSize}" />
                    <Button Grid.Column="2"
                            Style="{StaticResource GhostButtonStyle}"
                            Content="{loc:Loc MainWindow_Dismiss}"
                            AutomationProperties.Name="{loc:Loc MainWindow_DismissCrashNotice}"
                            Command="{Binding DismissCrashNoticeCommand}"
                            Padding="10,4"
                            Margin="4,0,0,0"
                            FontSize="{DynamicResource BodyFontSize}" />
                </Grid>
                <!-- The one-time rating ask (2026-11-10). A Store install only, after three separate
                     days with an attached launch, and only ever handed over at startup, so it is
                     never on screen in the middle of a launch. The same shape as the known-issues
                     row above for the same reason: declaration order is reading order, so the
                     message is read before its two actions. Either button ends it for good. -->
                <Grid Margin="0,4,0,0"
                      Visibility="{Binding RatingAskText, Converter={StaticResource StringToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding RatingAskText}"
                               FontSize="{DynamicResource BodyFontSize}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WhiteBrush}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{loc:Loc MainWindow_RateRoRoRo}"
                            Command="{Binding RateOnStoreCommand}"
                            Padding="10,4"
                            Margin="8,0,0,0"
                            FontSize="{DynamicResource BodyFontSize}" />
                    <Button Grid.Column="2"
                            Style="{StaticResource GhostButtonStyle}"
                            Content="{loc:Loc MainWindow_NotNow}"
                            AutomationProperties.Name="{loc:Loc MainWindow_DismissRatingAsk}"
                            Command="{Binding DismissRatingAskCommand}"
                            Padding="10,4"
                            Margin="4,0,0,0"
                            FontSize="{DynamicResource BodyFontSize}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Roblox compat banner (drift detection per spec §7.1) -->
        <Border Grid.Row="4" Padding="24,10"
                Background="{DynamicResource RowExpiredBgBrush}"
                BorderBrush="{DynamicResource RowExpiredAccentBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding RobloxCompatBanner, Converter={StaticResource StringToVisibilityConverter}}">
            <!-- The "▲ " is a literal Run rather than a prefix baked into RobloxCompatBanner, for
                 two reasons. The string is the compat checker's own output (MainViewModel takes it
                 straight from RobloxCompatResult.Banner) and presentation glyphs do not belong in a
                 drift-detection result. And the glyph can never render on its own: the Border above
                 collapses on the same binding via StringToVisibilityConverter, so no banner text
                 means no banner at all.
                 Same glyph the memory and idle chips use — one warning vocabulary across the
                 window (spec §6.3). The two Runs sit on one line deliberately; a line break between
                 them is significant whitespace. -->
            <TextBlock FontSize="{DynamicResource BodyFontSize}"
                       Foreground="{DynamicResource RowExpiredAccentBrush}"
                       TextWrapping="Wrap"><Run Text="▲ " /><Run Text="{Binding RobloxCompatBanner}" /></TextBlock>
        </Border>

        <!-- Bloxstrap warning banner — visible when BloxstrapWarningVisible is true.
             Takes the SAME themed warning recipe as the compat banner one Grid row above, per the
             v1.21 item 1 ruling recorded on F-085. This banner used to carry its own amber, and its
             comment called that amber deliberate: "distinct from the red-ish compat banner above
             it". Read both under flatline and the distinction turned out to be carried by the
             defect — the compat banner is themed and goes grey, this one was frozen and stayed
             amber, so the thing telling the reader these were two kinds of warning was the one
             banner that ignored the theme.
             The difference is now carried by TEXT and the "▲" glyph, not by hue, which is F-032's
             precedent: MutedText vs White measured 1.00:1 under flatline, colour could not carry
             "quiet", and weight took over. Two warnings should look like two warnings and read as
             two warnings. Measured before the migration, not after — RowExpiredAccent on
             RowExpiredBg is 7.13 / 6.58 / 7.13 / 7.33 across brand, midnight, magenta-heat and
             flatline, so no foreground had to move. -->
        <Border Grid.Row="5"
                Background="{DynamicResource RowExpiredBgBrush}"
                BorderBrush="{DynamicResource RowExpiredAccentBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10"
                Visibility="{Binding BloxstrapWarningVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- F-073, same shape and same fix as the frame-rate banner above: a Grid so the
                 message is DECLARED before the action that dismisses it, which is the order a screen
                 reader and the Tab key follow, while the button still sits on the right. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Two Runs on one line, matching the compat banner: a line break between them is
                     significant whitespace and would render as a space after the glyph. -->
                <TextBlock Grid.Column="0"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource RowExpiredAccentBrush}"><Run Text="▲ " /><Run Text="{loc:Loc MainWindow_BloxstrapIsSetAsYour}" /></TextBlock>
                <Button Grid.Column="1"
                    Style="{StaticResource GhostButtonStyle}"
                    Content="{loc:Loc MainWindow_Dismiss}"
                    AutomationProperties.Name="{loc:Loc MainWindow_DismissTheBloxstrapWarning}"
                    Margin="12,0,0,0"
                    Command="{Binding DismissBloxstrapWarningCommand}" />
            </Grid>
        </Border>

        <!-- Row 6 — switches between full account list (normal) and compact strip (compact mode). -->
        <Grid Grid.Row="6">
            <!-- Full account list — visible when NOT compact. Horizontal scroll is a
                 No horizontal scrollbar — Window.MinWidth=860 floors the window wide enough
                 that all row content fits. If the user shrinks below that we'd rather clip /
                 trim the name (TextTrimming on DisplayName handles long names) than let a
                 horizontal scrollbar steal vertical space. Compact mode is the right answer
                 for "I want this small." -->
            <!-- Full-list view: a tag/name filter bar docked above the scrollable account list.
                 The whole DockPanel hides in compact mode (the compact strip below takes over). -->
            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <!-- v1.6.0 (7b) — tag/name filter. Narrows the list by toggling per-row visibility
                     (AccountSummary.IsFilteredOut) so the Accounts order is untouched and drag-
                     reorder stays valid. Reorder is disabled while a filter is active; clearing it
                     restores reorder. Whole bar hides when there are no accounts to filter. -->
                <Grid DockPanel.Dock="Top" Margin="24,12,24,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Accounts.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ui:TextBox x:Name="FilterBox" PlaceholderText="{loc:Loc MainWindow_FilterAccountsByTagOr}" AutomationProperties.Name="{loc:Loc MainWindow_FilterAccounts}"
                                AutomationProperties.AcceleratorKey="Ctrl+F"
                                Text="{Binding AccountFilter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                Icon="{ui:SymbolIcon Filter24}"
                                ClearButtonEnabled="True"
                                FontSize="{DynamicResource BodyFontSize}"
                                ToolTip="{loc:Loc MainWindow_ShowOnlyAccountsWhoseTag}" />
                </Grid>

                <ScrollViewer Padding="24,12,24,16"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid Grid.IsSharedSizeScope="True">
                    <ItemsControl x:Name="AccountsItemsControl" ItemsSource="{Binding Accounts}" />

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Accounts.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                        <TextBlock Text="{loc:Loc MainWindow_NoSavedAccountsYet}"
                                   FontSize="{DynamicResource HeadingFontSize}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Loc MainWindow_ClickAddAccountToLog}"
                                   FontSize="{DynamicResource BodyFontSize}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"
                                   Opacity="0.7" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </DockPanel>

            <!-- Compact strip — visible ONLY when compact. Three layers: live-rows list,
                 then a content overlay with the 3-state empty area when nothing's running. -->
            <Border Padding="14,14,14,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <!-- Live-running rows — only renders when there's at least one. -->
                    <ItemsControl ItemsSource="{Binding CompactRows}"
                                  ItemTemplate="{StaticResource CompactAccountTemplate}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCompactRows}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>

                    <!-- Empty state — three-variant CTA so compact never looks broken. -->
                    <ContentControl HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCompactRows}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>

                        <!-- Variant A — main is set + idle: "Start [Username]" CTA -->
                        <Grid>
                            <StackPanel HorizontalAlignment="Stretch">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CompactEmptyKind}" Value="StartMain">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{loc:Loc MainWindow_NoRobloxRunning}"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8" />
                                <Button Style="{StaticResource CtaButtonStyle}" Command="{Binding StartMainCommand}"
                                        Padding="14,10"
                                        FontSize="{DynamicResource HeadingFontSize}"
                                        HorizontalAlignment="Stretch"
                                        ToolTip="{loc:Loc MainWindow_LaunchYourMainAccountInto}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{loc:Loc MainWindow_Start}" />
                                        <TextBlock Text="{Binding MainAccount.RenderName, FallbackValue='main'}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Variant B — accounts exist but no main set -->
                            <StackPanel HorizontalAlignment="Stretch">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CompactEmptyKind}" Value="NoMainPicked">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{loc:Loc MainWindow_NoMainAccountPicked}"
                                           FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WhiteBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{loc:Loc MainWindow_ExpandAndClickTheOn}"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />
                                <Button Command="{Binding ToggleCompactCommand}"
                                        Content="{loc:Loc MainWindow_Expand}"
                                        Padding="14,8"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- Variant C — no accounts saved at all -->
                            <StackPanel HorizontalAlignment="Stretch">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CompactEmptyKind}" Value="NoAccounts">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{loc:Loc MainWindow_NoAccountsSaved}"
                                           FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WhiteBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8" />
                                <Button Style="{StaticResource CtaButtonStyle}" Command="{Binding AddAccountCommand}"
                                        Content="{loc:Loc MainWindow_AddYourFirstAccount}"
                                        Padding="14,10"
                                        FontSize="{DynamicResource BodyFontSize}"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="7" Padding="16,8" Background="{DynamicResource NavyBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Live process count + status dot. The FIFTH status-colour site (F-088) — spec
                     §5.3 enumerated four, and this one shipped alongside F-080 in PR #96 holding the
                     same brand green and grey the deleted StatusDotBrushConverter held. The two hexes
                     are recorded in F-088's row, not here: a comment that names a shipped colour goes
                     false the moment the theme changes it, which is the whole defect class item 6
                     spent an item removing. Same mapping as the per-row dot above — live takes
                     WhiteBrush, zero clients takes MutedTextBrush.

                     ARRANGEMENT IS INVERTED FROM THE ROW DOT, on purpose. There, quiet is the plain
                     Setter and the loud states are triggers, because StatusDot is a four-string enum
                     whose quiet value doubles as the fallback for a string nobody planned for. Here
                     the bound value is an int: DataTrigger matches on equality, so "zero" is
                     expressible as a trigger and "any number of clients" is not. Putting live in the
                     Setter is what keeps this on {DynamicResource} without a converter or a new
                     view-model bool — the machinery §5.2 deleted. The cost, named rather than
                     buried: a binding that fails outright leaves the dot at the live colour. It sits
                     beside LiveProcessSummary, which states the count in words, so the dot is a
                     redundant echo either way (§6.1). -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7"
                             VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource WhiteBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LiveProcessCount}" Value="0">
                                        <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding LiveProcessSummary}"
                               FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{DynamicResource WhiteBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Compact / Expand toggle, sitting next to the count on the left. -->
                <Button Style="{StaticResource GhostButtonStyle}" Grid.Column="1"
                        Command="{Binding ToggleCompactCommand}"
                        Content="{Binding CompactToggleLabel}" AutomationProperties.Name="{Binding CompactToggleLabel}"
                        Padding="10,4" Margin="14,0,0,0"
                        FontSize="{DynamicResource MetaFontSize}"
                        VerticalAlignment="Center"
                        ToolTip="{loc:Loc MainWindow_ShrinkToASmallOps}" />

                <!-- F-011: Grid.Column="2" held "Multi-launcher for Windows. A 626 Labs product."
                     Every other cell in this status bar reports live state; that one sold the app to
                     someone already running it. The line is the actual subject of the About window,
                     which is where it still lives.

                     F-018 puts live state back in the cell, which is what the column was for. The
                     product's core switch was reported ONLY inside the tray's right-click menu —
                     a menu Windows hides behind an overflow chevron on a default install — so the
                     one thing RoRoRo exists to do had no indicator on the window the user looks at.
                     This is a READOUT, not the switch: the toggle stays in the tray, and the
                     tooltip is what says where to find it.

                     Left-aligned inside a star column so the right-hand hint keeps its position.

                     THREE STATES, TWO BRUSHES, NO NEW TOKEN. ON takes WhiteBrush at regular weight
                     — the same "this is live" reading the client-count cell to its left uses. OFF
                     takes MutedTextBrush. ERROR takes WhiteBrush at SemiBold: a third foreground
                     would be a new status-colour site for ThemedStatusColourTests to govern and a
                     token every user theme would have to supply, when weight already separates it. -->
                <TextBlock Grid.Column="2"
                           Text="{Binding MultiInstanceSummary}"
                           ToolTip="{Binding MultiInstanceTooltip}"
                           AutomationProperties.Name="{Binding MultiInstanceSummary}"
                           AutomationProperties.HelpText="{Binding MultiInstanceTooltip}"
                           FontSize="{DynamicResource BodyFontSize}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                            <Setter Property="FontWeight" Value="Normal" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MultiInstanceIsHealthy}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MultiInstanceNeedsAttention}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="3"
                           Text="{loc:Loc MainWindow_XMinimizesToTrayQuit}"
                           FontSize="{DynamicResource MetaFontSize}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Opacity="0.7"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Drag-ghost preview Popup. Positioned absolute (screen coords) and repositioned on
             every PreviewDragOver during a drag-to-reorder gesture. Uses a RenderTargetBitmap
             snapshot rather than VisualBrush of the live row — adorners + live VisualBrushes
             both have known WPF rendering issues during a modal drag operation; the bitmap+Popup
             combination renders reliably across versions. -->
        <Popup x:Name="DragGhostPopup"
               Placement="Absolute"
               AllowsTransparency="True"
               IsOpen="False"
               AllowDrop="False">
            <Border Opacity="0.78" IsHitTestVisible="False" Background="Transparent">
                <Image x:Name="DragGhostImage"
                       Stretch="None"
                       IsHitTestVisible="False" />
            </Border>
        </Popup>
    </Grid>
</ui:FluentWindow>
