                                      SelectionChanged="OnThemeChanged"
                                      Padding="8,6"
                                      FontSize="{DynamicResource BodyFontSize}" />
                            <!-- One sentence per built-in, keyed by id via ThemeDescriptions.For.
                                 User themes return null: Collapsed, not Hidden, so no empty gap
                                 is left where the line would have been. -->
                            <TextBlock x:Name="ThemeDescriptionText"
                                       FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource AccentActionButtonStyle}" x:Name="BuildThemeButton"
                                        Content="{loc:Loc SettingsPage_BuildATheme}"
                                        HorizontalAlignment="Left"
                                        Padding="10,5" Margin="0,0,8,0"
                                        FontSize="{DynamicResource BodyFontSize}"
                                        Click="OnBuildThemeClick"
                                        ToolTip="{loc:Loc SettingsPage_OpenTheThemeBuilderCopy}" />
                                <Button x:Name="OpenThemesFolderButton"
                                        Content="{loc:Loc SettingsPage_OpenThemesFolder}"
                                        HorizontalAlignment="Left"
                                        Padding="10,5"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontSize="{DynamicResource BodyFontSize}"
                                        Click="OnOpenThemesFolderClick"
                                        ToolTip="{loc:Loc SettingsPage_DropAJsonFileIn}" />
                                <!-- The way back to the outline question (F-078, spec 4.3). It used
                                     to be asked once per theme and never again: EdgeRemediationWindow
                                     says so in its own source — "one reflexive click on the title-bar
                                     X must not permanently opt somebody's theme out of the fix
                                     without them reading a word of it — there is no re-ask affordance
                                     anywhere." This is that affordance.

                                     It stands on its own rather than reading "ask me again", because
                                     prd Story 1.4 requires it to be discoverable WITHOUT knowing the
                                     prompt ever happened. "Again" is a word only somebody who saw the
                                     first one can parse.

                                     It puts the same question through the same dialog and records
                                     the answer through the same setter — see OnReviewEdgeClick. -->
                                <Button x:Name="ReviewEdgeButton"
                                        Content="{loc:Loc SettingsPage_ReviewButtonOutlines}"
                                        HorizontalAlignment="Left"
                                        Padding="10,5" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontSize="{DynamicResource BodyFontSize}"
                                        AutomationProperties.Name="{loc:Loc SettingsPage_ReviewButtonOutlinesOnThis}"
                                        Click="OnReviewEdgeClick"
                                        ToolTip="{loc:Loc SettingsPage_SeeBothVersionsOfThis}" />
                            </StackPanel>
                            <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Text="{loc:Loc SettingsPage_ThemesPeopleWriteThemselvesSometimes}" />
                            <!-- This section's own failure line (spec 5), sibling to
                                 AlertsStatusLine and deliberately NOT dressed like it.
                                 AlertsStatusLine is CyanBrush, which is the accent — the same
                                 treatment a success gets — so a failure painted cyan would look
                                 like a save. RowExpiredAccentBrush and the U+25B2 prefix are the
                                 warning vocabulary v1.17 established across expired rows, idle
                                 chips, memory chips and the compat banner, and item 3's
                                 MemorySettingsWarning already speaks it. AlertsStatusLine itself is
                                 left alone; spec 10 records it as an open issue.

                                 Two things reach it: a theme that applied but could not be written
                                 down, and a file in the themes folder that could not be read. The
                                 text is composed by ThemeStatusSummary, which is where the copy is
                                 tested — nothing here decides what it says.

                                 Collapsed until there is something wrong. Success stays silent. -->
                            <TextBlock x:Name="ThemeStatusLine"
                                       FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource RowExpiredAccentBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       Visibility="Collapsed"
                                       AutomationProperties.Name="{loc:Loc SettingsPage_ThemeWarning}"
                                       AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </Border>

                    <!-- Language (localization, 2026-09-07). The picker is populated in code from
                         UiCulture.Available() — only languages whose catalog actually ships, so a
                         fresh build with no translated catalogs shows English alone. x:Static binds
                         once, so a change applies on the next launch; the hint says so. -->
                    <TextBlock Text="{loc:Loc SettingsPage_Language}"
                               Style="{StaticResource SectionHeadingStyle}"
                               Margin="0,20,0,0"
                               AutomationProperties.Name="{loc:Loc SettingsPage_Language}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"
                                       Text="{loc:Loc SettingsPage_LanguageHint}" />
                            <ComboBox x:Name="LanguagePicker"
                                      AutomationProperties.Name="{loc:Loc SettingsPage_Language}"
                                      DisplayMemberPath="DisplayName"
                                      HorizontalAlignment="Left"
                                      Width="220"
                                      Padding="8,6"
                                      SelectionChanged="OnUiLanguageChanged"
                                      FontSize="{DynamicResource BodyFontSize}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
