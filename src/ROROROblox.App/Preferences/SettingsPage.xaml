                                             LostFocus="OnPushoverKeyCommitted" Style="{StaticResource AppTextBoxStyle}"/>
                                    <ToggleButton x:Name="PushoverUserKeyReveal" Grid.Column="1" Content="{loc:Loc SettingsPage_Show}"
                                                  AutomationProperties.Name="{loc:Loc SettingsPage_ShowOrHideTheSaved}"
