<UserControl x:Class="ROROROblox.App.Preferences.SettingsPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ROROROblox.App.Controls">

    <UserControl.Resources>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <controls:PageHeader Heading="Settings" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="164" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="SettingsNav" Grid.Column="0"
                     Background="Transparent"
                     BorderThickness="0"
                     FontSize="{DynamicResource HeadingFontSize}"
                     ItemContainerStyle="{StaticResource NavItemStyle}"
                     SelectionChanged="OnNavSelectionChanged">
                    <ListBoxItem Content="Startup" />
                    <ListBoxItem Content="Accounts" />
                    <ListBoxItem Content="Alerts &amp; memory" />
                    <ListBoxItem Content="Discord" />
                    <ListBoxItem Content="Appearance" />
            </ListBox>

            <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                <Grid>
                <!-- HOW EVERY PAGE BELOW IS GROUPED (F-026, spec 3.1). A section is a
                     SectionHeadingStyle heading standing OUTSIDE the cards; a setting is a row
                     INSIDE one. Before this, every setting wore its own card, so a card holding one
                     control and the ten-control Alerts card carried identical weight — "card" meant
                     both "group" and "setting", which is the two-meanings defect the row is about.

                     The heading is the level that was missing, and the shared style already had it:
                     Margin="0,18,0,6" puts 18px above and 6px below, which places a heading BETWEEN
                     cards rather than inside one. Cards holding a single control collapsed into the
                     section they belong to instead of each wearing full chrome.

                     DO NOT answer a future grouping need with a second container rank — a
                     SubCardBorderStyle, a GroupBox, an Expander. Another container restates the
                     defect this structure removes.

                     WHY THE HEADING AND NOT THE FILL, measured 2026-08-10 on the shipped built-ins.
                     RowBg against Bg — the card's entire separation from the page — is 1.09:1 in
                     brand, 1.08:1 in midnight, 1.08:1 in magenta-heat and 1.33:1 in flatline. The
                     fill was never carrying the group anywhere; it is under 3:1 in all four, and
                     flatline (the theme the last cycle shipped, and the one this was expected to
                     fail on) is in fact the STRONGEST of the four, not the weakest. So grouping is
                     carried by the heading's weight and its 18/6 rhythm, which is achromatic and
                     survives with colour removed. Do not reintroduce a hierarchy that reads only in
                     hue. Note the register's older "flatline collapses RowBg into Bg" figure belongs
                     to the adversarial fixture in FlatlineLabGateTests, not to the flatline theme in
                     ThemeStore — MutedTextFenceTests carries the same correction for the prose
                     token. (Do not name that fixture here: its own gate fences the name out of
                     shipped source, and this comment tripped it once already.) -->
                <StackPanel x:Name="PageStartup">
                    <TextBlock Text="Startup"
                               Style="{StaticResource SectionHeadingStyle}"
                               AutomationProperties.Name="Startup"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <StackPanel>
                                <CheckBox x:Name="RunOnLoginToggle"
                                          Foreground="{DynamicResource WhiteBrush}"
                                          FontSize="{DynamicResource HeadingFontSize}"
                                          FontWeight="SemiBold"
                                          Click="OnRunOnLoginToggle">
                                    <TextBlock Text="Start RoRoRo when Windows starts." />
                                </CheckBox>
                                <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,0"
                                           Text="This applies to your Windows account only, and it does not start Roblox: that is the setting below. Unchecking this undoes it completely." />
                            </StackPanel>

                            <!-- Row separation inside a card is a margin at the call site, matching
                                 how the button styles leave padding and margin to the caller. A
                                 keyed "row" style would be the second primitive this structure
                                 exists to avoid. -->
                            <StackPanel Margin="0,14,0,0">
                                <CheckBox x:Name="LaunchMainToggle"
                                          Foreground="{DynamicResource WhiteBrush}"
                                          FontSize="{DynamicResource HeadingFontSize}"
                                          FontWeight="SemiBold"
                                          Click="OnLaunchMainToggle">
                                    <TextBlock Text="Launch your main account when RoRoRo starts." />
                                </CheckBox>
                                <TextBlock x:Name="LaunchMainHint"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,0"
                                           Text="Pair with the toggle above for a one-step boot-to-Roblox setup. Pick a main account in the row list (the &#x2606; star) first." />
                            </StackPanel>

                            <!-- Careful mode, mirrored (F-020, spec 3.2). The only way to change
                                 how a squad launch behaves used to be to begin one: the toggle
                                 lived solely in the Squad Launch modal. This is a MIRROR, not a
                                 move — the modal keeps its copy, because that is where the setting
                                 is most often wanted. Both surfaces read
                                 IAppSettings.GetCarefulSquadLaunchAsync on open and neither caches,
                                 so flipping it in one is what the other shows next time it opens.

                                 It is a ROW here and not a card of its own: this page's two
                                 single-control cards collapsed into one card with two rows when the
                                 heading became the grouping level, and a third card would
                                 reintroduce the exact shape that collapse removed. Startup already holds
                                 "Launch your main account when RoRoRo starts", which is a launch
                                 setting rather than a startup one, so this is the third member of a
                                 set the page already has. The nav item is NOT renamed for it —
                                 docs/ui-routes.json declares these pages as capture surfaces. -->
                            <StackPanel Margin="0,14,0,0">
                                <CheckBox x:Name="CarefulSquadLaunchToggle"
                                          Foreground="{DynamicResource WhiteBrush}"
                                          FontSize="{DynamicResource HeadingFontSize}"
                                          FontWeight="SemiBold"
                                          AutomationProperties.Name="Launch a squad one account at a time"
                                          Click="OnCarefulSquadLaunchToggle">
                                    <TextBlock Text="Launch a squad one account at a time." TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,0"
                                           Text="Each account finishes landing in the game before the next one starts. It takes longer, but no two accounts are ever joining at once, which is what sets off Roblox's verification prompts. You can also flip this in the Squad Launch window." />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageAccounts" Visibility="Collapsed">
                    <!-- Two settings, one section: both change what RoRoRo puts on an account row.
                         They were two single-control cards, which is the shape that made a card
                         holding one control weigh the same as the ten-control Alerts card. -->
                    <TextBlock Text="What RoRoRo shows"
                               Style="{StaticResource SectionHeadingStyle}"
                               AutomationProperties.Name="What RoRoRo shows"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <!-- Streamer mode. Moved off the main window 2026-08-04 (audit finding F-008): a
                                 setting occupied a full band of the dashboard and printed its own tooltip a
                                 second time as body copy. Rendered as a CheckBox rather than the ui:ToggleSwitch
                                 it was, to match the six settings already on this page — the ToggleSwitch was
                                 the app's only one. The tray checkbox stays; the two are views of one source of
                                 truth (IStreamerIdentityProvider), not two flags. -->
                            <StackPanel>
                                <CheckBox x:Name="StreamerModeToggle"
                                          Foreground="{DynamicResource WhiteBrush}"
                                          FontSize="{DynamicResource HeadingFontSize}"
                                          FontWeight="SemiBold">
                                    <TextBlock Text="Streamer mode." />
                                </CheckBox>
                                <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,8"
                                           Text="Hides names, avatars, and share links inside RoRoRo. It does not change anything Roblox itself shows — your stream still shows whatever is on screen in the game." />
                                <Button x:Name="RerollAllButton"
                                        Content="Reroll all identities"
                                        Click="OnRerollAllClick"
                                        HorizontalAlignment="Left"
                                        Margin="22,0,0,0"
                                        Padding="10,6"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontSize="{DynamicResource BodyFontSize}"
                                        ToolTip="Assign every fake name and avatar a fresh pick." />
                            </StackPanel>

                            <!-- v1.14 — Recycle now rejoins the exact server an account is in, so it earns a
                                 place outside the memory-warning state. Off by default; same row shape. -->
                            <StackPanel Margin="0,14,0,0">
                                <CheckBox x:Name="AlwaysShowRecycleToggle"
                                          Foreground="{DynamicResource WhiteBrush}"
                                          FontSize="{DynamicResource HeadingFontSize}"
                                          FontWeight="SemiBold"
                                          Click="OnAlwaysShowRecycleToggle">
                                    <TextBlock Text="Always show Recycle on running accounts." TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,0"
                                           Text="Recycle closes a client and puts it straight back into the server it was in — useful for a client that's gone sideways, not just one eating memory. Off, it appears only when RoRoRo warns about that account's memory." />
                            </StackPanel>

                            <!-- F-111 / F-109. Stop now asks the client to close the way its own X does,
                                 then waits ten seconds before forcing. An in-game Roblox answers by
                                 raising its own confirm INSIDE the game, which RoRoRo cannot see or
                                 click. Only that clean exit persists Roblox's settings, so waiting is
                                 the default and skipping it is the opt-in. -->
                            <StackPanel Margin="0,14,0,0">
                                <CheckBox x:Name="AutoForceStopToggle"
                                          Foreground="{DynamicResource WhiteBrush}"
                                          FontSize="{DynamicResource HeadingFontSize}"
                                          FontWeight="SemiBold"
                                          Click="OnAutoForceStopToggle">
                                    <TextBlock Text="Stop clients immediately, without waiting." TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,0"
                                           Text="Normally Stop gives Roblox ten seconds to close itself, counting down on the row, because Roblox asks you to confirm inside the game and only a clean exit saves your Roblox settings — window size, fullscreen, graphics quality. Turn this on and Stop closes the client at once, and those settings go back to whatever was last saved." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Accounts — move accounts to another PC (v1.6.0 account transport). The
                         heading was hand-rolled at 13px SemiBold White INSIDE this card; it is the
                         same declaration the shared style makes, so it moved out and became the
                         style. Text unchanged deliberately — this item is structure, not copy. -->
                    <TextBlock Text="Accounts"
                               Style="{StaticResource SectionHeadingStyle}"
                               AutomationProperties.Name="Accounts"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"
                                       Text="Move your saved accounts to another PC. Export writes a passphrase-encrypted file; import merges it in without touching accounts already on this machine." />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Export accounts…" Padding="14,8" Margin="0,0,8,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        FontSize="{DynamicResource BodyFontSize}"
                                        Click="OnExportAccountsClick"
                                        ToolTip="Save your accounts to an encrypted file you can move to another PC." />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Import accounts…" Padding="14,8"
                                        FontSize="{DynamicResource BodyFontSize}"
                                        Click="OnImportAccountsClick"
                                        ToolTip="Add accounts from an encrypted .rororo-accounts file." />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageAlerts" Visibility="Collapsed">
                    <!-- v1.8 idle awareness — mute toggle + warn-threshold preset, mirroring the
                         LaunchMainToggle block above exactly (same CheckBox shape, same hint pattern). -->
                    <TextBlock Text="Idle accounts"
                               Style="{StaticResource SectionHeadingStyle}"
                               AutomationProperties.Name="Idle accounts"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <CheckBox x:Name="MuteIdleAlertsToggle"
                                      Foreground="{DynamicResource WhiteBrush}"
                                      FontSize="{DynamicResource HeadingFontSize}"
                                      FontWeight="SemiBold"
                                      Click="OnMuteIdleAlertsToggle">
                                <TextBlock Text="Mute idle alerts." />
                            </CheckBox>
                            <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="22,4,0,8"
                                       Text="RoRoRo shows one tray toast when a running account crosses the idle threshold below. Checking this keeps the row chip but skips the toast." />
                            <TextBlock Text="Idle warn threshold"
                                       FontSize="{DynamicResource BodyFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WhiteBrush}"
                                       Margin="22,0,0,4" />
                            <ComboBox x:Name="IdleWarnThresholdPicker" AutomationProperties.Name="Idle warn threshold"
                                      Margin="22,0,0,0"
                                      Width="160"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="OnIdleWarnThresholdChanged"
                                      Padding="8,6"
                                      FontSize="{DynamicResource BodyFontSize}">
                                <ComboBoxItem Content="10 minutes" Tag="10" />
                                <ComboBoxItem Content="12 minutes" Tag="12" />
                                <ComboBoxItem Content="15 minutes" Tag="15" />
                                <ComboBoxItem Content="18 minutes" Tag="18" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Alerts (plan 2026-08-03, Task 7). The only wall in this feature is the webhook,
                         and it starts one step earlier than a paste field: "Server Settings ->
                         Integrations" assumes you own a server, and plenty of clan members have only
                         ever joined one. Hence the walkthrough button. Desktop alerts need no setup at
                         all, but the status line never pretends they are the point — you can already
                         see a dead client if you are sitting at the PC. -->
                    <TextBlock Text="Alerts"
                               Style="{StaticResource SectionHeadingStyle}"
                               AutomationProperties.Name="Alerts"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="0,0,0,10"
                                       Text="Get told when something happens to an account while you're away from the PC. Sending to a Discord channel takes about a minute to set up — there's a walkthrough below if you've never made a webhook." />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="An account drops out" FontSize="{DynamicResource BodyFontSize}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource WhiteBrush}" Width="180" />
                                <ComboBox Grid.Column="1" x:Name="DroppedOutDestination" AutomationProperties.Name="Where to send the alert when an account drops out" Width="170" HorizontalAlignment="Left"
                                          SelectionChanged="OnAlertRoutingChanged">
                                    <ComboBoxItem Content="Off" Tag="None" />
                                    <ComboBoxItem Content="Desktop only" Tag="Local" />
                                    <ComboBoxItem Content="My channel" Tag="Mine" />
                                    <ComboBoxItem Content="Clan channel" Tag="Clan" />
                                    <ComboBoxItem Content="My phone" Tag="Phone" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="An account eats memory" FontSize="{DynamicResource BodyFontSize}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource WhiteBrush}" Width="180" />
                                <ComboBox Grid.Column="1" x:Name="MemoryWarningDestination" AutomationProperties.Name="Where to send the alert when an account eats memory" Width="170" HorizontalAlignment="Left"
                                          SelectionChanged="OnAlertRoutingChanged">
                                    <ComboBoxItem Content="Off" Tag="None" />
                                    <ComboBoxItem Content="Desktop only" Tag="Local" />
                                    <ComboBoxItem Content="My channel" Tag="Mine" />
                                    <ComboBoxItem Content="Clan channel" Tag="Clan" />
                                    <ComboBoxItem Content="My phone" Tag="Phone" />
                                </ComboBox>
                            </Grid>

                            <!-- Muted accounts (F-024, spec 4.3). Muting is per-account and lives on
                                 the row context menu; this page owned every OTHER alert decision and
                                 said nothing about that one. Somebody who muted an account three
                                 weeks ago could not find out from the app that they had.

                                 It sits directly under the two routing rows because it is the
                                 exception to them: here is where alerts go, and here is who is
                                 exempt. See MutedAccountsSummary for why the count reads the ROWS
                                 rather than the persisted id list.

                                 ZERO RENDERS AS ABSENCE (prd Story 1.3). Collapsed by default and
                                 restored to Collapsed by RefreshMutedAccounts — not a stray "0", not
                                 an empty row. Collapsed rather than Hidden so no gap is left where
                                 the block would have been, same as ThemeDescriptionText on the
                                 Appearance page.

                                 Unmute all takes the ORDINARY secondary treatment, deliberately. It
                                 is destructive-adjacent and it is not on the destructive list, which
                                 names exactly three sites — Remove, Clear and Stop all — and treats
                                 a fourth as the signal to drop that work rather than widen it. -->
                            <StackPanel x:Name="MutedAccountsRow" Margin="0,4,0,6" Visibility="Collapsed">
                                <TextBlock x:Name="MutedAccountsLine"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="Muted accounts" />
                                <Button x:Name="UnmuteAllButton"
                                        Content="Unmute all"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0"
                                        Padding="10,5"
                                        FontSize="{DynamicResource BodyFontSize}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.Name="Unmute every muted account"
                                        Click="OnUnmuteAllClick"
                                        ToolTip="Turn alerts back on for every account you muted." />
                            </StackPanel>

                            <!-- Two separate webhooks, because they are two different audiences. "My
                                 channel" is a server you own and nobody else reads; "Clan channel" is a
                                 shared room. Keeping them apart is what lets someone send health noise
                                 to themselves and only the interesting things to the clan — and it is
                                 why the payload type has no field a private-server link could live in
                                 (see WebhookPayload). One shared field would collapse that choice. -->
                            <TextBlock Text="My channel — webhook URL" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WhiteBrush}" Margin="0,10,0,2" />
                            <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="0,0,0,4"
                                       Text="A server only you read. Saved encrypted on this PC and never leaves it except to post your alerts." />
                            <!-- F-076. The saved value renders masked and read-only; Show reveals it
                                 AND makes it editable, so revealing is a deliberate act and nobody
                                 can blind-edit a credential they cannot see. A webhook URL is a
                                 bearer token — this app has a streamer mode, and the field used to
                                 sit at full contrast where a stream or a screen-share picks it up. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MineWebhookInput" AutomationProperties.Name="My channel webhook URL" Grid.Column="0" Padding="8,6" FontSize="{DynamicResource BodyFontSize}"
                                         Background="{DynamicResource NavyBrush}"
                                         LostFocus="OnWebhookCommitted" Style="{StaticResource AppTextBoxStyle}"/>
                                <!-- Takes the rank rather than repeating it. The four attributes
                                     removed here were byte-identical to SecondaryToggleButtonStyle's
                                     setters, so nothing moves at rest; what changes is the TEMPLATE,
                                     which they were not getting. A ToggleButton with no rank inherits
                                     the OS template and its hardcoded #BEE6FD hover, so both Show
                                     buttons on this page still flashed Aero blue after the rest of
                                     the app stopped. Found by item 9's fence, which counts
                                     ToggleButton because the C2 gap proved a control type outside
                                     the definition is where this defect survives. -->
                                <ToggleButton x:Name="MineWebhookReveal" Grid.Column="1" Content="Show"
                                              Margin="6,0,0,0" Padding="10,5" FontSize="{DynamicResource BodyFontSize}"
                                              Checked="OnRevealWebhookToggled" Unchecked="OnRevealWebhookToggled"
                                              Style="{StaticResource SecondaryToggleButtonStyle}"
                                              ToolTip="Reveal the saved webhook so you can read or replace it." />
                            </Grid>
                            <TextBlock x:Name="MineWebhookVerdict" FontSize="{DynamicResource BodyFontSize}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <TextBlock Text="Clan channel — webhook URL" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WhiteBrush}" Margin="0,12,0,2" />
                            <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="0,0,0,4"
                                       Text="A shared room. Anything routed here is read by everyone in that channel, now and later — so send what the clan should see, not everything." />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ClanWebhookInput" AutomationProperties.Name="Clan channel webhook URL" Grid.Column="0" Padding="8,6" FontSize="{DynamicResource BodyFontSize}"
                                         Background="{DynamicResource NavyBrush}"
                                         LostFocus="OnWebhookCommitted" Style="{StaticResource AppTextBoxStyle}"/>
                                <ToggleButton x:Name="ClanWebhookReveal" Grid.Column="1" Content="Show"
                                              Margin="6,0,0,0" Padding="10,5" FontSize="{DynamicResource BodyFontSize}"
                                              Checked="OnRevealWebhookToggled" Unchecked="OnRevealWebhookToggled"
                                              Style="{StaticResource SecondaryToggleButtonStyle}"
                                              ToolTip="Reveal the saved webhook so you can read or replace it." />
                            </Grid>
                            <TextBlock x:Name="ClanWebhookVerdict" FontSize="{DynamicResource BodyFontSize}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <!-- Phone push (spec 2026-09-04). Same card because it answers the same
                                 question as the rows above - where do alerts go - but a separate
                                 mechanism on purpose: the Discord webhook stays its own piece
                                 (Este's ruling, decisions.md 2026-09-04). Pushover is the app most
                                 of the clan already carries; ntfy is the free option. Every field
                                 here is a bearer credential and takes the F-076 masked/reveal
                                 treatment wholesale. -->
                            <TextBlock Text="My phone — push service" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WhiteBrush}" Margin="0,12,0,2" />
                            <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="0,0,0,4"
                                       Text="Buzzes your phone directly — no Discord needed. Pushover is the app most of the clan already uses; ntfy is free. Route an alert to My phone above, set the service up once here." />
                            <ComboBox x:Name="PhoneProviderPicker" AutomationProperties.Name="Which push service sends phone alerts" Width="170" HorizontalAlignment="Left"
                                      SelectionChanged="OnPhoneProviderChanged">
                                <ComboBoxItem Content="Off" Tag="None" />
                                <ComboBoxItem Content="Pushover" Tag="Pushover" />
                                <ComboBoxItem Content="ntfy" Tag="Ntfy" />
                            </ComboBox>

                            <StackPanel x:Name="PushoverFields" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                           Margin="0,0,0,4"
                                           Text="Both codes come from pushover.net: your user key is on the dashboard, and creating an application there (name it anything) gives you its token. The phone app is a one-time purchase after the trial." />
                                <TextBlock Text="User key" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,0,0,2" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PushoverUserKeyInput" AutomationProperties.Name="Pushover user key" Grid.Column="0" Padding="8,6" FontSize="{DynamicResource BodyFontSize}"
                                             Background="{DynamicResource NavyBrush}"
                                             LostFocus="OnPushoverKeyCommitted" Style="{StaticResource AppTextBoxStyle}"/>
                                    <ToggleButton x:Name="PushoverUserKeyReveal" Grid.Column="1" Content="Show"
                                                  Margin="6,0,0,0" Padding="10,5" FontSize="{DynamicResource BodyFontSize}"
                                                  Checked="OnRevealPhoneToggled" Unchecked="OnRevealPhoneToggled"
                                                  Style="{StaticResource SecondaryToggleButtonStyle}"
                                                  ToolTip="Reveal the saved key so you can read or replace it." />
                                </Grid>
                                <TextBlock Text="Application token" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,6,0,2" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PushoverAppTokenInput" AutomationProperties.Name="Pushover application token" Grid.Column="0" Padding="8,6" FontSize="{DynamicResource BodyFontSize}"
                                             Background="{DynamicResource NavyBrush}"
                                             LostFocus="OnPushoverKeyCommitted" Style="{StaticResource AppTextBoxStyle}"/>
                                    <ToggleButton x:Name="PushoverAppTokenReveal" Grid.Column="1" Content="Show"
                                                  Margin="6,0,0,0" Padding="10,5" FontSize="{DynamicResource BodyFontSize}"
                                                  Checked="OnRevealPhoneToggled" Unchecked="OnRevealPhoneToggled"
                                                  Style="{StaticResource SecondaryToggleButtonStyle}"
                                                  ToolTip="Reveal the saved token so you can read or replace it." />
                                </Grid>
                                <TextBlock x:Name="PhonePushoverVerdict" FontSize="{DynamicResource BodyFontSize}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>

                            <StackPanel x:Name="NtfyFields" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                           Margin="0,0,0,4"
                                           Text="Free, no account: install the ntfy app, subscribe to your topic below, done. The topic is a secret — anyone holding it can read and fake your alerts, which is why RoRoRo makes it long and random. On iPhone, delivery is best-effort; Pushover is the reliable choice there." />
                                <TextBlock Text="Topic" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,0,0,2" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NtfyTopicInput" AutomationProperties.Name="ntfy topic" Grid.Column="0" Padding="8,6" FontSize="{DynamicResource BodyFontSize}"
                                             Background="{DynamicResource NavyBrush}" IsReadOnly="True"
                                             Style="{StaticResource AppTextBoxStyle}"/>
                                    <ToggleButton x:Name="NtfyTopicReveal" Grid.Column="1" Content="Show"
                                                  Margin="6,0,0,0" Padding="10,5" FontSize="{DynamicResource BodyFontSize}"
                                                  Checked="OnRevealPhoneToggled" Unchecked="OnRevealPhoneToggled"
                                                  Style="{StaticResource SecondaryToggleButtonStyle}"
                                                  ToolTip="Reveal the topic so you can subscribe to it on your phone." />
                                    <Button x:Name="NtfyNewTopicButton" Grid.Column="2" Content="New topic"
                                            Margin="6,0,0,0" Padding="10,5" FontSize="{DynamicResource BodyFontSize}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            AutomationProperties.Name="Generate a new ntfy topic"
                                            Click="OnGenerateNtfyTopicClick"
                                            ToolTip="Makes a fresh random topic. Your phone stops getting alerts until you subscribe to the new one." />
                                </Grid>
                                <TextBlock Text="Server" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,6,0,2" />
                                <TextBox x:Name="NtfyServerInput" AutomationProperties.Name="ntfy server address" Padding="8,6" FontSize="{DynamicResource BodyFontSize}"
                                         Background="{DynamicResource NavyBrush}"
                                         LostFocus="OnNtfyServerCommitted" Style="{StaticResource AppTextBoxStyle}"
                                         ToolTip="Leave as ntfy.sh unless you run your own server." />
                                <TextBlock x:Name="PhoneNtfyVerdict" FontSize="{DynamicResource BodyFontSize}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>

                            <Button x:Name="PhoneTestButton" Content="Test my phone" Padding="12,5" Margin="0,8,0,0"
                                    HorizontalAlignment="Left" Visibility="Collapsed"
                                    Style="{StaticResource SecondaryStrongButtonStyle}" FontSize="{DynamicResource BodyFontSize}"
                                    AutomationProperties.Name="Send a test notification to my phone"
                                    Click="OnPhoneTestClick" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource AccentActionButtonStyle}" x:Name="SendTestButton" Content="Send test" Padding="12,5" Click="OnSendTestClick" FontSize="{DynamicResource BodyFontSize}" />
                                <Button x:Name="NoServerHelpButton" Content="I don't have a Discord server" Padding="12,5" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryStrongButtonStyle}" FontSize="{DynamicResource BodyFontSize}"
                                        Click="OnNoServerHelpClick" />
                            </StackPanel>

                            <!-- F-094. Every arm of this line used to be CyanBrush — the accent, which
                                 is the treatment a SUCCESS gets — so "your webhook was deleted, so
                                 nothing is reaching your phone" rendered identically to "sending to
                                 #alerts". The sentence said one thing and the styling said another,
                                 and styling is what gets read first.

                                 The failure arms take RowExpiredAccentBrush and the "▲ " prefix, which
                                 is the pair MainWindow already uses for the compat and Bloxstrap
                                 banners. Driven from a Tag rather than assigned in code-behind so the
                                 colour stays visible to the theme gates — code-behind colour
                                 assignment is exactly the blind spot F-098 records. -->
                            <TextBlock x:Name="AlertsStatusLine" FontSize="{DynamicResource BodyFontSize}" Margin="0,10,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource CyanBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="Tag" Value="failure">
                                                <Setter Property="Foreground" Value="{DynamicResource RowExpiredAccentBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Memory (F-023, spec 4.1). These four have been persisted since v1.13 and
                         referenced by zero .xaml until now: a page named "Alerts & memory" shipped
                         with no memory controls on it, and the only way to change one was Notepad.
                         SettingsReachabilityTests is the fence that makes that shape fail a build.

                         WHY FREE TEXT AND NOT A PRESET PICKER, since the idle threshold two cards
                         up is a ComboBox. A picker cannot produce an out-of-range value, so it
                         cannot satisfy prd Story 1.1's requirement that one be refused VISIBLY —
                         the criterion would be unfalsifiable by construction. Free text is what
                         gives the refusal something to refuse. It is also what "hand-editing
                         settings.json still works" already implies: the file accepts any integer,
                         so the UI has to be able to show any integer and reject the wrong ones.

                         Blank is not empty, it is "RoRoRo picks". SettingsBlob.MemoryReserveMb and
                         SettingsBlob.MemoryCapMb are int? and null means never set — App.xaml.cs
                         derives from installed RAM via MemoryDefaults. An empty box has to
                         round-trip back to null or a user who clears one silently pins whatever
                         happened to be showing.

                         WRITE THOSE TWO NAMES DOTTED, HERE AND IN THE CODE-BEHIND, and do not tidy
                         the owner off. SettingsReachabilityTests' control edge matches a bare
                         setting name anywhere in an App .cs/.xaml file, comments included, and its
                         one exclusion is a preceding "." (a member read is a consumer, not a
                         control). So a bare setting name in a sentence is enough to report that
                         setting reachable; the same name written with its owner is not. Proved on
                         2026-08-10: with all three of the projection setting's sites renamed away,
                         the fence still passed on two doc comments alone. Qualified names keep the
                         fence measuring the controls. -->

                    <TextBlock Text="Memory"
                               Style="{StaticResource SectionHeadingStyle}"
                               AutomationProperties.Name="Memory"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <StackPanel>
                                <CheckBox x:Name="MemoryWatchdogEnabledToggle"
                                          Foreground="{DynamicResource WhiteBrush}"
                                          FontSize="{DynamicResource HeadingFontSize}"
                                          FontWeight="SemiBold"
                                          AutomationProperties.Name="Watch memory while accounts are running"
                                          Click="OnMemoryWatchdogEnabledToggle">
                                    <TextBlock Text="Watch memory while accounts are running." TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,0"
                                           Text="RoRoRo checks every running client every 30 seconds and tells you before your PC runs out. Turn it off and the three settings below stop doing anything. All four take effect the next time RoRoRo starts." />
                            </StackPanel>

                            <!-- WHAT BLANK ACTUALLY PICKS, on this machine, said out loud (item 4a).
                                 The three boxes below accept blank to mean "RoRoRo picks one" and
                                 said nothing about what it picked, which is this cycle's own defect
                                 restated: the app knew and did not say.

                                 The text is set from the code-behind rather than written here,
                                 because the figures are DERIVED and the derivation must be the one
                                 App.WireMemoryWatchdogAsync already runs. See
                                 AutomaticMemorySummary — it calls MemoryDefaults, so a number here
                                 cannot disagree with the number the watchdog uses. A literal in
                                 this markup would be a second source of truth for a value that
                                 changes with the PC it runs on.

                                 Muted prose, not the warning vocabulary, even on the probe-failure
                                 path. A machine whose RAM cannot be read is a standing fact, not an
                                 event, and MemorySettingsWarning below is where a refusal speaks.
                                 Painting a permanent line in the warning accent would shout on
                                 every open and leave the actual refusal nothing louder to be. -->
                            <TextBlock x:Name="AutomaticMemoryLine"
                                       FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,0"
                                       AutomationProperties.Name="What RoRoRo picks when a box is left blank" />

                            <!-- Row separation is a call-site margin, same as the Startup card. -->
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="Memory to keep free (MB)"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WhiteBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox x:Name="MemoryReserveMbInput"
                                         Width="120"
                                         HorizontalAlignment="Left"
                                         Padding="8,6"
                                         FontSize="{DynamicResource BodyFontSize}"
                                         Background="{DynamicResource NavyBrush}"
                                         Style="{StaticResource AppTextBoxStyle}"
                                         AutomationProperties.Name="Memory to keep free, in megabytes"
                                         AutomationProperties.HelpText="A whole number from 256 to 65536, or blank to let RoRoRo pick."
                                         LostFocus="OnMemoryReserveCommitted" />
                                <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="You get warned once free memory drops under this. 256 to 65536. Leave it blank and RoRoRo works one out from your installed RAM." />
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="Warn when one account passes (MB)"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WhiteBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox x:Name="MemoryCapMbInput"
                                         Width="120"
                                         HorizontalAlignment="Left"
                                         Padding="8,6"
                                         FontSize="{DynamicResource BodyFontSize}"
                                         Background="{DynamicResource NavyBrush}"
                                         Style="{StaticResource AppTextBoxStyle}"
                                         AutomationProperties.Name="Warn when one account passes this many megabytes"
                                         AutomationProperties.HelpText="A whole number from 256 to 65536, 0 to turn this warning off, or blank to let RoRoRo pick."
                                         LostFocus="OnMemoryCapCommitted" />
                                <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="One client on its own, not the whole PC. A healthy Pet Sim client sits near 2650 MB. 256 to 65536, or 0 to turn this warning off. Leave it blank and RoRoRo works one out." />
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="Warn this far ahead (minutes)"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WhiteBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox x:Name="ProjectionWarnMinutesInput"
                                         Width="120"
                                         HorizontalAlignment="Left"
                                         Padding="8,6"
                                         FontSize="{DynamicResource BodyFontSize}"
                                         Background="{DynamicResource NavyBrush}"
                                         Style="{StaticResource AppTextBoxStyle}"
                                         AutomationProperties.Name="Warn this many minutes ahead of running out"
                                         AutomationProperties.HelpText="A whole number of minutes from 1 to 1440. The default is 120."
                                         LostFocus="OnProjectionWarnCommitted" />
                                <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="RoRoRo watches how fast your clients are growing and warns you this long before they would fill the PC. 1 to 1440. The default is 120." />
                            </StackPanel>

                            <!-- This section's OWN failure line, and the three reasons it is its
                                 own (spec 5). It is not AlertsStatusLine: that line is CyanBrush,
                                 belongs to the Alerts card above, and spec 5 explicitly leaves it
                                 alone. It is not the Theme section's line: that one does not exist
                                 yet and reports a different thing.

                                 RowExpiredAccentBrush and the U+25B2 prefix are the warning
                                 vocabulary v1.17 established across expired rows, idle chips,
                                 memory chips and the compat banner. A fifth warning surface speaks
                                 it. Cyan is the accent — the same treatment a SUCCESS would get —
                                 so a refusal painted cyan would look like a save.

                                 Collapsed until something is refused. A status line that speaks on
                                 every save is noise, and the refusal has to arrive as a change. -->
                            <TextBlock x:Name="MemorySettingsWarning"
                                       FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource RowExpiredAccentBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       Visibility="Collapsed"
                                       AutomationProperties.Name="Memory settings warning"
                                       AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageDiscord" Visibility="Collapsed">
                    <!-- v1.14+ Discord presence + Join (plan 2026-08-03). Off by default; the status
                         line reports the live connection state in plain words, never a stack trace. -->
                    <TextBlock Text="Discord presence"
                               Style="{StaticResource SectionHeadingStyle}"
                               AutomationProperties.Name="Discord presence"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <CheckBox x:Name="DiscordPresenceToggle"
                                      Foreground="{DynamicResource WhiteBrush}" FontSize="{DynamicResource HeadingFontSize}" FontWeight="SemiBold"
                                      Click="OnDiscordPresenceToggle">
                                <TextBlock Text="Show what you're playing on Discord." TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="22,4,0,8"
                                       Text="Your Discord status shows the game, how many accounts you have in it, and how long you've been going. Nothing to set up — it uses the Discord app already on this PC." />
                            <!-- Said here because otherwise every user who turns this on asks a friend
                                 "do you see it?", gets no, and files a bug. Discord gives the profile
                                 "playing" slot to a game it detects, and RoRoRo is an application, not
                                 a detected game — nothing we can toggle. Detection is earned by
                                 installs over time, so the last line is a real path, not a consolation. -->
                            <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="22,0,0,8"
                                       Text="Worth knowing: while Roblox is running, your friends see Roblox on your profile instead of RoRoRo — Discord gives that spot to games it recognizes. You'll always see your own card. RoRoRo gets recognized once enough people are running it." />
                            <CheckBox x:Name="DiscordJoinToggle"
                                      Foreground="{DynamicResource WhiteBrush}" FontSize="{DynamicResource BodyFontSize}"
                                      Margin="22,0,0,0" Click="OnDiscordJoinToggle">
                                <TextBlock Text="Let friends join your server from Discord." TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock x:Name="DiscordStatusLine" FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource CyanBrush}" TextWrapping="Wrap" Margin="22,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                    <TextBlock Text="Theme"
                               Style="{StaticResource SectionHeadingStyle}"
                               AutomationProperties.Name="Theme"
                               AutomationProperties.HeadingLevel="Level2" />
                    <!-- Only card on its page, so no bottom margin — the one place the shared
                         spacing is wrong rather than the one place someone forgot it. -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"
                                       Text="Pick a built-in or drop your own JSON in the themes folder. The main window updates immediately; secondary dialogs (this one, Diagnostics, About) adopt the theme on next open." />
                            <ComboBox x:Name="ThemePicker" AutomationProperties.Name="Theme"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="OnThemeChanged"
                                      Padding="8,6"
                                      FontSize="{DynamicResource BodyFontSize}" />
                            <!-- One sentence per built-in, keyed by id via ThemeDescriptions.For.
                                 User themes return null: Collapsed, not Hidden, so no empty gap
                                 is left where the line would have been. -->
                            <TextBlock x:Name="ThemeDescriptionText"
                                       FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource AccentActionButtonStyle}" x:Name="BuildThemeButton"
                                        Content="+ Build a theme..."
                                        HorizontalAlignment="Left"
                                        Padding="10,5" Margin="0,0,8,0"
                                        FontSize="{DynamicResource BodyFontSize}"
                                        Click="OnBuildThemeClick"
                                        ToolTip="Open the theme builder. Copy an AI prompt, paste the result back, save." />
                                <Button x:Name="OpenThemesFolderButton"
                                        Content="Open themes folder"
                                        HorizontalAlignment="Left"
                                        Padding="10,5"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontSize="{DynamicResource BodyFontSize}"
                                        Click="OnOpenThemesFolderClick"
                                        ToolTip="Drop a *.json file in here, then close and reopen Settings to see it in the picker." />
                                <!-- The way back to the outline question (F-078, spec 4.3). It used
                                     to be asked once per theme and never again: EdgeRemediationWindow
                                     says so in its own source — "one reflexive click on the title-bar
                                     X must not permanently opt somebody's theme out of the fix
                                     without them reading a word of it — there is no re-ask affordance
                                     anywhere." This is that affordance.

                                     It stands on its own rather than reading "ask me again", because
                                     prd Story 1.4 requires it to be discoverable WITHOUT knowing the
                                     prompt ever happened. "Again" is a word only somebody who saw the
                                     first one can parse.

                                     It puts the same question through the same dialog and records
                                     the answer through the same setter — see OnReviewEdgeClick. -->
                                <Button x:Name="ReviewEdgeButton"
                                        Content="Review button outlines"
                                        HorizontalAlignment="Left"
                                        Padding="10,5" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontSize="{DynamicResource BodyFontSize}"
                                        AutomationProperties.Name="Review button outlines on this theme"
                                        Click="OnReviewEdgeClick"
                                        ToolTip="See both versions of this theme's button outlines and pick the one it uses." />
                            </StackPanel>
                            <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Text="Themes people write themselves sometimes set button outlines too faint to see, so RoRoRo brightens those. Review button outlines puts both side by side and lets you pick. You can change your mind as often as you like." />
                            <!-- This section's own failure line (spec 5), sibling to
                                 AlertsStatusLine and deliberately NOT dressed like it.
                                 AlertsStatusLine is CyanBrush, which is the accent — the same
                                 treatment a success gets — so a failure painted cyan would look
                                 like a save. RowExpiredAccentBrush and the U+25B2 prefix are the
                                 warning vocabulary v1.17 established across expired rows, idle
                                 chips, memory chips and the compat banner, and item 3's
                                 MemorySettingsWarning already speaks it. AlertsStatusLine itself is
                                 left alone; spec 10 records it as an open issue.

                                 Two things reach it: a theme that applied but could not be written
                                 down, and a file in the themes folder that could not be read. The
                                 text is composed by ThemeStatusSummary, which is where the copy is
                                 tested — nothing here decides what it says.

                                 Collapsed until there is something wrong. Success stays silent. -->
                            <TextBlock x:Name="ThemeStatusLine"
                                       FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource RowExpiredAccentBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       Visibility="Collapsed"
                                       AutomationProperties.Name="Theme warning"
                                       AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
