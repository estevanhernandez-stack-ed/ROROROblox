                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PushoverAppTokenInput" AutomationProperties.Name="{loc:Loc SettingsPage_PushoverApplicationToken}" Grid.Column="0" Padding="8,6" FontSize="{DynamicResource BodyFontSize}"
                                             Background="{DynamicResource NavyBrush}"
                                             LostFocus="OnPushoverKeyCommitted" Style="{StaticResource AppTextBoxStyle}"/>
                                    <ToggleButton x:Name="PushoverAppTokenReveal" Grid.Column="1" Content="{loc:Loc SettingsPage_Show}"
                                                  AutomationProperties.Name="{loc:Loc SettingsPage_ShowOrHideTheSaved_2}"
                                                  Margin="6,0,0,0" Padding="10,5" FontSize="{DynamicResource BodyFontSize}"
                                                  Checked="OnRevealPhoneToggled" Unchecked="OnRevealPhoneToggled"
                                                  Style="{StaticResource SecondaryToggleButtonStyle}"
                                                  ToolTip="{loc:Loc SettingsPage_RevealTheSavedTokenSo}" />
                                </Grid>
                                <TextBlock x:Name="PhonePushoverVerdict" FontSize="{DynamicResource BodyFontSize}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>

                            <StackPanel x:Name="NtfyFields" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                           Margin="0,0,0,4"
                                           Text="{loc:Loc SettingsPage_1GetTheFreeNtfy}" />
                                <TextBlock Text="{loc:Loc SettingsPage_Topic}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,0,0,2" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NtfyTopicInput" AutomationProperties.Name="{loc:Loc SettingsPage_NtfyTopic}" Grid.Column="0" Padding="8,6" FontSize="{DynamicResource BodyFontSize}"
                                             Background="{DynamicResource NavyBrush}" IsReadOnly="True"
                                             Style="{StaticResource AppTextBoxStyle}"/>
                                    <ToggleButton x:Name="NtfyTopicReveal" Grid.Column="1" Content="{loc:Loc SettingsPage_Show}"
                                                  AutomationProperties.Name="{loc:Loc SettingsPage_ShowOrHideTheNtfy}"
                                                  Margin="6,0,0,0" Padding="10,5" FontSize="{DynamicResource BodyFontSize}"
                                                  Checked="OnRevealPhoneToggled" Unchecked="OnRevealPhoneToggled"
