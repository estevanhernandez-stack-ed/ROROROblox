<UserControl x:Class="ROROROblox.App.Preferences.SettingsPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:ROROROblox.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ROROROblox.App.Controls">

    <UserControl.Resources>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <controls:PageHeader Heading="{loc:Loc SettingsPage_Settings}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="164" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="SettingsNav" Grid.Column="0"
                     Background="Transparent"
                     BorderThickness="0"
                     FontSize="{DynamicResource HeadingFontSize}"
                     ItemContainerStyle="{StaticResource NavItemStyle}"
                     SelectionChanged="OnNavSelectionChanged">
                    <ListBoxItem Content="{loc:Loc SettingsPage_Startup}"
                                AutomationProperties.AutomationId="NavStartup" />
                    <ListBoxItem Content="{loc:Loc SettingsPage_Accounts}"
                                AutomationProperties.AutomationId="NavAccounts" />
                    <ListBoxItem Content="{loc:Loc SettingsPage_AlertsMemory}"
                                AutomationProperties.AutomationId="NavAlerts" />
                    <ListBoxItem Content="{loc:Loc SettingsPage_Discord}"
                                AutomationProperties.AutomationId="NavDiscord" />
                    <ListBoxItem Content="{loc:Loc SettingsPage_Appearance}"
                                AutomationProperties.AutomationId="NavAppearance" />
            </ListBox>

            <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                <Grid>
                <!-- HOW EVERY PAGE BELOW IS GROUPED (F-026, spec 3.1). A section is a
                     SectionHeadingStyle heading standing OUTSIDE the cards; a setting is a row
                     INSIDE one. Before this, every setting wore its own card, so a card holding one
                     control and the ten-control Alerts card carried identical weight — "card" meant
                     both "group" and "setting", which is the two-meanings defect the row is about.

                     The heading is the level that was missing, and the shared style already had it:
                     Margin="0,18,0,6" puts 18px above and 6px below, which places a heading BETWEEN
                     cards rather than inside one. Cards holding a single control collapsed into the
                     section they belong to instead of each wearing full chrome.

                     DO NOT answer a future grouping need with a second container rank — a
                     SubCardBorderStyle, a GroupBox, an Expander. Another container restates the
                     defect this structure removes.

                     WHY THE HEADING AND NOT THE FILL, measured 2026-08-10 on the shipped built-ins.
                     RowBg against Bg — the card's entire separation from the page — is 1.09:1 in
                     brand, 1.08:1 in midnight, 1.08:1 in magenta-heat and 1.33:1 in flatline. The
                     fill was never carrying the group anywhere; it is under 3:1 in all four, and
                     flatline (the theme the last cycle shipped, and the one this was expected to
                     fail on) is in fact the STRONGEST of the four, not the weakest. So grouping is
                     carried by the heading's weight and its 18/6 rhythm, which is achromatic and
                     survives with colour removed. Do not reintroduce a hierarchy that reads only in
                     hue. Note the register's older "flatline collapses RowBg into Bg" figure belongs
                     to the adversarial fixture in FlatlineLabGateTests, not to the flatline theme in
                     ThemeStore — MutedTextFenceTests carries the same correction for the prose
                     token. (Do not name that fixture here: its own gate fences the name out of
                     shipped source, and this comment tripped it once already.) -->
                <StackPanel x:Name="PageStartup">
                    <TextBlock Text="{loc:Loc SettingsPage_Startup}"
                               Style="{StaticResource SectionHeadingStyle}"
                               AutomationProperties.Name="{loc:Loc SettingsPage_Startup}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <StackPanel>
                                <CheckBox x:Name="RunOnLoginToggle"
                                          Foreground="{DynamicResource WhiteBrush}"
                                          FontSize="{DynamicResource HeadingFontSize}"
                                          FontWeight="SemiBold"
                                          Click="OnRunOnLoginToggle">
                                    <TextBlock Text="{loc:Loc SettingsPage_StartRororoWhenWindowsStarts}" />
                                </CheckBox>
                                <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,0"
                                           Text="{loc:Loc SettingsPage_ThisAppliesToYourWindows}" />
                            </StackPanel>

                            <!-- Row separation inside a card is a margin at the call site, matching
                                 how the button styles leave padding and margin to the caller. A
                                 keyed "row" style would be the second primitive this structure
                                 exists to avoid. -->
                            <StackPanel Margin="0,14,0,0">
                                <CheckBox x:Name="LaunchMainToggle"
                                          Foreground="{DynamicResource WhiteBrush}"
                                          FontSize="{DynamicResource HeadingFontSize}"
                                          FontWeight="SemiBold"
                                          Click="OnLaunchMainToggle">
                                    <TextBlock Text="{loc:Loc SettingsPage_LaunchYourMainAccountWhen}" />
                                </CheckBox>
                                <TextBlock x:Name="LaunchMainHint"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,0"
                                           Text="{loc:Loc SettingsPage_PairWithTheToggleAbove}" />
                            </StackPanel>

                            <!-- Careful mode, mirrored (F-020, spec 3.2). The only way to change
                                 how a squad launch behaves used to be to begin one: the toggle
                                 lived solely in the Squad Launch modal. This is a MIRROR, not a
                                 move — the modal keeps its copy, because that is where the setting
                                 is most often wanted. Both surfaces read
                                 IAppSettings.GetCarefulSquadLaunchAsync on open and neither caches,
                                 so flipping it in one is what the other shows next time it opens.

                                 It is a ROW here and not a card of its own: this page's two
                                 single-control cards collapsed into one card with two rows when the
                                 heading became the grouping level, and a third card would
                                 reintroduce the exact shape that collapse removed. Startup already holds
                                 "Launch your main account when RoRoRo starts", which is a launch
                                 setting rather than a startup one, so this is the third member of a
                                 set the page already has. The nav item is NOT renamed for it —
                                 docs/ui-routes.json declares these pages as capture surfaces. -->
                            <StackPanel Margin="0,14,0,0">
                                <CheckBox x:Name="CarefulSquadLaunchToggle"
                                          Foreground="{DynamicResource WhiteBrush}"
                                          FontSize="{DynamicResource HeadingFontSize}"
                                          FontWeight="SemiBold"
                                          AutomationProperties.Name="{loc:Loc SettingsPage_LaunchASquadOneAccount}"
                                          Click="OnCarefulSquadLaunchToggle">
                                    <TextBlock Text="{loc:Loc SettingsPage_LaunchASquadOneAccount_2}" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,0"
                                           Text="{loc:Loc SettingsPage_EachAccountFinishesLandingIn}" />
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0">
                                <CheckBox x:Name="LaunchWindowedToggle"
                                          Foreground="{DynamicResource WhiteBrush}"
                                          FontSize="{DynamicResource HeadingFontSize}"
                                          FontWeight="SemiBold"
                                          AutomationProperties.Name="{loc:Loc SettingsPage_KeepRobloxWindowed}"
                                          Click="OnLaunchWindowedToggle">
                                    <TextBlock Text="{loc:Loc SettingsPage_KeepRobloxWindowed_2}" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,0"
                                           Text="{loc:Loc SettingsPage_RobloxRemembersFullscreenFromLast}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageAccounts" Visibility="Collapsed">
                    <!-- Two settings, one section: both change what RoRoRo puts on an account row.
                         They were two single-control cards, which is the shape that made a card
                         holding one control weigh the same as the ten-control Alerts card. -->
                    <TextBlock Text="{loc:Loc SettingsPage_WhatRororoShows}"
                               Style="{StaticResource SectionHeadingStyle}"
                               AutomationProperties.Name="{loc:Loc SettingsPage_WhatRororoShows}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <!-- Streamer mode. Moved off the main window 2026-08-04 (audit finding F-008): a
                                 setting occupied a full band of the dashboard and printed its own tooltip a
                                 second time as body copy. Rendered as a CheckBox rather than the ui:ToggleSwitch
                                 it was, to match the six settings already on this page — the ToggleSwitch was
                                 the app's only one. The tray checkbox stays; the two are views of one source of
                                 truth (IStreamerIdentityProvider), not two flags. -->
                            <StackPanel>
                                <CheckBox x:Name="StreamerModeToggle"
                                          Foreground="{DynamicResource WhiteBrush}"
                                          FontSize="{DynamicResource HeadingFontSize}"
                                          FontWeight="SemiBold">
                                    <TextBlock Text="{loc:Loc SettingsPage_StreamerMode}" />
                                </CheckBox>
                                <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,8"
                                           Text="{loc:Loc SettingsPage_HidesNamesAvatarsAndShare}" />
                                <Button x:Name="RerollAllButton"
                                        Content="{loc:Loc SettingsPage_RerollAllIdentities}"
                                        Click="OnRerollAllClick"
                                        HorizontalAlignment="Left"
                                        Margin="22,0,0,0"
                                        Padding="10,6"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontSize="{DynamicResource BodyFontSize}"
                                        ToolTip="{loc:Loc SettingsPage_AssignEveryFakeNameAnd}" />
                            </StackPanel>

                            <!-- v1.14 — Recycle now rejoins the exact server an account is in, so it earns a
                                 place outside the memory-warning state. Off by default; same row shape. -->
                            <StackPanel Margin="0,14,0,0">
                                <CheckBox x:Name="AlwaysShowRecycleToggle"
                                          Foreground="{DynamicResource WhiteBrush}"
                                          FontSize="{DynamicResource HeadingFontSize}"
                                          FontWeight="SemiBold"
                                          Click="OnAlwaysShowRecycleToggle">
                                    <TextBlock Text="{loc:Loc SettingsPage_AlwaysShowRecycleOnRunning}" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,0"
                                           Text="{loc:Loc SettingsPage_RecycleClosesAClientAnd}" />
                            </StackPanel>

                            <!-- F-111 / F-109. Stop now asks the client to close the way its own X does,
                                 then waits ten seconds before forcing. An in-game Roblox answers by
                                 raising its own confirm INSIDE the game, which RoRoRo cannot see or
                                 click. Only that clean exit persists Roblox's settings, so waiting is
                                 the default and skipping it is the opt-in. -->
                            <StackPanel Margin="0,14,0,0">
                                <CheckBox x:Name="AutoForceStopToggle"
                                          Foreground="{DynamicResource WhiteBrush}"
                                          FontSize="{DynamicResource HeadingFontSize}"
                                          FontWeight="SemiBold"
                                          Click="OnAutoForceStopToggle">
                                    <TextBlock Text="{loc:Loc SettingsPage_StopClientsImmediatelyWithoutWaiting}" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,0"
                                           Text="{loc:Loc SettingsPage_NormallyStopGivesRobloxTen}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Accounts — move accounts to another PC (v1.6.0 account transport). The
                         heading was hand-rolled at 13px SemiBold White INSIDE this card; it is the
                         same declaration the shared style makes, so it moved out and became the
                         style. Text unchanged deliberately — this item is structure, not copy. -->
                    <TextBlock Text="{loc:Loc SettingsPage_Accounts}"
                               Style="{StaticResource SectionHeadingStyle}"
                               AutomationProperties.Name="{loc:Loc SettingsPage_Accounts}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"
                                       Text="{loc:Loc SettingsPage_MoveYourSavedAccountsTo}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{loc:Loc SettingsPage_ExportAccounts}"
                                AutomationProperties.AutomationId="ExportAccountsButton" Padding="14,8" Margin="0,0,8,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        FontSize="{DynamicResource BodyFontSize}"
                                        Click="OnExportAccountsClick"
                                        ToolTip="{loc:Loc SettingsPage_SaveYourAccountsToAn}" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="{loc:Loc SettingsPage_ImportAccounts}" Padding="14,8"
                                        FontSize="{DynamicResource BodyFontSize}"
                                        Click="OnImportAccountsClick"
                                        ToolTip="{loc:Loc SettingsPage_AddAccountsFromAnEncrypted}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageAlerts" Visibility="Collapsed">
                    <!-- ONE SECTION, ONE SHAPE PER ROW (v1.33 item 6). Until this commit the nav
                         item "Alerts & memory" held THREE cards: "Idle accounts" (a mute toggle and
                         a threshold), "Alerts" (the routing grid, the credentials) and "Memory"
                         (the watch toggle and three numbers). The seams cost a reader more than the
                         controls did:

                         - The toggle that turns memory watching ON sat about 460 lines of markup
                           from the row that says where memory alerts GO, under a different heading.
                         - Idle alerts were not in the grid at all. The one kind with a section of
                           its own was the one kind the alert system did not handle — a tray toast
                           and nothing else, honouring a single global mute.
                         - Nothing on the page said how often an alert could repeat, because the
                           answer was a `static readonly TimeSpan` in AlertRouter.

                         Every row now answers the same three questions in the same order: DOES IT
                         FIRE (nothing ticked means off), HOW OFTEN AT MOST, WHERE DOES IT GO. A
                         kind whose firing needs more than a tick — memory needs the watchdog
                         running, idle needs a threshold, metric needs an opt-in and a rules file —
                         carries that below its own row, indented, where it is beside the thing it
                         governs instead of in a different card.

                         THE INDENT IS A MARGIN, NOT A CONTAINER. The grouping comment on PageStartup
                         forbids answering a grouping need with a second container rank — no
                         SubCardBorderStyle, no GroupBox, no Expander. So a kind's extra controls are
                         a plain StackPanel at Margin="22,...", which is the same indent the checkbox
                         hints on every other page already use. -->

                    <!-- Alerts (plan 2026-08-03, Task 7). The only wall in this feature is the webhook,
                         and it starts one step earlier than a paste field: "Server Settings ->
                         Integrations" assumes you own a server, and plenty of clan members have only
                         ever joined one. Hence the walkthrough button. Desktop alerts need no setup at
                         all, but the status line never pretends they are the point — you can already
                         see a dead client if you are sitting at the PC. -->
                    <TextBlock Text="{loc:Loc SettingsPage_Alerts}"
                               Style="{StaticResource SectionHeadingStyle}"
                               AutomationProperties.Name="{loc:Loc SettingsPage_Alerts}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="0,0,0,10"
                                       Text="{loc:Loc SettingsPage_GetToldWhenSomethingHappens}" />

                            <!-- How to read the rows below, stated before them (final whole-branch
                                 review, 2026-09-11). This hint governs all five and used to sit at
                                 the bottom of the card, where it trailed four rows and read as their
                                 footnote; the metric block landing under it made that worse — a
                                 general instruction arriving after a kind-specific paragraph reads
                                 as an afterthought about that one kind. Above the rows it is what it
                                 is: the key to the grid. Same string, moved. -->
                            <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="0,0,0,10"
                                       Text="{loc:Loc SettingsPage_TickEveryPlaceEachAlert}" />

                            <!-- THE SAFETY NET, SAID WHERE THE DESTINATIONS ARE CHOSEN (item 6).
                                 Item 3 made Desktop untickable in a way it had never been: the tray
                                 balloon used to fire from WireMemoryWarningTray with no destination
                                 check at all, so unticking Desktop for memory changed nothing and
                                 nobody could lose the warning. Now unticking it is obeyed. The badge
                                 is what keeps that from being a way to go blind — SetMemoryWarning
                                 stays unconditional and uncadenced, because a colour change is not
                                 an interruption. A user who turns every destination off still finds
                                 out at the PC, and this line is where the page says so rather than
                                 leaving it to be discovered. -->
                            <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="0,0,0,12"
                                       Text="{loc:Loc SettingsPage_TheTrayIconColoursWhatever}" />

                            <!-- THE GLOBAL PACE (item 2's setting, item 6's control). Every kind
                                 follows this unless its own picker below says otherwise. The values
                                 are minutes in the Tag and 0 is "Every time", which is
                                 AlertCadence's own idiom rather than a UI invention — see
                                 AlertCadence.FromSettings, where 0 means every alert passes and a
                                 NEGATIVE reads as the shipped five rather than as the loudest
                                 possible setting.

                                 A picker and not a text box, deliberately, and the opposite call
                                 from the memory numbers below. The memory numbers are free text
                                 because prd Story 1.1 needs an out-of-range value to exist so the
                                 refusal has something to refuse. A cadence has no out-of-range
                                 value worth refusing — any non-negative integer is legal — so there
                                 is nothing for free text to buy, and a picker keeps the
                                 committing-field count (SettingsCommitOnEnterFenceTests, equality
                                 at 8) where it is. -->
                            <TextBlock Text="{loc:Loc SettingsPage_HowOftenAtMost}"
                                       FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WhiteBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="AlertCadencePicker"
                                      AutomationProperties.Name="{loc:Loc SettingsPage_HowOftenAnyAlertMayRepeat}"
                                      Width="170" HorizontalAlignment="Left" Padding="8,6"
                                      FontSize="{DynamicResource BodyFontSize}"
                                      SelectionChanged="OnAlertCadenceChanged">
                                <ComboBoxItem Content="{loc:Loc SettingsPage_EveryTime}" Tag="0" />
                                <ComboBoxItem Content="{loc:Loc SettingsPage_1Minute}" Tag="1" />
                                <ComboBoxItem Content="{loc:Loc SettingsPage_5Minutes}" Tag="5" />
                                <ComboBoxItem Content="{loc:Loc SettingsPage_15Minutes}" Tag="15" />
                                <ComboBoxItem Content="{loc:Loc SettingsPage_30Minutes}" Tag="30" />
                                <ComboBoxItem Content="{loc:Loc SettingsPage_60Minutes}" Tag="60" />
                            </ComboBox>
                            <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Text="{loc:Loc SettingsPage_HowOftenAtMostHint}" />

                            <!-- THE SOUND (item 5's setting, item 6's control). It belongs beside
                                 the destinations rather than in a card of its own because it is a
                                 property of exactly one destination — Desktop — and it is the one
                                 thing on this page a user hears rather than reads. Item 4 is why
                                 there is a choice at all: ShowBalloonTip always played the system
                                 notification sound and offered no way to ask for a quiet one, and
                                 the balloon we draw plays nothing, so the sound stopped being
                                 Windows' decision and became ours.

                                 Chime FIRST in the list, matching AlertSound's declaration order
                                 and for the same reason it was declared that way: Silent is the one
                                 value that fails invisibly, and it should not be the first thing a
                                 keyboard user lands on when the list opens. -->
                            <TextBlock Text="{loc:Loc SettingsPage_AlertSound}"
                                       FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WhiteBrush}" Margin="0,14,0,4" />
                            <ComboBox x:Name="AlertSoundPicker"
                                      AutomationProperties.Name="{loc:Loc SettingsPage_WhatADesktopAlertSoundsLike}"
                                      Width="170" HorizontalAlignment="Left" Padding="8,6"
                                      FontSize="{DynamicResource BodyFontSize}"
                                      SelectionChanged="OnAlertSoundChanged">
                                <ComboBoxItem Content="{loc:Loc SettingsPage_SoundRororoChime}" Tag="Chime" />
                                <ComboBoxItem Content="{loc:Loc SettingsPage_SoundSilent}" Tag="Silent" />
                                <ComboBoxItem Content="{loc:Loc SettingsPage_SoundWindowsDefault}" Tag="WindowsDefault" />
                            </ComboBox>
                            <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Text="{loc:Loc SettingsPage_AlertSoundHint}" />

                            <!-- THE COLUMN HEADER, and the reason the table needs one. With two
                                 columns the shape read itself: a sentence, then some tick boxes.
                                 With three, the middle one is a bare combo whose selected value
                                 ("5 minutes") does not say what it is the pace OF. The header is
                                 where "At most once every" gets said once instead of seven times.

                                 WHITE, NOT MUTED, so PreferencesCopyTests classifies these as field
                                 labels rather than hints — a header is naming a column, not saying
                                 something to the reader, and the period rule would be wrong on it.
                                 Same call the memory number labels already make. -->
                            <Grid Margin="0,18,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc SettingsPage_AlertColumnAlert}" Width="180"
                                           FontSize="{DynamicResource MetaFontSize}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WhiteBrush}" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc SettingsPage_AlertColumnHowOften}" Width="162"
                                           FontSize="{DynamicResource MetaFontSize}" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WhiteBrush}" />
                                <TextBlock Grid.Column="2" Text="{loc:Loc SettingsPage_AlertColumnWhereItGoes}"
                                           FontSize="{DynamicResource MetaFontSize}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WhiteBrush}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc SettingsPage_AnAccountDropsOut}" FontSize="{DynamicResource BodyFontSize}" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WhiteBrush}" Width="180" />
                                <!-- WHICH KINDS GET AN OVERRIDE PICKER, decided against the built
                                     page as spec §8 asked. A kind gets one when a repeat for the
                                     SAME cooldown key (account + kind, plus metric id for
                                     MetricBreach) can arrive without a user action in between,
                                     because that is the only case where a quiet period changes an
                                     outcome:

                                       - drops out      YES. A client that crashes in a loop with
                                                        auto-rejoin on produces a drop each time;
                                                        the five minutes is what has been holding
                                                        that down since v1.0.
                                       - eats memory    YES. Pressure persists, so the crossing
                                                        re-arms. This is the kind the 2026-10-04
                                                        complaint was actually about.
                                       - goes idle      YES. ActivityMonitor's WarnLatched makes it
                                                        one per idle EPISODE, so it is the quietest
                                                        of the six — but a user who nudges a mouse
                                                        and walks away again re-arms the latch, and
                                                        then the pace is the only thing between them
                                                        and a second alert.
                                       - gets recycled  YES. A plugin can recycle on a schedule, and
                                                        a scheduled recycler is a repeat with no user
                                                        action in it at all.
                                       - auto-rejoin
                                         pauses         YES. Terminal per account in practice, but
                                                        "turn auto-rejoin back on and it pauses
                                                        again" is a loop a bad session really walks.
                                       - a metric
                                         crosses        YES. A flapping metric is the whole reason
                                                        v1.30 moved these to fire on the crossing;
                                                        the crossing is exactly what can repeat.
                                       - uptime marks   NO, and this is the one exception. The pace
                                                        is already fixed at two hours by
                                                        UptimeMarkTracker.MarkInterval, which is
                                                        upstream of the router: any override under
                                                        two hours does nothing, and any override
                                                        OVER two hours silently drops marks. A mark
                                                        whose ABSENCE is the only dead-PC signal this
                                                        app can give is not a thing to hand someone
                                                        a control to thin out. Every setting that
                                                        picker could hold is either a no-op or a
                                                        harm, so the cell states the fixed pace
                                                        instead.

                                     Six pickers rather than seven, and rather than the three a
                                     "only the noisy ones" reading would have given: a ragged table
                                     invites the question "why not this row", and the mechanical
                                     answer above is only short for one row. -->
                                <ComboBox Grid.Column="1" x:Name="DroppedOutCadencePicker"
                                          AutomationProperties.Name="{loc:Loc SettingsPage_HowOftenDropOutAlertsMay}"
                                          Width="150" Margin="0,2,12,2" HorizontalAlignment="Left" Padding="8,4"
                                          FontSize="{DynamicResource BodyFontSize}"
                                          SelectionChanged="OnAlertCadenceOverrideChanged">
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_FollowThePaceAbove}" Tag="" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_EveryTime}" Tag="0" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_1Minute}" Tag="1" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_5Minutes}" Tag="5" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_15Minutes}" Tag="15" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_30Minutes}" Tag="30" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_60Minutes}" Tag="60" />
                                </ComboBox>
                                <!-- Checkboxes, not a picker (Este's smoke feedback, 2026-09-05): an alert
                                     can fan out — desktop AND phone AND a channel. Nothing ticked = off,
                                     which is also this table's "does it fire" answer. Checked/Unchecked
                                     rather than Click, for the F-102 reason: automation's TogglePattern
                                     never raises Click. -->
                                <WrapPanel Grid.Column="2">
                                    <CheckBox x:Name="DroppedOutLocalCheck" Content="{loc:Loc SettingsPage_Desktop}" AutomationProperties.Name="{loc:Loc SettingsPage_SendDropOutAlertsTo}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="DroppedOutMineCheck" Content="{loc:Loc SettingsPage_MyChannel}" AutomationProperties.Name="{loc:Loc SettingsPage_SendDropOutAlertsTo_2}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="DroppedOutClanCheck" Content="{loc:Loc SettingsPage_ClanChannel}" AutomationProperties.Name="{loc:Loc SettingsPage_SendDropOutAlertsTo_3}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="DroppedOutPhoneCheck" Content="{loc:Loc SettingsPage_MyPhone}" AutomationProperties.Name="{loc:Loc SettingsPage_SendDropOutAlertsTo_4}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                </WrapPanel>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc SettingsPage_AnAccountEatsMemory}" FontSize="{DynamicResource BodyFontSize}" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WhiteBrush}" Width="180" />
                                <ComboBox Grid.Column="1" x:Name="MemoryWarningCadencePicker"
                                          AutomationProperties.Name="{loc:Loc SettingsPage_HowOftenMemoryWarningsMay}"
                                          Width="150" Margin="0,2,12,2" HorizontalAlignment="Left" Padding="8,4"
                                          FontSize="{DynamicResource BodyFontSize}"
                                          SelectionChanged="OnAlertCadenceOverrideChanged">
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_FollowThePaceAbove}" Tag="" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_EveryTime}" Tag="0" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_1Minute}" Tag="1" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_5Minutes}" Tag="5" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_15Minutes}" Tag="15" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_30Minutes}" Tag="30" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_60Minutes}" Tag="60" />
                                </ComboBox>
                                <WrapPanel Grid.Column="2">
                                    <CheckBox x:Name="MemoryWarningLocalCheck" Content="{loc:Loc SettingsPage_Desktop}" AutomationProperties.Name="{loc:Loc SettingsPage_SendMemoryWarningsToThe}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="MemoryWarningMineCheck" Content="{loc:Loc SettingsPage_MyChannel}" AutomationProperties.Name="{loc:Loc SettingsPage_SendMemoryWarningsToMy}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="MemoryWarningClanCheck" Content="{loc:Loc SettingsPage_ClanChannel}" AutomationProperties.Name="{loc:Loc SettingsPage_SendMemoryWarningsToThe_2}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="MemoryWarningPhoneCheck" Content="{loc:Loc SettingsPage_MyPhone}" AutomationProperties.Name="{loc:Loc SettingsPage_SendMemoryWarningsToMy_2}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                </WrapPanel>
                            </Grid>

                            <!-- MEMORY'S OWN CONTROLS, BESIDE THE ROW THEY DRIVE (item 6). These
                                 four were a separate card under a separate heading until this
                                 commit, about 460 lines below the row above — so the question "why
                                 am I not getting memory warnings" had two answers in two places,
                                 and the one that was usually right (the watchdog is off) was the
                                 one further away.

                                 They have been persisted since v1.13 and were referenced by zero
                                 .xaml until the audit cycle; SettingsReachabilityTests is the fence
                                 that made that shape fail a build.

                                 WHY FREE TEXT AND NOT A PRESET PICKER, unlike the cadence pickers
                                 in the column beside them. A picker cannot produce an out-of-range
                                 value, so it cannot satisfy prd Story 1.1's requirement that one be
                                 refused VISIBLY — the criterion would be unfalsifiable by
                                 construction. Free text is what gives the refusal something to
                                 refuse. It is also what "hand-editing settings.json still works"
                                 already implies: the file accepts any integer, so the UI has to be
                                 able to show any integer and reject the wrong ones.

                                 Blank is not empty, it is "RoRoRo picks". SettingsBlob.MemoryReserveMb
                                 and SettingsBlob.MemoryCapMb are int? and null means never set —
                                 App.xaml.cs derives from installed RAM via MemoryDefaults. An empty
                                 box has to round-trip back to null or a user who clears one silently
                                 pins whatever happened to be showing.

                                 WRITE THOSE TWO NAMES DOTTED, HERE AND IN THE CODE-BEHIND, and do
                                 not tidy the owner off. SettingsReachabilityTests' control edge
                                 matches a bare setting name anywhere in an App .cs/.xaml file,
                                 comments included, and its one exclusion is a preceding "." (a
                                 member read is a consumer, not a control). So a bare setting name in
                                 a sentence is enough to report that setting reachable; the same name
                                 written with its owner is not. Proved on 2026-08-10: with all three
                                 of the projection setting's sites renamed away, the fence still
                                 passed on two doc comments alone. Qualified names keep the fence
                                 measuring the controls. -->
                            <StackPanel Margin="22,0,0,14">
                                <CheckBox x:Name="MemoryWatchdogEnabledToggle"
                                          Foreground="{DynamicResource WhiteBrush}"
                                          FontSize="{DynamicResource BodyFontSize}"
                                          FontWeight="SemiBold"
                                          AutomationProperties.Name="{loc:Loc SettingsPage_WatchMemoryWhileAccountsAre}"
                                          Click="OnMemoryWatchdogEnabledToggle">
                                    <TextBlock Text="{loc:Loc SettingsPage_WatchMemoryWhileAccountsAre_2}" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,0"
                                           Text="{loc:Loc SettingsPage_RororoChecksEveryRunningClient}" />

                                <!-- WHAT BLANK ACTUALLY PICKS, on this machine, said out loud.
                                     The three boxes below accept blank to mean "RoRoRo picks one"
                                     and said nothing about what it picked.

                                     The text is set from the code-behind rather than written here,
                                     because the figures are DERIVED and the derivation must be the
                                     one App.WireMemoryWatchdogAsync already runs. See
                                     AutomaticMemorySummary — it calls MemoryDefaults, so a number
                                     here cannot disagree with the number the watchdog uses. A
                                     literal in this markup would be a second source of truth for a
                                     value that changes with the PC it runs on.

                                     Muted prose, not the warning vocabulary, even on the
                                     probe-failure path. A machine whose RAM cannot be read is a
                                     standing fact, not an event, and MemorySettingsWarning below is
                                     where a refusal speaks. -->
                                <TextBlock x:Name="AutomaticMemoryLine"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,14,0,0"
                                           AutomationProperties.Name="{loc:Loc SettingsPage_WhatRororoPicksWhenA}" />

                                <!-- Row separation is a call-site margin, same as the Startup card. -->
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="{loc:Loc SettingsPage_MemoryToKeepFreeMb}"
                                               FontSize="{DynamicResource BodyFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource WhiteBrush}"
                                               Margin="0,0,0,4" />
                                    <!-- Blank means "RoRoRo picks" — and the pick is now IN the box as a
                                         ghost (Este, 2026-09-05): a blank field looked like nothing was
                                         happening. The ghost is the same MemoryDefaults figure the intro
                                         sentence quotes, hidden the moment real text exists. -->
                                    <Grid Width="184" HorizontalAlignment="Left">
                                        <TextBox x:Name="MemoryReserveMbInput"
                                                 Padding="8,6"
                                                 FontSize="{DynamicResource BodyFontSize}"
                                                 Background="{DynamicResource NavyBrush}"
                                                 Style="{StaticResource AppTextBoxStyle}"
                                                 AutomationProperties.Name="{loc:Loc SettingsPage_MemoryToKeepFreeIn}"
                                                 AutomationProperties.HelpText="{loc:Loc SettingsPage_AWholeNumberFrom256}"
                                                 PreviewKeyDown="OnCommitOnEnter" LostFocus="OnMemoryReserveCommitted"
                                                 TextChanged="OnMemoryInputTextChanged" />
                                        <TextBlock x:Name="MemoryReserveGhost"
                                                   FontSize="{DynamicResource BodyFontSize}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   IsHitTestVisible="False" />
                                    </Grid>
                                    <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Text="{loc:Loc SettingsPage_YouGetWarnedOnceFree}" />
                                </StackPanel>

                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="{loc:Loc SettingsPage_WarnWhenOneAccountPasses}"
                                               FontSize="{DynamicResource BodyFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource WhiteBrush}"
                                               Margin="0,0,0,4" />
                                    <Grid Width="184" HorizontalAlignment="Left">
                                        <TextBox x:Name="MemoryCapMbInput"
                                                 Padding="8,6"
                                                 FontSize="{DynamicResource BodyFontSize}"
                                                 Background="{DynamicResource NavyBrush}"
                                                 Style="{StaticResource AppTextBoxStyle}"
                                                 AutomationProperties.Name="{loc:Loc SettingsPage_WarnWhenOneAccountPasses_2}"
                                                 AutomationProperties.HelpText="{loc:Loc SettingsPage_AWholeNumberFrom256_2}"
                                                 PreviewKeyDown="OnCommitOnEnter" LostFocus="OnMemoryCapCommitted"
                                                 TextChanged="OnMemoryInputTextChanged" />
                                        <TextBlock x:Name="MemoryCapGhost"
                                                   FontSize="{DynamicResource BodyFontSize}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   IsHitTestVisible="False" />
                                    </Grid>
                                    <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Text="{loc:Loc SettingsPage_OneClientOnItsOwn}" />
                                </StackPanel>

                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="{loc:Loc SettingsPage_WarnThisFarAheadMinutes}"
                                               FontSize="{DynamicResource BodyFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource WhiteBrush}"
                                               Margin="0,0,0,4" />
                                    <TextBox x:Name="ProjectionWarnMinutesInput"
                                             Width="120"
                                             HorizontalAlignment="Left"
                                             Padding="8,6"
                                             FontSize="{DynamicResource BodyFontSize}"
                                             Background="{DynamicResource NavyBrush}"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             AutomationProperties.Name="{loc:Loc SettingsPage_WarnThisManyMinutesAhead}"
                                             AutomationProperties.HelpText="{loc:Loc SettingsPage_AWholeNumberOfMinutes}"
                                             PreviewKeyDown="OnCommitOnEnter" LostFocus="OnProjectionWarnCommitted" />
                                    <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Text="{loc:Loc SettingsPage_RororoWatchesHowFastYour}" />
                                </StackPanel>

                                <!-- MEMORY'S OWN FAILURE LINE, and the three reasons it is its own
                                     (spec 5). It is not AlertsStatusLine: that line is CyanBrush and
                                     summarises routing, and spec 5 explicitly leaves it alone.

                                     RowExpiredAccentBrush and the U+25B2 prefix are the warning
                                     vocabulary v1.17 established across expired rows, idle chips,
                                     memory chips and the compat banner. Cyan is the accent — the
                                     same treatment a SUCCESS would get — so a refusal painted cyan
                                     would look like a save.

                                     Collapsed until something is refused. A status line that speaks
                                     on every save is noise, and the refusal has to arrive as a
                                     change. -->
                                <TextBlock x:Name="MemorySettingsWarning"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource RowExpiredAccentBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0"
                                           Visibility="Collapsed"
                                           AutomationProperties.Name="{loc:Loc SettingsPage_MemorySettingsWarning}"
                                           AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>

                            <!-- IDLE JOINS THE GRID (item 1 gave it AlertKind.AccountIdle and
                                 DiscordConfig.IdleDestinations; item 3 made MainViewModel raise the
                                 trigger instead of calling IdleAlertPresenter). Until this commit
                                 idle was the only kind with a card of its own and the only kind the
                                 alert system did not handle: a tray toast, no destinations, no
                                 cooldown, and one global MuteIdleAlerts bool across the whole
                                 roster.

                                 The standalone mute toggle is GONE, not hidden. Item 3 migrated an
                                 existing `true` once to IdleDestinations = [] and the key is read by
                                 nothing now; it stays on SettingsBlob so an older settings.json
                                 still deserializes, and on the SettingsReachabilityTests allow-list
                                 with that written in. Unticking all four boxes below is the same
                                 request expressed properly, and a row context-menu mute is how you
                                 silence ONE account instead of all of them. -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc SettingsPage_AnAccountGoesIdle}" FontSize="{DynamicResource BodyFontSize}" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WhiteBrush}" Width="180" />
                                <ComboBox Grid.Column="1" x:Name="IdleCadencePicker"
                                          AutomationProperties.Name="{loc:Loc SettingsPage_HowOftenIdleAlertsMay}"
                                          Width="150" Margin="0,2,12,2" HorizontalAlignment="Left" Padding="8,4"
                                          FontSize="{DynamicResource BodyFontSize}"
                                          SelectionChanged="OnAlertCadenceOverrideChanged">
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_FollowThePaceAbove}" Tag="" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_EveryTime}" Tag="0" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_1Minute}" Tag="1" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_5Minutes}" Tag="5" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_15Minutes}" Tag="15" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_30Minutes}" Tag="30" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_60Minutes}" Tag="60" />
                                </ComboBox>
                                <WrapPanel Grid.Column="2">
                                    <CheckBox x:Name="IdleLocalCheck" Content="{loc:Loc SettingsPage_Desktop}" AutomationProperties.Name="{loc:Loc SettingsPage_SendIdleAlertsToThe}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="IdleMineCheck" Content="{loc:Loc SettingsPage_MyChannel}" AutomationProperties.Name="{loc:Loc SettingsPage_SendIdleAlertsToMy}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="IdleClanCheck" Content="{loc:Loc SettingsPage_ClanChannel}" AutomationProperties.Name="{loc:Loc SettingsPage_SendIdleAlertsToThe_2}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="IdlePhoneCheck" Content="{loc:Loc SettingsPage_MyPhone}" AutomationProperties.Name="{loc:Loc SettingsPage_SendIdleAlertsToMy_2}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                </WrapPanel>
                            </Grid>

                            <!-- Idle's own precondition, beside its row for the reason memory's is:
                                 "why am I not getting idle alerts" has two answers and this is the
                                 other one. The threshold also drives the row CHIP, which no alert
                                 setting can turn off — said in the hint so nobody unticks a
                                 destination expecting the chip to go with it. -->
                            <StackPanel Margin="22,0,0,14">
                                <TextBlock Text="{loc:Loc SettingsPage_IdleWarnThreshold}"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WhiteBrush}"
                                           Margin="0,0,0,4" />
                                <ComboBox x:Name="IdleWarnThresholdPicker" AutomationProperties.Name="{loc:Loc SettingsPage_IdleWarnThreshold}"
                                          Width="160"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="OnIdleWarnThresholdChanged"
                                          Padding="8,6"
                                          FontSize="{DynamicResource BodyFontSize}">
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_10Minutes}" Tag="10" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_12Minutes}" Tag="12" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_15Minutes}" Tag="15" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_18Minutes}" Tag="18" />
                                </ComboBox>
                                <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="{loc:Loc SettingsPage_NobodyHasTouchedTheAccount}" />
                            </StackPanel>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc SettingsPage_AnAccountGetsRecycled}" FontSize="{DynamicResource BodyFontSize}" VerticalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WhiteBrush}" Width="180" />
                                <ComboBox Grid.Column="1" x:Name="RecycledCadencePicker"
                                          AutomationProperties.Name="{loc:Loc SettingsPage_HowOftenRecycleNoticesMay}"
                                          Width="150" Margin="0,2,12,2" HorizontalAlignment="Left" Padding="8,4"
                                          FontSize="{DynamicResource BodyFontSize}"
                                          SelectionChanged="OnAlertCadenceOverrideChanged">
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_FollowThePaceAbove}" Tag="" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_EveryTime}" Tag="0" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_1Minute}" Tag="1" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_5Minutes}" Tag="5" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_15Minutes}" Tag="15" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_30Minutes}" Tag="30" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_60Minutes}" Tag="60" />
                                </ComboBox>
                                <WrapPanel Grid.Column="2">
                                    <CheckBox x:Name="RecycledLocalCheck" Content="{loc:Loc SettingsPage_Desktop}" AutomationProperties.Name="{loc:Loc SettingsPage_SendRecycleNoticesToThe}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="RecycledMineCheck" Content="{loc:Loc SettingsPage_MyChannel}" AutomationProperties.Name="{loc:Loc SettingsPage_SendRecycleNoticesToMy}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="RecycledClanCheck" Content="{loc:Loc SettingsPage_ClanChannel}" AutomationProperties.Name="{loc:Loc SettingsPage_SendRecycleNoticesToThe_2}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="RecycledPhoneCheck" Content="{loc:Loc SettingsPage_MyPhone}" AutomationProperties.Name="{loc:Loc SettingsPage_SendRecycleNoticesToMy_2}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                </WrapPanel>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc SettingsPage_AutoRejoinPausesForAnAccount}" FontSize="{DynamicResource BodyFontSize}" VerticalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WhiteBrush}" Width="180" />
                                <ComboBox Grid.Column="1" x:Name="AutoRejoinPausedCadencePicker"
                                          AutomationProperties.Name="{loc:Loc SettingsPage_HowOftenAutoRejoinPausedAlertsMay}"
                                          Width="150" Margin="0,2,12,2" HorizontalAlignment="Left" Padding="8,4"
                                          FontSize="{DynamicResource BodyFontSize}"
                                          SelectionChanged="OnAlertCadenceOverrideChanged">
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_FollowThePaceAbove}" Tag="" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_EveryTime}" Tag="0" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_1Minute}" Tag="1" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_5Minutes}" Tag="5" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_15Minutes}" Tag="15" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_30Minutes}" Tag="30" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_60Minutes}" Tag="60" />
                                </ComboBox>
                                <WrapPanel Grid.Column="2">
                                    <CheckBox x:Name="AutoRejoinPausedLocalCheck" Content="{loc:Loc SettingsPage_Desktop}" AutomationProperties.Name="{loc:Loc SettingsPage_SendAutoRejoinPausedAlertsToThe}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="AutoRejoinPausedMineCheck" Content="{loc:Loc SettingsPage_MyChannel}" AutomationProperties.Name="{loc:Loc SettingsPage_SendAutoRejoinPausedAlertsToMy}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="AutoRejoinPausedClanCheck" Content="{loc:Loc SettingsPage_ClanChannel}" AutomationProperties.Name="{loc:Loc SettingsPage_SendAutoRejoinPausedAlertsToThe_2}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="AutoRejoinPausedPhoneCheck" Content="{loc:Loc SettingsPage_MyPhone}" AutomationProperties.Name="{loc:Loc SettingsPage_SendAutoRejoinPausedAlertsToMy_2}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                </WrapPanel>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc SettingsPage_UptimeMarksEvery2Hours}" FontSize="{DynamicResource BodyFontSize}" VerticalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WhiteBrush}" Width="180" />
                                <!-- THE ONE ROW WITH NO OVERRIDE PICKER, and a sentence where the
                                     others have a control. UptimeMarkTracker.MarkInterval is two
                                     hours and sits UPSTREAM of the router, so any override under two
                                     hours is a no-op and any override over it silently drops marks —
                                     and a mark's ABSENCE is the only dead-PC signal a PC-fired alert
                                     system can give. Every value that picker could hold is either
                                     nothing or harm. Stating the pace is the honest cell; a disabled
                                     picker would be a control that answers the click and changes
                                     nothing, which is the shape SyncMetricDestinationsEnabled's note
                                     calls "reads as broken".

                                     Width matched to the pickers beside it so the third column still
                                     starts on the same line down the table. -->
                                <TextBlock Grid.Column="1" Text="{loc:Loc SettingsPage_FixedAtTwoHours}" Width="150" Margin="0,2,12,2" TextWrapping="Wrap"
                                           FontSize="{DynamicResource BodyFontSize}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <WrapPanel Grid.Column="2">
                                    <CheckBox x:Name="UptimeMarkLocalCheck" Content="{loc:Loc SettingsPage_Desktop}" AutomationProperties.Name="{loc:Loc SettingsPage_SendUptimeMarksToThe}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="UptimeMarkMineCheck" Content="{loc:Loc SettingsPage_MyChannel}" AutomationProperties.Name="{loc:Loc SettingsPage_SendUptimeMarksToMy}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="UptimeMarkClanCheck" Content="{loc:Loc SettingsPage_ClanChannel}" AutomationProperties.Name="{loc:Loc SettingsPage_SendUptimeMarksToThe_2}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="UptimeMarkPhoneCheck" Content="{loc:Loc SettingsPage_MyPhone}" AutomationProperties.Name="{loc:Loc SettingsPage_SendUptimeMarksToMy_2}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                </WrapPanel>
                            </Grid>

                            <!-- Metric alerts (plan 2026-09-11). TWO STORES IN ONE ROW, and that is
                                 the thing to know before editing it. The switch below writes
                                 MetricAlertsEnabled into settings.json through IAppSettings; the four
                                 boxes in the row write MetricBreachDestinations into the encrypted
                                 discord.dat with every other kind's routing. Different files,
                                 different save paths, which is why the switch has a handler of its
                                 own instead of riding OnAlertRoutingChanged.

                                 A row rather than a section of its own because it answers the same
                                 questions the six above it do. MetricBreachDestinations defaults to
                                 the desktop notification so a breach has somewhere to land the moment
                                 it is wanted; nothing lands until the switch is ticked, and an
                                 upgrade must not start alerting anybody who did not ask.

                                 Checked/Unchecked on the switch too, never Click, for the F-102
                                 reason its neighbours carry: automation's TogglePattern never raises
                                 Click.

                                 THE SWITCH MOVED FROM ABOVE THE ROW TO BELOW IT (item 6), and the
                                 constraint that put it above is still honoured. Review fix 1
                                 (2026-09-11) kept it OUT of the 180px label column because a
                                 CheckBox's Content does not wrap and German and Polish overrun that
                                 width. Below the row it is full-width in its own indented block, so
                                 the Content attribute can stay exactly as it was — no wrap needed,
                                 and PreferencesCopyTests still classifies no CheckBoxLabel here (an
                                 attribute Content is not a TextBlock), which is what keeps "Metric
                                 alerts" exempt from the ends-in-a-period rule it would fail.

                                 Below rather than above because it is the kind's PRECONDITION, like
                                 the watchdog toggle and the idle threshold, and all three now sit in
                                 the same place relative to their row. -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc SettingsPage_AMetricCrossesAThreshold}" FontSize="{DynamicResource BodyFontSize}" VerticalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WhiteBrush}" Width="180" />
                                <ComboBox Grid.Column="1" x:Name="MetricBreachCadencePicker"
                                          AutomationProperties.Name="{loc:Loc SettingsPage_HowOftenMetricAlertsMay}"
                                          Width="150" Margin="0,2,12,2" HorizontalAlignment="Left" Padding="8,4"
                                          FontSize="{DynamicResource BodyFontSize}"
                                          SelectionChanged="OnAlertCadenceOverrideChanged">
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_FollowThePaceAbove}" Tag="" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_EveryTime}" Tag="0" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_1Minute}" Tag="1" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_5Minutes}" Tag="5" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_15Minutes}" Tag="15" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_30Minutes}" Tag="30" />
                                    <ComboBoxItem Content="{loc:Loc SettingsPage_60Minutes}" Tag="60" />
                                </ComboBox>
                                <WrapPanel Grid.Column="2">
                                    <CheckBox x:Name="MetricBreachLocalCheck" Content="{loc:Loc SettingsPage_Desktop}" AutomationProperties.Name="{loc:Loc SettingsPage_SendMetricAlertsToThe}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="MetricBreachMineCheck" Content="{loc:Loc SettingsPage_MyChannel}" AutomationProperties.Name="{loc:Loc SettingsPage_SendMetricAlertsToMy}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="MetricBreachClanCheck" Content="{loc:Loc SettingsPage_ClanChannel}" AutomationProperties.Name="{loc:Loc SettingsPage_SendMetricAlertsToThe_2}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                    <CheckBox x:Name="MetricBreachPhoneCheck" Content="{loc:Loc SettingsPage_MyPhone}" AutomationProperties.Name="{loc:Loc SettingsPage_SendMetricAlertsToMy_2}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,2,12,2" Checked="OnAlertRoutingChanged" Unchecked="OnAlertRoutingChanged" />
                                </WrapPanel>
                            </Grid>

                            <StackPanel Margin="22,0,0,14">
                                <CheckBox x:Name="MetricAlertsEnabledToggle"
                                          Content="{loc:Loc SettingsPage_MetricAlerts}"
                                          AutomationProperties.Name="{loc:Loc SettingsPage_MetricAlerts}"
                                          FontSize="{DynamicResource BodyFontSize}"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource WhiteBrush}"
                                          Checked="OnMetricAlertsEnabledToggle" Unchecked="OnMetricAlertsEnabledToggle" />
                                <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                           Margin="22,4,0,0"
                                           Text="{loc:Loc SettingsPage_MetricAlertsHint}" />
                            </StackPanel>

                            <!-- Muted accounts (F-024, spec 4.3). Muting is per-account and lives on
                                 the row context menu; this page owned every OTHER alert decision and
                                 said nothing about that one. Somebody who muted an account three
                                 weeks ago could not find out from the app that they had.

                                 It sits directly under the two routing rows because it is the
                                 exception to them: here is where alerts go, and here is who is
                                 exempt. See MutedAccountsSummary for why the count reads the ROWS
                                 rather than the persisted id list.

                                 ZERO RENDERS AS ABSENCE (prd Story 1.3). Collapsed by default and
                                 restored to Collapsed by RefreshMutedAccounts — not a stray "0", not
                                 an empty row. Collapsed rather than Hidden so no gap is left where
                                 the block would have been, same as ThemeDescriptionText on the
                                 Appearance page.

                                 Unmute all takes the ORDINARY secondary treatment, deliberately. It
                                 is destructive-adjacent and it is not on the destructive list, which
                                 names exactly three sites — Remove, Clear and Stop all — and treats
                                 a fourth as the signal to drop that work rather than widen it. -->
                            <StackPanel x:Name="MutedAccountsRow" Margin="0,4,0,6" Visibility="Collapsed">
                                <TextBlock x:Name="MutedAccountsLine"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="{loc:Loc SettingsPage_MutedAccounts}" />
                                <Button x:Name="UnmuteAllButton"
                                        Content="{loc:Loc SettingsPage_UnmuteAll}"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0"
                                        Padding="10,5"
                                        FontSize="{DynamicResource BodyFontSize}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.Name="{loc:Loc SettingsPage_UnmuteEveryMutedAccount}"
                                        Click="OnUnmuteAllClick"
                                        ToolTip="{loc:Loc SettingsPage_TurnAlertsBackOnFor}" />
                            </StackPanel>

                            <!-- POSITION IS LOAD-BEARING, and it was wrong until 2026-09-12. This
                                 line lived at the very bottom of the card, under the phone tokens,
                                 where it was the last thing anyone reached. Its own copy had always
                                 assumed otherwise: three arms say "paste it below" or "check the key
                                 below", pointing at the webhook and phone fields — which sat ABOVE
                                 it. So it was not merely buried, it was wrong in three states.
                                 Between the rows it summarises and the fields it points at is the
                                 only place the sentences are true. Same correction the hint above the
                                 rows got on 2026-09-11, for the same reason, one card later.
                                 AlertsStatusLinePositionFenceTests holds it here. -->
                            <!-- F-094. Every arm of this line used to be CyanBrush — the accent, which
                                 is the treatment a SUCCESS gets — so "your webhook was deleted, so
                                 nothing is reaching your phone" rendered identically to "sending to
                                 #alerts". The sentence said one thing and the styling said another,
                                 and styling is what gets read first.

                                 The failure arms take RowExpiredAccentBrush and the "▲ " prefix, which
                                 is the pair MainWindow already uses for the compat and Bloxstrap
                                 banners. Driven from a Tag rather than assigned in code-behind so the
                                 colour stays visible to the theme gates — code-behind colour
                                 assignment is exactly the blind spot F-098 records. -->
                            <TextBlock x:Name="AlertsStatusLine" FontSize="{DynamicResource BodyFontSize}" Margin="0,10,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource CyanBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="Tag" Value="failure">
                                                <Setter Property="Foreground" Value="{DynamicResource RowExpiredAccentBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Two separate webhooks, because they are two different audiences. "My
                                 channel" is a server you own and nobody else reads; "Clan channel" is a
                                 shared room. Keeping them apart is what lets someone send health noise
                                 to themselves and only the interesting things to the clan — and it is
                                 why the payload type has no field a private-server link could live in
                                 (see WebhookPayload). One shared field would collapse that choice. -->
                            <TextBlock Text="{loc:Loc SettingsPage_MyChannelWebhookUrl}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WhiteBrush}" Margin="0,10,0,2" />
                            <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="0,0,0,4"
                                       Text="{loc:Loc SettingsPage_AServerOnlyYouRead}" />
                            <!-- F-076. The saved value renders masked and read-only; Show reveals it
                                 AND makes it editable, so revealing is a deliberate act and nobody
                                 can blind-edit a credential they cannot see. A webhook URL is a
                                 bearer token — this app has a streamer mode, and the field used to
                                 sit at full contrast where a stream or a screen-share picks it up. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MineWebhookInput" AutomationProperties.Name="{loc:Loc SettingsPage_MyChannelWebhookUrl_2}" Grid.Column="0" Padding="8,6" FontSize="{DynamicResource BodyFontSize}"
                                         Background="{DynamicResource NavyBrush}"
                                         PreviewKeyDown="OnCommitOnEnter" LostFocus="OnWebhookCommitted" Style="{StaticResource AppTextBoxStyle}"/>
                                <!-- Takes the rank rather than repeating it. The four attributes
                                     removed here were byte-identical to SecondaryToggleButtonStyle's
                                     setters, so nothing moves at rest; what changes is the TEMPLATE,
                                     which they were not getting. A ToggleButton with no rank inherits
                                     the OS template and its hardcoded #BEE6FD hover, so both Show
                                     buttons on this page still flashed Aero blue after the rest of
                                     the app stopped. Found by item 9's fence, which counts
                                     ToggleButton because the C2 gap proved a control type outside
                                     the definition is where this defect survives. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ToggleButton x:Name="MineWebhookReveal" Content="{loc:Loc SettingsPage_Show}"
                                                  Margin="6,0,0,0" Padding="10,5" FontSize="{DynamicResource BodyFontSize}"
                                                  Checked="OnRevealWebhookToggled" Unchecked="OnRevealWebhookToggled"
                                                  Style="{StaticResource SecondaryToggleButtonStyle}"
                                                  ToolTip="{loc:Loc SettingsPage_RevealTheSavedWebhookSo}" />
                                    <Button x:Name="MineWebhookRemove" Content="{loc:Loc SettingsPage_Remove}"
                                            Margin="6,0,0,0" Padding="10,5" FontSize="{DynamicResource BodyFontSize}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            AutomationProperties.Name="{loc:Loc SettingsPage_MyChannelWebhookUrl_2}"
                                            Click="OnRemoveSecretClick"
                                            ToolTip="{loc:Loc SettingsPage_DeletesTheSavedValue}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="MineWebhookVerdict" FontSize="{DynamicResource BodyFontSize}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <TextBlock Text="{loc:Loc SettingsPage_ClanChannelWebhookUrl}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WhiteBrush}" Margin="0,12,0,2" />
                            <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="0,0,0,4"
                                       Text="{loc:Loc SettingsPage_ASharedRoomAnythingRouted}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ClanWebhookInput" AutomationProperties.Name="{loc:Loc SettingsPage_ClanChannelWebhookUrl_2}" Grid.Column="0" Padding="8,6" FontSize="{DynamicResource BodyFontSize}"
                                         Background="{DynamicResource NavyBrush}"
                                         PreviewKeyDown="OnCommitOnEnter" LostFocus="OnWebhookCommitted" Style="{StaticResource AppTextBoxStyle}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ToggleButton x:Name="ClanWebhookReveal" Content="{loc:Loc SettingsPage_Show}"
                                                  Margin="6,0,0,0" Padding="10,5" FontSize="{DynamicResource BodyFontSize}"
                                                  Checked="OnRevealWebhookToggled" Unchecked="OnRevealWebhookToggled"
                                                  Style="{StaticResource SecondaryToggleButtonStyle}"
                                                  ToolTip="{loc:Loc SettingsPage_RevealTheSavedWebhookSo}" />
                                    <Button x:Name="ClanWebhookRemove" Content="{loc:Loc SettingsPage_Remove}"
                                            Margin="6,0,0,0" Padding="10,5" FontSize="{DynamicResource BodyFontSize}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            AutomationProperties.Name="{loc:Loc SettingsPage_ClanChannelWebhookUrl_2}"
                                            Click="OnRemoveSecretClick"
                                            ToolTip="{loc:Loc SettingsPage_DeletesTheSavedValue}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="ClanWebhookVerdict" FontSize="{DynamicResource BodyFontSize}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource AccentActionButtonStyle}" x:Name="SendTestButton" Content="{loc:Loc SettingsPage_SendTest}" Padding="12,5" Click="OnSendTestClick" FontSize="{DynamicResource BodyFontSize}" />
                                <Button x:Name="NoServerHelpButton" Content="{loc:Loc SettingsPage_IDonTHaveA}" Padding="12,5" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryStrongButtonStyle}" FontSize="{DynamicResource BodyFontSize}"
                                        Click="OnNoServerHelpClick" />
                            </StackPanel>

                            <!-- Phone push (spec 2026-09-04). Same card because it answers the same
                                 question as the rows above - where do alerts go - but a separate
                                 mechanism on purpose: the Discord webhook stays its own piece
                                 (Este's ruling, decisions.md 2026-09-04). Pushover is the app most
                                 of the clan already carries; ntfy is the free option. Every field
                                 here is a bearer credential and takes the F-076 masked/reveal
                                 treatment wholesale. -->
                            <TextBlock Text="{loc:Loc SettingsPage_MyPhonePushService}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WhiteBrush}" Margin="0,12,0,2" />
                            <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="0,0,0,4"
                                       Text="{loc:Loc SettingsPage_BuzzesYourPhoneDirectlyNo}" />
                            <ComboBox x:Name="PhoneProviderPicker" AutomationProperties.Name="{loc:Loc SettingsPage_WhichPushServiceSendsPhone}" Width="170" HorizontalAlignment="Left"
                                      SelectionChanged="OnPhoneProviderChanged">
                                <ComboBoxItem Content="{loc:Loc SettingsPage_Off}" Tag="None" />
                                <ComboBoxItem Content="{loc:Loc SettingsPage_Pushover}" Tag="Pushover" />
                                <ComboBoxItem Content="{loc:Loc SettingsPage_Ntfy}" Tag="Ntfy" />
                            </ComboBox>

                            <StackPanel x:Name="PushoverFields" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                           Margin="0,0,0,4"
                                           Text="{loc:Loc SettingsPage_BothCodesComeFromPushover}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="PushoverDashboardButton" Content="{loc:Loc SettingsPage_OpenTheDashboard}" Padding="10,5"
                                            Style="{StaticResource SecondaryButtonStyle}" FontSize="{DynamicResource BodyFontSize}"
                                            AutomationProperties.Name="{loc:Loc SettingsPage_OpenTheDashboard}"
                                            Click="OnOpenPushoverPageClick"
                                            ToolTip="{loc:Loc SettingsPage_OpensPushoverInYourBrowser}" />
                                    <Button x:Name="PushoverAppFormButton" Content="{loc:Loc SettingsPage_CreateTheApplication}" Padding="10,5" Margin="6,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}" FontSize="{DynamicResource BodyFontSize}"
                                            AutomationProperties.Name="{loc:Loc SettingsPage_CreateTheApplication}"
                                            Click="OnOpenPushoverPageClick"
                                            ToolTip="{loc:Loc SettingsPage_TheApplicationFormOnPushover}" />
                                    <Button x:Name="SavePushoverIconButton" Content="{loc:Loc SettingsPage_SaveTheRororoIcon}" Padding="10,5" Margin="6,0,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource SecondaryButtonStyle}" FontSize="{DynamicResource BodyFontSize}"
                                            AutomationProperties.Name="{loc:Loc SettingsPage_SaveTheRororoIconFor}"
                                            Click="OnSavePushoverIconClick"
                                            ToolTip="{loc:Loc SettingsPage_TheApplicationFormOnPushover}" />
                                </StackPanel>
                                <TextBlock Text="{loc:Loc SettingsPage_UserKey}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,0,0,2" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PushoverUserKeyInput" AutomationProperties.Name="{loc:Loc SettingsPage_PushoverUserKey}" Grid.Column="0" Padding="8,6" FontSize="{DynamicResource BodyFontSize}"
                                             Background="{DynamicResource NavyBrush}"
                                             PreviewKeyDown="OnCommitOnEnter" LostFocus="OnPushoverKeyCommitted" Style="{StaticResource AppTextBoxStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ToggleButton x:Name="PushoverUserKeyReveal" Content="{loc:Loc SettingsPage_Show}"
                                                      AutomationProperties.Name="{loc:Loc SettingsPage_ShowOrHideTheSaved}"
                                                      Margin="6,0,0,0" Padding="10,5" FontSize="{DynamicResource BodyFontSize}"
                                                      Checked="OnRevealPhoneToggled" Unchecked="OnRevealPhoneToggled"
                                                      Style="{StaticResource SecondaryToggleButtonStyle}"
                                                      ToolTip="{loc:Loc SettingsPage_RevealTheSavedKeySo}" />
                                        <Button x:Name="PushoverUserKeyRemove" Content="{loc:Loc SettingsPage_Remove}"
                                                Margin="6,0,0,0" Padding="10,5" FontSize="{DynamicResource BodyFontSize}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                AutomationProperties.Name="{loc:Loc SettingsPage_PushoverUserKey}"
                                                Click="OnRemoveSecretClick"
                                                ToolTip="{loc:Loc SettingsPage_DeletesTheSavedValue}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{loc:Loc SettingsPage_ApplicationToken}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,6,0,2" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PushoverAppTokenInput" AutomationProperties.Name="{loc:Loc SettingsPage_PushoverApplicationToken}" Grid.Column="0" Padding="8,6" FontSize="{DynamicResource BodyFontSize}"
                                             Background="{DynamicResource NavyBrush}"
                                             PreviewKeyDown="OnCommitOnEnter" LostFocus="OnPushoverKeyCommitted" Style="{StaticResource AppTextBoxStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ToggleButton x:Name="PushoverAppTokenReveal" Content="{loc:Loc SettingsPage_Show}"
                                                      AutomationProperties.Name="{loc:Loc SettingsPage_ShowOrHideTheSaved_2}"
                                                      Margin="6,0,0,0" Padding="10,5" FontSize="{DynamicResource BodyFontSize}"
                                                      Checked="OnRevealPhoneToggled" Unchecked="OnRevealPhoneToggled"
                                                      Style="{StaticResource SecondaryToggleButtonStyle}"
                                                      ToolTip="{loc:Loc SettingsPage_RevealTheSavedTokenSo}" />
                                        <Button x:Name="PushoverAppTokenRemove" Content="{loc:Loc SettingsPage_Remove}"
                                                Margin="6,0,0,0" Padding="10,5" FontSize="{DynamicResource BodyFontSize}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                AutomationProperties.Name="{loc:Loc SettingsPage_PushoverApplicationToken}"
                                                Click="OnRemoveSecretClick"
                                                ToolTip="{loc:Loc SettingsPage_DeletesTheSavedValue}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="PhonePushoverVerdict" FontSize="{DynamicResource BodyFontSize}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>

                            <StackPanel x:Name="NtfyFields" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                           Margin="0,0,0,4"
                                           Text="{loc:Loc SettingsPage_1GetTheFreeNtfy}" />
                                <TextBlock Text="{loc:Loc SettingsPage_Topic}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,0,0,2" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NtfyTopicInput" AutomationProperties.Name="{loc:Loc SettingsPage_NtfyTopic}" Grid.Column="0" Padding="8,6" FontSize="{DynamicResource BodyFontSize}"
                                             Background="{DynamicResource NavyBrush}" IsReadOnly="True"
                                             Style="{StaticResource AppTextBoxStyle}"/>
                                    <ToggleButton x:Name="NtfyTopicReveal" Grid.Column="1" Content="{loc:Loc SettingsPage_Show}"
                                                  AutomationProperties.Name="{loc:Loc SettingsPage_ShowOrHideTheNtfy}"
                                                  Margin="6,0,0,0" Padding="10,5" FontSize="{DynamicResource BodyFontSize}"
                                                  Checked="OnRevealPhoneToggled" Unchecked="OnRevealPhoneToggled"
                                                  Style="{StaticResource SecondaryToggleButtonStyle}"
                                                  ToolTip="{loc:Loc SettingsPage_RevealTheTopicSoYou}" />
                                    <Button x:Name="NtfyNewTopicButton" Grid.Column="2" Content="{loc:Loc SettingsPage_NewTopic}"
                                            Margin="6,0,0,0" Padding="10,5" FontSize="{DynamicResource BodyFontSize}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            AutomationProperties.Name="{loc:Loc SettingsPage_GenerateANewNtfyTopic}"
                                            Click="OnGenerateNtfyTopicClick"
                                            ToolTip="{loc:Loc SettingsPage_MakesAFreshRandomTopic}" />
                                </Grid>
                                <!-- The topic, scannable, so nobody retypes 33 base32 characters into
                                     a phone. This code IS the credential - an ntfy topic grants
                                     subscribe AND publish - so it is bound to the same reveal as the
                                     topic text and is force-hidden while streamer mode is on. The
                                     topic TEXT is not: revealing it and then turning streamer mode
                                     on leaves it showing. Same for both webhook URLs and the
                                     Pushover pair. This code is the only thing on the page that
                                     reads the streamer toggle at all. A QR is
                                     strictly MORE exposed than the string it replaces: a viewer can
                                     scan one off a single paused frame, which is not true of the
                                     text. See OnRevealPhoneToggled / RefreshNtfyQr. -->
                                <StackPanel x:Name="NtfyQrPanel" Visibility="Collapsed" Margin="0,10,0,0" HorizontalAlignment="Left">
                                    <Image x:Name="NtfyQrImage" Width="176" Height="176" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           AutomationProperties.Name="{loc:Loc SettingsPage_QrCodeThatSubscribesYour}" />
                                    <TextBlock Text="{loc:Loc SettingsPage_PointYourPhoneCameraAt}" TextWrapping="Wrap" MaxWidth="230"
                                               FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock Text="{loc:Loc SettingsPage_Server}" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}" Margin="0,6,0,2" />
                                <TextBox x:Name="NtfyServerInput" AutomationProperties.Name="{loc:Loc SettingsPage_NtfyServerAddress}" Padding="8,6" FontSize="{DynamicResource BodyFontSize}"
                                         Background="{DynamicResource NavyBrush}"
                                         PreviewKeyDown="OnCommitOnEnter" LostFocus="OnNtfyServerCommitted" Style="{StaticResource AppTextBoxStyle}"
                                         ToolTip="{loc:Loc SettingsPage_LeaveAsNtfyShUnless}" />
                                <TextBlock x:Name="PhoneNtfyVerdict" FontSize="{DynamicResource BodyFontSize}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>

                            <Button x:Name="PhoneTestButton" Content="{loc:Loc SettingsPage_TestMyPhone}" Padding="12,5" Margin="0,8,0,0"
                                    HorizontalAlignment="Left" Visibility="Collapsed"
                                    Style="{StaticResource SecondaryStrongButtonStyle}" FontSize="{DynamicResource BodyFontSize}"
                                    AutomationProperties.Name="{loc:Loc SettingsPage_SendATestNotificationTo}"
                                    Click="OnPhoneTestClick" />

                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageDiscord" Visibility="Collapsed">
                    <!-- v1.14+ Discord presence + Join (plan 2026-08-03). Off by default; the status
                         line reports the live connection state in plain words, never a stack trace. -->
                    <TextBlock Text="{loc:Loc SettingsPage_DiscordPresence}"
                               Style="{StaticResource SectionHeadingStyle}"
                               AutomationProperties.Name="{loc:Loc SettingsPage_DiscordPresence}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <CheckBox x:Name="DiscordPresenceToggle"
                                      Foreground="{DynamicResource WhiteBrush}" FontSize="{DynamicResource HeadingFontSize}" FontWeight="SemiBold"
                                      Click="OnDiscordPresenceToggle">
                                <TextBlock Text="{loc:Loc SettingsPage_ShowWhatYouRePlaying}" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="22,4,0,8"
                                       Text="{loc:Loc SettingsPage_YourDiscordStatusShowsThe}" />
                            <!-- Said here because otherwise every user who turns this on asks a friend
                                 "do you see it?", gets no, and files a bug. Discord gives the profile
                                 "playing" slot to a game it detects, and RoRoRo is an application, not
                                 a detected game — nothing we can toggle. Detection is earned by
                                 installs over time, so the last line is a real path, not a consolation. -->
                            <TextBlock FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="22,0,0,8"
                                       Text="{loc:Loc SettingsPage_WorthKnowingWhileRobloxIs}" />
                            <CheckBox x:Name="DiscordJoinToggle"
                                      Foreground="{DynamicResource WhiteBrush}" FontSize="{DynamicResource BodyFontSize}"
                                      Margin="22,0,0,0" Click="OnDiscordJoinToggle">
                                <TextBlock Text="{loc:Loc SettingsPage_LetFriendsJoinYourServer}" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock x:Name="DiscordStatusLine" FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource CyanBrush}" TextWrapping="Wrap" Margin="22,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                    <TextBlock Text="{loc:Loc SettingsPage_Theme}"
                               Style="{StaticResource SectionHeadingStyle}"
                               AutomationProperties.Name="{loc:Loc SettingsPage_Theme}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <!-- Only card on its page, so no bottom margin — the one place the shared
                         spacing is wrong rather than the one place someone forgot it. -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"
                                       Text="{loc:Loc SettingsPage_PickABuiltInOr}" />
                            <ComboBox x:Name="ThemePicker" AutomationProperties.Name="{loc:Loc SettingsPage_Theme}"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="OnThemeChanged"
                                      Padding="8,6"
                                      FontSize="{DynamicResource BodyFontSize}" />
                            <!-- One sentence per built-in, keyed by id via ThemeDescriptions.For.
                                 User themes return null: Collapsed, not Hidden, so no empty gap
                                 is left where the line would have been. -->
                            <TextBlock x:Name="ThemeDescriptionText"
                                       FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource AccentActionButtonStyle}" x:Name="BuildThemeButton"
                                        Content="{loc:Loc SettingsPage_BuildATheme}"
                                        HorizontalAlignment="Left"
                                        Padding="10,5" Margin="0,0,8,0"
                                        FontSize="{DynamicResource BodyFontSize}"
                                        Click="OnBuildThemeClick"
                                        ToolTip="{loc:Loc SettingsPage_OpenTheThemeBuilderCopy}" />
                                <Button x:Name="OpenThemesFolderButton"
                                        Content="{loc:Loc SettingsPage_OpenThemesFolder}"
                                        HorizontalAlignment="Left"
                                        Padding="10,5"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontSize="{DynamicResource BodyFontSize}"
                                        Click="OnOpenThemesFolderClick"
                                        ToolTip="{loc:Loc SettingsPage_DropAJsonFileIn}" />
                                <!-- The way back to the outline question (F-078, spec 4.3). It used
                                     to be asked once per theme and never again: EdgeRemediationWindow
                                     says so in its own source — "one reflexive click on the title-bar
                                     X must not permanently opt somebody's theme out of the fix
                                     without them reading a word of it — there is no re-ask affordance
                                     anywhere." This is that affordance.

                                     It stands on its own rather than reading "ask me again", because
                                     prd Story 1.4 requires it to be discoverable WITHOUT knowing the
                                     prompt ever happened. "Again" is a word only somebody who saw the
                                     first one can parse.

                                     It puts the same question through the same dialog and records
                                     the answer through the same setter — see OnReviewEdgeClick. -->
                                <Button x:Name="ReviewEdgeButton"
                                        Content="{loc:Loc SettingsPage_ReviewButtonOutlines}"
                                        HorizontalAlignment="Left"
                                        Padding="10,5" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontSize="{DynamicResource BodyFontSize}"
                                        AutomationProperties.Name="{loc:Loc SettingsPage_ReviewButtonOutlinesOnThis}"
                                        Click="OnReviewEdgeClick"
                                        ToolTip="{loc:Loc SettingsPage_SeeBothVersionsOfThis}" />
                            </StackPanel>
                            <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Text="{loc:Loc SettingsPage_ThemesPeopleWriteThemselvesSometimes}" />
                            <!-- This section's own failure line (spec 5), sibling to
                                 AlertsStatusLine and deliberately NOT dressed like it.
                                 AlertsStatusLine is CyanBrush, which is the accent — the same
                                 treatment a success gets — so a failure painted cyan would look
                                 like a save. RowExpiredAccentBrush and the U+25B2 prefix are the
                                 warning vocabulary v1.17 established across expired rows, idle
                                 chips, memory chips and the compat banner, and item 3's
                                 MemorySettingsWarning already speaks it. AlertsStatusLine itself is
                                 left alone; spec 10 records it as an open issue.

                                 Two things reach it: a theme that applied but could not be written
                                 down, and a file in the themes folder that could not be read. The
                                 text is composed by ThemeStatusSummary, which is where the copy is
                                 tested — nothing here decides what it says.

                                 Collapsed until there is something wrong. Success stays silent. -->
                            <TextBlock x:Name="ThemeStatusLine"
                                       FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource RowExpiredAccentBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       Visibility="Collapsed"
                                       AutomationProperties.Name="{loc:Loc SettingsPage_ThemeWarning}"
                                       AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </Border>

                    <!-- Language (localization, 2026-09-07). The picker is populated in code from
                         UiCulture.Available() — only languages whose catalog actually ships, so a
                         fresh build with no translated catalogs shows English alone. x:Static binds
                         once, so a change applies on the next launch; the hint says so. -->
                    <TextBlock Text="{loc:Loc SettingsPage_Language}"
                               Style="{StaticResource SectionHeadingStyle}"
                               Margin="0,20,0,0"
                               AutomationProperties.Name="{loc:Loc SettingsPage_Language}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"
                                       Text="{loc:Loc SettingsPage_LanguageHint}" />
                            <ComboBox x:Name="LanguagePicker"
                                      AutomationProperties.Name="{loc:Loc SettingsPage_Language}"
                                      DisplayMemberPath="DisplayName"
                                      HorizontalAlignment="Left"
                                      Width="220"
                                      Padding="8,6"
                                      SelectionChanged="OnUiLanguageChanged"
                                      FontSize="{DynamicResource BodyFontSize}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
