<Window x:Class="ROROROblox.App.Friends.FriendFollowWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ROROROblox.App.Controls"
        Height="640" Width="560"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Icon="/ROROROblox.App;component/Tray/Resources/tray-on.ico">

    <Window.Resources>
    </Window.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <controls:PageHeader x:Name="Header" />
            <TextBlock Text="Pick a friend to follow into their server. Roblox does the permission check — works for public AND private servers if your friend's privacy + server allowlist permit."
                       FontSize="{DynamicResource BodyFontSize}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />
            <Button Style="{StaticResource PrimaryButtonStyle}" x:Name="SourceSwitchButton"
                    HorizontalAlignment="Left"
                    Padding="12,5"
                    Margin="0,12,0,0"
                    FontSize="{DynamicResource BodyFontSize}"
                    Visibility="Collapsed"
                    Click="OnSourceSwitchClick" />
            <TextBlock x:Name="LauncherHint"
                       FontSize="{DynamicResource BodyFontSize}"
                       Foreground="{DynamicResource CyanBrush}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText"
                       FontSize="{DynamicResource BodyFontSize}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <Button Grid.Column="1" x:Name="RefreshButton"
                    Content="Refresh"
                    Padding="12,6"
                    Style="{StaticResource SecondaryStrongButtonStyle}"
                    FontSize="{DynamicResource BodyFontSize}"
                    Click="OnRefreshClick" />
        </Grid>

        <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FriendsList" />
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Click="OnCloseClick" Style="{StaticResource DialogCloseButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
