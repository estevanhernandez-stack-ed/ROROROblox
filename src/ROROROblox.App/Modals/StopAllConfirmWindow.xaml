<Window x:Class="ROROROblox.App.Modals.StopAllConfirmWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stop all Roblox instances"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/ROROROblox.App;component/Tray/Resources/tray-on.ico"
        Background="{DynamicResource BgBrush}">
    <!-- Tray "Stop all Roblox instances" confirm. Destructive (force-closes every running client),
         so it is confirm-gated. Cyan heading + magenta primary per the brand stakes pairing.
         CenterScreen (no owner) — the tray can fire this with the main window hidden. -->
    <Grid Margin="32">
        <!-- F-115: SizeToContent instead of a fixed height. The star row below was a SPACER that
             pushed the buttons to the bottom of a guessed frame, and it is what made clipping
             silent - a * row absorbs a shortfall by giving its child less than it asked for, so
             the layout succeeds and the text disappears. About shipped a trademark disclaimer cut
             mid-sentence that way (F-113). Every row is Auto now and the frame asks the content. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Stop all Roblox instances?"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource CyanBrush}" />

        <TextBlock Grid.Row="1"
                   x:Name="BodyText"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource BodyFontSize}"
                   Foreground="{DynamicResource WhiteBrush}"
                   Opacity="0.85"
                   Margin="0,12,0,0" />

        <!-- F-021's sibling, F-074. This was "UNSAVED GAME STATE WILL BE LOST" at 10px mono
             uppercase on #5A6982 — the smallest, dimmest, hardest-to-read text on the surface,
             carrying the worst news on it. Uppercase mono at 10px reads as a machine label, which
             is the register's point: the treatment said "footnote" while the words said
             "irreversible".
             It is now body prose at the same size as the body above it, and SemiBold at full
             opacity rather than the body's 0.85, so the consequence is the most legible thing in
             the dialog instead of the least. Colour is left as a literal deliberately: every
             foreground in this modal is one, and F-079 owns migrating the whole file rather than
             this cycle half-theming it. -->
        <TextBlock Grid.Row="2"
                   Text="Unsaved progress in your running games will be lost."
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource BodyFontSize}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource WhiteBrush}"
                   VerticalAlignment="Bottom"
                   Margin="0,16,0,0" />

        <!-- Cancel is the Enter-key default. A confirmation whose default IS the destructive action
             offers no protection against a reflexive Enter — the entire point of the confirm. "Stop
             all" requires a deliberate click. Guarded by ModalDefaultButtonSafetyTests.

             v1.18: "Stop all" is the third site DestructiveButtonStyle is assigned to by name (spec
             §6) — it halts every running client at once. It previously carried a raw magenta fill,
             described here as "magenta prominence". That reading does not survive the theme set: the
             fill was a literal, so it stayed brand magenta under all four built-ins, and under
             magenta-heat magenta is also the accent, so the loudest control in the confirm was the
             same colour as every ordinary CTA in the app. The rank now carries it in weight and edge
             instead, which is legible in flatline too. Cancel keeps its literal chrome — it is not on
             the enumerated list and F-079 owns this modal's remaining hexes. -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Padding="16,8" IsCancel="True" IsDefault="True"
                    Margin="0,0,8,0"
                    Click="OnCancelClick" />
            <Button Content="Stop all" Padding="16,8"
                    Style="{StaticResource DestructiveButtonStyle}"
                    Click="OnStopClick" />
        </StackPanel>
    </Grid>
</Window>
