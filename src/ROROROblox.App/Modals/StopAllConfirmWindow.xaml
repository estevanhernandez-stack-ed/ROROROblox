<Window x:Class="ROROROblox.App.Modals.StopAllConfirmWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stop all Roblox instances"
        Height="230" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/ROROROblox.App;component/Tray/Resources/tray-on.ico"
        Background="{DynamicResource BgBrush}">
    <!-- Tray "Stop all Roblox instances" confirm. Destructive (force-closes every running client),
         so it is confirm-gated. Cyan heading + magenta primary per the brand stakes pairing.
         CenterScreen (no owner) — the tray can fire this with the main window hidden. -->
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Stop all Roblox instances?"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#17D4FA" />

        <TextBlock Grid.Row="1"
                   x:Name="BodyText"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="#FFFFFF"
                   Opacity="0.85"
                   Margin="0,12,0,0" />

        <TextBlock Grid.Row="2"
                   Text="UNSAVED GAME STATE WILL BE LOST"
                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                   FontSize="10"
                   Foreground="#5A6982"
                   VerticalAlignment="Bottom"
                   Margin="0,16,0,0" />

        <!-- Cancel is the Enter-key default. A confirmation whose default IS the destructive action
             offers no protection against a reflexive Enter — the entire point of the confirm. "Stop
             all" requires a deliberate click. Guarded by ModalDefaultButtonSafetyTests.

             v1.18: "Stop all" is the third site DestructiveButtonStyle is assigned to by name (spec
             §6) — it halts every running client at once. It previously carried a raw magenta fill,
             described here as "magenta prominence". That reading does not survive the theme set: the
             fill was a literal, so it stayed brand magenta under all four built-ins, and under
             magenta-heat magenta is also the accent, so the loudest control in the confirm was the
             same colour as every ordinary CTA in the app. The rank now carries it in weight and edge
             instead, which is legible in flatline too. Cancel keeps its literal chrome — it is not on
             the enumerated list and F-079 owns this modal's remaining hexes. -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Padding="16,8" IsCancel="True" IsDefault="True"
                    Background="#22314A" Foreground="#FFFFFF" BorderThickness="0"
                    Margin="0,0,8,0"
                    Click="OnCancelClick" />
            <Button Content="Stop all" Padding="16,8"
                    Style="{StaticResource DestructiveButtonStyle}"
                    Click="OnStopClick" />
        </StackPanel>
    </Grid>
</Window>
