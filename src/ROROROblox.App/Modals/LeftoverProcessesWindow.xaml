<Window x:Class="ROROROblox.App.Modals.LeftoverProcessesWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Leftover Roblox processes"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="/ROROROblox.App;component/Tray/Resources/tray-on.ico"
        Background="{DynamicResource BgBrush}">
    <!-- LEFTOVER info modal. Non-blocking — RoRoRo already holds the multi-instance mutex by the
         time this shows; it just surfaces stale Roblox processes left over from a previous
         session so the user can optionally clean up (spec §5/§6). CenterScreen (no owner), same
         chrome as StopAllConfirmWindow. -->
    <Grid Margin="32">
        <!-- F-115: SizeToContent instead of a fixed height. The star row below was a SPACER that
             pushed the buttons to the bottom of a guessed frame, and it is what made clipping
             silent - a * row absorbs a shortfall by giving its child less than it asked for, so
             the layout succeeds and the text disappears. About shipped a trademark disclaimer cut
             mid-sentence that way (F-113). Every row is Auto now and the frame asks the content. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Leftover Roblox processes"
                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource CyanBrush}" />
        <TextBlock Grid.Row="1" x:Name="BodyText" TextWrapping="Wrap"
                   FontSize="12" Foreground="{DynamicResource WhiteBrush}" Opacity="0.85" Margin="0,12,0,0" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <!-- Stray-only cleanup: windowless orphans have nothing to lose (same reasoning as
                 SeamlessTakeover.WindowlessOnly), so no confirmation gate. Hidden entirely when
                 there are no windowless orphans to clear — see code-behind. -->
            <Button Style="{StaticResource SecondaryButtonStyle}" x:Name="ClearStraysButton" Content="Clear strays" Padding="16,8"
                    Margin="0,0,8,0" Click="OnClearStraysClick" />
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Clean up + continue" Padding="16,8"
                    Margin="0,0,8,0" Click="OnCleanUpClick" />
            <Button Style="{StaticResource CtaButtonStyle}" Content="Continue" Padding="16,8" IsDefault="True" IsCancel="True" Click="OnContinueClick" />
        </StackPanel>
    </Grid>
</Window>
