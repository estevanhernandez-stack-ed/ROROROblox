<Window x:Class="ROROROblox.App.Modals.FlaggedLaunchWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:ROROROblox.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Loc FlaggedLaunchWindow_Title}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="/ROROROblox.App;component/Tray/Resources/tray-on.ico"
        Background="{DynamicResource BgBrush}">
    <!-- Shown when a JoinViaFriend account is launched and can't follow the main: the main isn't
         in a joinable game, or the target is a server the main isn't in. A flagged account never
         joins directly on its own (it hits a captcha), so this asks instead of guessing. Every row
         is Auto and the frame asks the content (F-115). -->
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{loc:Loc FlaggedLaunchWindow_Title}"
                   FontSize="18" FontWeight="Bold"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource CyanBrush}" />

        <TextBlock Grid.Row="1"
                   x:Name="BodyText"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource BodyFontSize}"
                   Foreground="{DynamicResource WhiteBrush}"
                   Opacity="0.85"
                   Margin="0,12,0,0" />

        <TextBlock Grid.Row="2"
                   Text="{loc:Loc FlaggedLaunchWindow_FollowAnother}"
                   FontSize="{DynamicResource BodyFontSize}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource WhiteBrush}"
                   Margin="0,20,0,0" />

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      x:Name="OthersCombo"
                      AutomationProperties.Name="{loc:Loc FlaggedLaunchWindow_FollowAnother}"
                      VerticalAlignment="Center" />
            <TextBlock Grid.Column="0"
                       x:Name="NobodyJoinableText"
                       Text="{loc:Loc FlaggedLaunchWindow_NobodyJoinable}"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource BodyFontSize}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
            <Button Grid.Column="1"
                    x:Name="FollowButton"
                    Content="{loc:Loc FlaggedLaunchWindow_Follow}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="16,8" Margin="8,0,0,0"
                    Click="OnFollowClick" />
        </Grid>

        <!-- Cancel is the Enter-key default. "It's fixed" clears the account's join-via-friend flag
             and joins directly, which is exactly the captcha the flag exists to avoid if it isn't
             fixed, so a reflexive Enter must not be what does it. Guarded by
             ModalDefaultButtonSafetyTests. -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="{loc:Loc FlaggedLaunchWindow_Cancel}"
                    Style="{StaticResource SecondaryStrongButtonStyle}"
                    Padding="16,8" Margin="0,0,8,0"
                    IsCancel="True" IsDefault="True"
                    Click="OnCancelClick" />
            <Button Content="{loc:Loc FlaggedLaunchWindow_ItsFixed}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="16,8"
                    Click="OnItsFixedClick" />
        </StackPanel>
    </Grid>
</Window>
