<Window x:Class="ROROROblox.App.Modals.RenameWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="24">
        <!-- F-115: SizeToContent instead of a fixed height. The star row below was a SPACER that
             pushed the buttons to the bottom of a guessed frame, and it is what made clipping
             silent - a * row absorbs a shortfall by giving its child less than it asked for, so
             the layout succeeds and the text disappears. About shipped a trademark disclaimer cut
             mid-sentence that way (F-113). Every row is Auto now and the frame asks the content. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title heading — matches the cyan h2 the other modals open with. -->
        <TextBlock Grid.Row="0"
                   Text="Rename"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource CyanBrush}" />

        <!-- Mono-micro reference: ROBLOX NAME — {OriginalName}. The mono-stack falls back through
             JetBrains Mono → Cascadia Mono → Consolas; users who don't have JetBrains Mono
             installed get Cascadia (Win11 default). Brand-aligned uppercase + tracking. -->
        <TextBlock Grid.Row="1"
                   x:Name="OriginalNameLine"
                   FontFamily="{DynamicResource MonoFontFamily}"
                   FontSize="{DynamicResource MetaFontSize}"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Margin="0,12,0,4"
                   TextTrimming="CharacterEllipsis" />

        <!-- The actual rename input. Pre-filled by code-behind with CurrentLocalName ?? OriginalName.
             Focused on load with all-text-selected for fast retype. -->
        <TextBox Grid.Row="2"
                 x:Name="NameTextBox"
                 FontSize="{DynamicResource HeadingFontSize}"
                 Padding="8,6"
                 MaxLines="1"
                 Background="{DynamicResource RowBgBrush}"
                 CaretBrush="{DynamicResource CyanBrush}" Style="{StaticResource AppTextBoxStyle}"/>

        <!-- Reset hyperlink — visible only when CurrentLocalName != null. Code-behind sets
             Visibility on construct. Magenta-tinted to read as a destructive-ish tertiary. -->
        <TextBlock Grid.Row="3"
                   x:Name="ResetRow"
                   Margin="0,8,0,0"
                   Visibility="Collapsed"
                   FontSize="{DynamicResource BodyFontSize}">
            <Hyperlink x:Name="ResetLink"
                       Foreground="{DynamicResource MagentaBrush}"
                       Click="OnResetClick"
                       TextDecorations="None">
                Reset to original
            </Hyperlink>
        </TextBlock>

        <!-- Buttons row — matches the existing modal button styling. Save = cyan-fill, Cancel = ghost. -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Padding="16,8" Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button Style="{StaticResource CtaButtonStyle}" Content="Save" Padding="16,8"
                    IsDefault="True"
                    Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
