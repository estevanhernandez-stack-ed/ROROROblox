<Window x:Class="ROROROblox.App.Modals.WebView2NotInstalledWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:ROROROblox.App.Properties"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{x:Static loc:Strings.WebView2NotInstalledWindow_MicrosoftWebview2Needed}"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="32">
        <!-- F-115: SizeToContent instead of a fixed height. The star row below was a SPACER that
             pushed the buttons to the bottom of a guessed frame, and it is what made clipping
             silent - a * row absorbs a shortfall by giving its child less than it asked for, so
             the layout succeeds and the text disappears. About shipped a trademark disclaimer cut
             mid-sentence that way (F-113). Every row is Auto now and the frame asks the content. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{x:Static loc:Strings.WebView2NotInstalledWindow_MicrosoftWebview2Needed}"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource CyanBrush}" />

        <TextBlock Grid.Row="1"
                   Text="{x:Static loc:Strings.WebView2NotInstalledWindow_RororoUsesMicrosoftSWebview2}"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource BodyFontSize}"
                   Foreground="{DynamicResource WhiteBrush}"
                   Opacity="0.85"
                   Margin="0,12,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButtonStyle}" x:Name="LearnMoreButton" Content="{x:Static loc:Strings.WebView2NotInstalledWindow_LearnMore}" Padding="16,8" Margin="0,0,8,0"
                    Click="OnLearnMoreClick" />
            <Button Style="{StaticResource CtaButtonStyle}" x:Name="InstallButton" Content="{x:Static loc:Strings.WebView2NotInstalledWindow_InstallNow}" Padding="16,8" IsDefault="True"
                    Click="OnInstallClick" />
        </StackPanel>
    </Grid>
</Window>
