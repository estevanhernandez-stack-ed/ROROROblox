<Window x:Class="ROROROblox.App.Modals.RobloxNotInstalledWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roblox needed"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="32">
        <!-- F-115: SizeToContent instead of a fixed height. The star row below was a SPACER that
             pushed the buttons to the bottom of a guessed frame, and it is what made clipping
             silent - a * row absorbs a shortfall by giving its child less than it asked for, so
             the layout succeeds and the text disappears. About shipped a trademark disclaimer cut
             mid-sentence that way (F-113). Every row is Auto now and the frame asks the content. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Roblox doesn't appear to be installed"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource MagentaBrush}" />

        <TextBlock Grid.Row="1"
                   Text="RoRoRo launches Roblox via the standard roblox-player: handler. We can't find that handler on this PC, which usually means Roblox isn't installed yet."
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource BodyFontSize}"
                   Foreground="{DynamicResource WhiteBrush}"
                   Opacity="0.85"
                   Margin="0,12,0,0" />

        <TextBlock Grid.Row="2"
                   Text="If you use Bloxstrap, make sure it's set as the default Roblox launcher in its settings — Bloxstrap should also handle our launches."
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource BodyFontSize}"
                   Foreground="{DynamicResource WhiteBrush}"
                   Opacity="0.7"
                   Margin="0,8,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Open Bloxstrap setup" Padding="16,8" Margin="0,0,8,0"
                    Click="OnBloxstrapClick" />
            <Button Style="{StaticResource CtaButtonStyle}" Content="Download Roblox" Padding="16,8" IsDefault="True"
                    Click="OnDownloadClick" />
        </StackPanel>
    </Grid>
</Window>
