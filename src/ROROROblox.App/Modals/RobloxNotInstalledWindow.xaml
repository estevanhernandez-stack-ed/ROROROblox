<Window x:Class="ROROROblox.App.Modals.RobloxNotInstalledWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:ROROROblox.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Loc RobloxNotInstalledWindow_RobloxNeeded}"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="32">
        <!-- F-115: SizeToContent instead of a fixed height. The star row below was a SPACER that
             pushed the buttons to the bottom of a guessed frame, and it is what made clipping
             silent - a * row absorbs a shortfall by giving its child less than it asked for, so
             the layout succeeds and the text disappears. About shipped a trademark disclaimer cut
             mid-sentence that way (F-113). Every row is Auto now and the frame asks the content. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{loc:Loc RobloxNotInstalledWindow_RobloxDoesnTAppearTo}"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource MagentaBrush}" />

        <!-- 2026-11-10: the Microsoft Store edition of Roblox registers roblox: and never
             roblox-player:, so its owner reads "Roblox isn't installed" while looking at Roblox.
             Shown only when that edition's package folder is found; it leads the body because it
             is the one sentence that explains what the person is seeing. -->
        <TextBlock x:Name="StoreEditionLine"
                   Grid.Row="1"
                   Visibility="Collapsed"
                   Text="{loc:Loc RobloxNotInstalledWindow_StoreEditionFound}"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource BodyFontSize}"
                   Foreground="{DynamicResource WhiteBrush}"
                   Margin="0,12,0,0" />

        <TextBlock Grid.Row="2"
                   Text="{loc:Loc RobloxNotInstalledWindow_RororoLaunchesRobloxViaThe}"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource BodyFontSize}"
                   Foreground="{DynamicResource WhiteBrush}"
                   Opacity="0.85"
                   Margin="0,12,0,0" />

        <TextBlock Grid.Row="3"
                   Text="{loc:Loc RobloxNotInstalledWindow_IfYouUseBloxstrapMake}"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource BodyFontSize}"
                   Foreground="{DynamicResource WhiteBrush}"
                   Opacity="0.7"
                   Margin="0,8,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{loc:Loc RobloxNotInstalledWindow_OpenBloxstrapSetup}" Padding="16,8" Margin="0,0,8,0"
                    Click="OnBloxstrapClick" />
            <Button Style="{StaticResource CtaButtonStyle}" Content="{loc:Loc RobloxNotInstalledWindow_DownloadRoblox}" Padding="16,8" IsDefault="True"
                    Click="OnDownloadClick" />
        </StackPanel>
    </Grid>
</Window>
