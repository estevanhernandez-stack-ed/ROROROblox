<UserControl x:Class="ROROROblox.App.About.AboutPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CyanBrightBrush" Color="#6CEAFD" />
        <SolidColorBrush x:Key="CyanDimBrush" Color="#12BFE3" />
        <SolidColorBrush x:Key="CyanShadowBrush" Color="#0D94B8" />
        <SolidColorBrush x:Key="MagentaDimBrush" Color="#F22F89" />
        <SolidColorBrush x:Key="MagentaShadowBrush" Color="#B81F66" />
        <SolidColorBrush x:Key="NavySoftBrush" Color="#0F1F31" />
        <SolidColorBrush x:Key="TealBrush" Color="#2EE6C9" />
        <SolidColorBrush x:Key="TealDeepBrush" Color="#1A9F8B" />
    </UserControl.Resources>

    <!-- F-113's lesson, carried into the shell (this content was AboutWindow, which grew its frame
         with SizeToContent). A page cannot grow the shell, so the page scrolls: clipping the
         trademark disclaimer silently is the exact failure that row recorded, and a fixed host
         plus no scroll would rebuild it. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="4,0,4,0" MaxWidth="560" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hero: inline iso voxel stack + wordmark + version + tagline + Easter-egg slot -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <!-- Direction C iso voxel stack (Canvas, 64x64). Painter's order: bottom -> middle -> top.
                     The GROUND is themed; the MARK is not. The nine polygon faces below are brand
                     identity artwork in the same category as the per-account caption palette — they
                     paint WHO this is, not WHAT STATE it is in, and a themed logo is a broken logo.
                     The Canvas fill is the plate they sit on, and it is bound rather than removed on
                     purpose: the faces are fixed dark-on-light-agnostic hexes, so on a light user theme
                     a missing plate would leave the mark floating on white with no ground. The four
                     built-in themes are all dark and would never reveal that. -->
                <Canvas Width="64" Height="64" Margin="0,0,18,0" Background="{DynamicResource RowBgBrush}">
                    <!-- Bottom block (teal) -->
                    <Polygon Fill="{StaticResource TealBrush}"
                             Points="16,36.5 32,30.5 48,36.5 32,42.5" />
                    <Polygon Fill="{StaticResource TealDeepBrush}"
                             Points="16,36.5 32,42.5 32,51.5 16,45.5" />
                    <Polygon Fill="{StaticResource TealBrush}"
                             Points="32,42.5 48,36.5 48,45.5 32,51.5" />
                    <!-- Middle block (magenta). This top face was bound to the MagentaBrush THEME SLOT
                         until v1.21 item 4 — a theme token inside the mark. It now takes
                         MagentaDimBrush, the same value brand resolved that slot to, so every theme
                         renders the mark identically. Top and right sharing one brush over a darker
                         left is the three-face pattern the teal block already uses.
                         THIS FACE IS OCCLUDED and paints nothing: in an isometric stack only the
                         topmost block shows its top face, and the cyan block above covers this one
                         entirely. Measured 2026-08-12 by painting it #00FF00 and rendering the real
                         window — zero green pixels. So the bind is hygiene rather than a visible fix,
                         and it matters only if the stack is ever reordered or a block removed. Item 4
                         claimed a visible grey top under flatline; that was asserted from reading
                         markup and is not true.
                         Ratios and per-theme values live in F-063's register row, not here. A comment
                         naming a shipped colour is a claim that goes false the moment a theme changes
                         that value; the literal scanner stopped reading comments in v1.20, so this is a
                         convention now rather than something enforced. -->
                    <Polygon Fill="{StaticResource MagentaDimBrush}"
                             Points="16,27.5 32,21.5 48,27.5 32,33.5" />
                    <Polygon Fill="{StaticResource MagentaShadowBrush}"
                             Points="16,27.5 32,33.5 32,42.5 16,36.5" />
                    <Polygon Fill="{StaticResource MagentaDimBrush}"
                             Points="32,33.5 48,27.5 48,36.5 32,42.5" />
                    <!-- Top block (cyan-bright) -->
                    <Polygon Fill="{StaticResource CyanBrightBrush}"
                             Points="16,18.5 32,12.5 48,18.5 32,24.5" />
                    <Polygon Fill="{StaticResource CyanShadowBrush}"
                             Points="16,18.5 32,24.5 32,33.5 16,27.5" />
                    <Polygon Fill="{StaticResource CyanDimBrush}"
                             Points="32,24.5 48,18.5 48,27.5 32,33.5" />
                </Canvas>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RoRoRo"
                                   FontFamily="{DynamicResource DisplayFontFamily}"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource CyanBrush}" />
                        <TextBlock Text=" / "
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource MagentaBrush}" />
                        <TextBlock x:Name="VersionText"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource WhiteBrush}"
                                   Cursor="Hand"
                                   ToolTip="Version"
                                   MouseLeftButtonDown="OnVersionClicked" />
                    </StackPanel>
                    <TextBlock Text="Multi-launcher for Windows."
                               FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                               Foreground="{DynamicResource CyanBrush}"
                               Margin="0,4,0,0" />
                    <TextBlock Text="A 626 Labs product"
                               FontSize="{DynamicResource MetaFontSize}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,2,0,0" />
                    <TextBlock x:Name="EasterEggText"
                               Text="Koii 4 eva"
                               FontSize="{DynamicResource HeadingFontSize}" FontWeight="SemiBold"
                               Foreground="{DynamicResource MagentaBrush}"
                               Margin="0,8,0,0"
                               Visibility="Collapsed"
                               Opacity="0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#F22F89" BlurRadius="14" ShadowDepth="0" Opacity="0.85" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Margin="0,24,0,0" Padding="16,14"
                    Background="{DynamicResource RowBgBrush}" CornerRadius="8">
                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource WhiteBrush}">
                    Run multiple Roblox clients side by side, signed in as different saved accounts.
                    Holds the Roblox singleton mutex so subsequent clients don't fight for it; uses
                    Roblox's documented authentication-ticket flow for per-account launches. Clean
                    reimplementation; not a fork.
                </TextBlock>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <TextBlock Text="Links" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                           Foreground="{DynamicResource CyanBrush}" Margin="0,0,0,6" />
                <TextBlock FontSize="{DynamicResource BodyFontSize}" Margin="0,0,0,4">
                    <Hyperlink x:Name="RepoLink" Foreground="{DynamicResource WhiteBrush}"
                               Click="OnRepoClick">github.com/estevanhernandez-stack-ed/ROROROblox</Hyperlink>
                </TextBlock>
                <TextBlock FontSize="{DynamicResource BodyFontSize}" Margin="0,0,0,4">
                    <Hyperlink x:Name="IssuesLink" Foreground="{DynamicResource WhiteBrush}"
                               Click="OnIssuesClick">Report an issue</Hyperlink>
                </TextBlock>
                <TextBlock FontSize="{DynamicResource BodyFontSize}" Margin="0,0,0,4">
                    <Hyperlink x:Name="LicenseLink" Foreground="{DynamicResource WhiteBrush}"
                               Click="OnLicenseClick">Open log folder</Hyperlink>
                </TextBlock>
                <!-- F-039. The tour explains six row affordances that carry no labels, and it is shown
                     once, on a first run that by definition has no rows in it. Sits beside Open log
                     folder because that entry is an action too — this list has never been only links. -->
                <TextBlock FontSize="{DynamicResource BodyFontSize}">
                    <Hyperlink x:Name="WelcomeTourLink" Foreground="{DynamicResource WhiteBrush}"
                               Click="OnWelcomeTourClick">Show the welcome tour</Hyperlink>
                </TextBlock>

                <!-- F-112's discoverable half. Rendered FROM KeyboardVocabulary.Shortcuts (set in
                     code-behind), the same table both windows build their KeyBindings from — the
                     list a user reads and the binding that fires cannot drift apart. F1 lands
                     here from either window. -->
                <TextBlock Text="Keyboard shortcuts" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                           Foreground="{DynamicResource CyanBrush}" Margin="0,20,0,6" />
                <ItemsControl x:Name="ShortcutsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding GestureText}"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="{DynamicResource MetaFontSize}"
                                           Foreground="{DynamicResource WhiteBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Label}"
                                           FontSize="{DynamicResource BodyFontSize}"
                                           Foreground="{DynamicResource WhiteBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource MetaFontSize}" Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap">
                    Inside the tools window, Ctrl+1 through Ctrl+6 also jump straight to a page.
                </TextBlock>

                <TextBlock Margin="0,16,0,0" FontSize="{DynamicResource MetaFontSize}" Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap">
                    Cookies are encrypted with Windows DPAPI per user. They never leave this machine.
                    A copy of accounts.dat moved to another PC will not decrypt.
                </TextBlock>
                <TextBlock Margin="0,8,0,0" FontSize="{DynamicResource MetaFontSize}" Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap">
                    "Roblox" is a trademark of Roblox Corporation. RoRoRo is not affiliated with,
                    endorsed by, or sponsored by Roblox Corporation.
                </TextBlock>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
