<Window x:Class="ROROROblox.App.About.WelcomeWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:ROROROblox.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Loc WelcomeWindow_WelcomeToRororo}"
        AutomationProperties.AutomationId="WelcomeWindow"
        Height="760" Width="600"
        WindowStartupLocation="CenterOwner"
        MinHeight="600" MinWidth="520" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        Icon="/ROROROblox.App;component/Tray/Resources/tray-on.ico">

    <Window.Resources>
        <Style x:Key="StepStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource RowBgBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="StepNumberStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CyanBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Loc WelcomeWindow_WelcomeTo}"
                           FontFamily="{DynamicResource DisplayFontFamily}" FontSize="{DynamicResource DisplayFontSize}" FontWeight="Bold"
                           Foreground="{DynamicResource WhiteBrush}" />
                <TextBlock Text="{loc:Loc WelcomeWindow_Rororo}"
                           FontFamily="{DynamicResource DisplayFontFamily}" FontSize="{DynamicResource DisplayFontSize}" FontWeight="Bold"
                           Foreground="{DynamicResource CyanBrush}" />
            </StackPanel>
            <TextBlock Text="{loc:Loc WelcomeWindow_RunMultipleRobloxClientsSide}"
                       FontSize="{DynamicResource BodyFontSize}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource StepStyle}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StepNumberStyle}">
                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Foreground="{DynamicResource NavyBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc WelcomeWindow_ClickAddAccount}"
                                   FontSize="{DynamicResource HeadingFontSize}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WhiteBrush}" />
                        <TextBlock Text="{loc:Loc WelcomeWindow_SignInToRobloxCom}"
                                   FontSize="{DynamicResource BodyFontSize}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StepStyle}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StepNumberStyle}">
                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Foreground="{DynamicResource NavyBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc WelcomeWindow_OpenGamesAndAddThe}"
                                   FontSize="{DynamicResource HeadingFontSize}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WhiteBrush}" />
                        <TextBlock Text="{loc:Loc WelcomeWindow_SearchByNameOrPaste}"
                                   FontSize="{DynamicResource BodyFontSize}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StepStyle}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StepNumberStyle}">
                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Foreground="{DynamicResource NavyBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc WelcomeWindow_ClickLaunchAsOrLaunch}"
                                   FontSize="{DynamicResource HeadingFontSize}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WhiteBrush}" />
                        <TextBlock Text="{loc:Loc WelcomeWindow_MultiInstanceIsOnBy}"
                                   FontSize="{DynamicResource BodyFontSize}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource RowBgBrush}"
                    CornerRadius="8" Padding="14,10"
                    Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc WelcomeWindow_QuickTipsForTheRow}"
                               FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                               Foreground="{DynamicResource CyanBrush}"
                               Margin="0,0,0,6" />
                    <TextBlock FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,3">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource WhiteBrush}" Text="&#x2630;" />
                        <Run Text="{loc:Loc WelcomeWindow_OnTheLeftOfA}" />
                    </TextBlock>
                    <TextBlock FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,3">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource MagentaBrush}" Text="&#x2605;" />
                        <Run Text="{loc:Loc WelcomeWindow_StarNextToARow}" />
                    </TextBlock>
                    <TextBlock FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,3">
                        <Run Text="{loc:Loc WelcomeWindow_TheColoredSwatchNextTo}" />
                    </TextBlock>
                    <TextBlock FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,3">
                        <Run Text="{loc:Loc WelcomeWindow_TheDotLabeled}" />
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource WhiteBrush}" Text="{loc:Loc WelcomeWindow_InBatches}" />
                        <Run Text=" / " />
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource WhiteBrush}" Text="{loc:Loc WelcomeWindow_Skipped}" />
                        <Run Text="{loc:Loc WelcomeWindow_TogglesWhetherThisAccountJoins}" />
                    </TextBlock>
                    <TextBlock FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,3">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource WhiteBrush}" Text="{loc:Loc WelcomeWindow_Follow}" />
                        <Run Text="{loc:Loc WelcomeWindow_ChipsBelowAnAccountClick}" />
                    </TextBlock>
                    <TextBlock FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,3">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource WhiteBrush}" Text="{loc:Loc WelcomeWindow_Compact}" />
                        <Run Text="{loc:Loc WelcomeWindow_ButtonAtTheBottomLeft}" />
                    </TextBlock>
                    <TextBlock FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" Text="{loc:Loc WelcomeWindow_ClosingXMinimizesToTray}" />
                    <TextBlock FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0">
                        <Run Text="{loc:Loc WelcomeWindow_WindowsHidesNewTrayIcons}" />
                        <Run Text="{loc:Loc WelcomeWindow_ClickThe}" />
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource WhiteBrush}" Text="^" />
                        <Run Text="{loc:Loc WelcomeWindow_InTheSystemTrayAnd}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource CtaButtonStyle}" Content="{loc:Loc WelcomeWindow_GotIt}" Padding="22,8"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
