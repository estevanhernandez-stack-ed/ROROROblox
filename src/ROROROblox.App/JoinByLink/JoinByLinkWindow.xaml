<Window x:Class="ROROROblox.App.JoinByLink.JoinByLinkWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Join by link"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Icon="/ROROROblox.App;component/Tray/Resources/tray-on.ico">

    <Window.Resources>
    </Window.Resources>

    <Grid Margin="28,24">
        <!-- F-115: SizeToContent instead of a fixed height. The star row below was a SPACER that
             pushed the buttons to the bottom of a guessed frame, and it is what made clipping
             silent - a * row absorbs a shortfall by giving its child less than it asked for, so
             the layout succeeds and the text disappears. About shipped a trademark disclaimer cut
             mid-sentence that way (F-113). Every row is Auto now and the frame asks the content. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Join by link"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource CyanBrush}" />
                <TextBlock x:Name="AccountSubtitle"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource WhiteBrush}"
                           Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="Paste a Roblox game URL or a private server share link. We figure out which kind it is."
                       FontSize="11"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="UrlInput"
                 Padding="10,8" FontSize="12" Margin="0,18,0,0"
                 Background="{DynamicResource RowBgBrush}"
                 VerticalContentAlignment="Center"
                 TextChanged="OnUrlChanged" Style="{StaticResource AppTextBoxStyle}"/>

        <Border Grid.Row="2" Margin="0,12,0,0"
                Background="{DynamicResource RowBgBrush}"
                CornerRadius="6"
                Padding="12,10"
                Visibility="Collapsed"
                x:Name="PreviewBorder">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="PreviewLabel"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource CyanBrush}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="PreviewDetail"
                           FontSize="11"
                           Foreground="{DynamicResource WhiteBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusText"
                   FontSize="11"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top" />

        <CheckBox Grid.Row="4" x:Name="SaveCheckBox"
                  Content="Save to my games"
                  Foreground="{DynamicResource WhiteBrush}"
                  Margin="0,12,0,0"
                  ToolTip="Add this game or private server to your saved games so it shows up next time without retyping." />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Padding="14,8" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryStrongButtonStyle}"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button Style="{StaticResource CtaButtonStyle}" x:Name="LaunchButton"
                    Content="Launch"
                    Padding="18,8"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="OnLaunchClick" />
        </StackPanel>
    </Grid>
</Window>
