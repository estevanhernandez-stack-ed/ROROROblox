<Window x:Class="ROROROblox.App.Theming.ThemeBuilderWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:ROROROblox.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ROROROblox.App.Controls"
        Title="{loc:Loc ThemeBuilderWindow_BuildATheme}"
        Height="640" Width="640"
        MinHeight="500" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Icon="/ROROROblox.App;component/Tray/Resources/tray-on.ico">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <controls:PageHeader Heading="{loc:Loc ThemeBuilderWindow_BuildATheme}" />
            <TextBlock TextWrapping="Wrap"
                       FontSize="{DynamicResource BodyFontSize}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,4,0,0"
                       Text="{loc:Loc ThemeBuilderWindow_Step1CopyTheAi}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{loc:Loc ThemeBuilderWindow_1AiPrompt}"
                       FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                       Foreground="{DynamicResource WhiteBrush}"
                       VerticalAlignment="Center" />
            <Button Style="{StaticResource CtaButtonStyle}" Grid.Column="1"
                    x:Name="CopyPromptButton"
                    Content="{loc:Loc ThemeBuilderWindow_CopyAiPrompt}"
                    Padding="12,6"
                    FontSize="{DynamicResource BodyFontSize}"
                    Click="OnCopyPromptClick"
                    ToolTip="{loc:Loc ThemeBuilderWindow_CopiesThePromptToYour}" />
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource RowBgBrush}" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{loc:Loc ThemeBuilderWindow_2PasteTheJsonThe}"
                           FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                           Foreground="{DynamicResource WhiteBrush}"
                           Margin="0,0,0,8" />
                <TextBox Grid.Row="1"
                         x:Name="JsonInput" AutomationProperties.Name="{loc:Loc ThemeBuilderWindow_ThemeJson}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="{DynamicResource MonoFontFamily}"
                         FontSize="{DynamicResource BodyFontSize}"
                         Background="{DynamicResource NavyBrush}"
                         CaretBrush="{DynamicResource CyanBrush}"
                         Padding="10"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Style="{StaticResource AppTextBoxStyle}"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   x:Name="StatusText"
                   FontSize="{DynamicResource BodyFontSize}"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OpenFolderButton"
                    Content="{loc:Loc ThemeBuilderWindow_OpenThemesFolder}"
                    Padding="12,8" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OnOpenFolderClick" />
            <Button Content="{loc:Loc ThemeBuilderWindow_Cancel}" Padding="14,8" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryStrongButtonStyle}"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button Style="{StaticResource CtaButtonStyle}" x:Name="SaveButton"
                    Content="{loc:Loc ThemeBuilderWindow_SaveAndApply}"
                    Padding="18,8"
                    IsDefault="True"
                    Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
