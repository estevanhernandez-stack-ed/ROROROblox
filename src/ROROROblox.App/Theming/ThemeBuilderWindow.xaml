<Window x:Class="ROROROblox.App.Theming.ThemeBuilderWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:ROROROblox.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ROROROblox.App.Controls"
        Title="{loc:Loc ThemeBuilderWindow_BuildATheme}"
        AutomationProperties.AutomationId="ThemeBuilderWindow"
        Height="640" Width="640"
        MinHeight="500" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Icon="/ROROROblox.App;component/Tray/Resources/tray-on.ico">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <controls:PageHeader Heading="{loc:Loc ThemeBuilderWindow_BuildATheme}" />
            <TextBlock TextWrapping="Wrap"
                       FontSize="{DynamicResource BodyFontSize}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,4,0,0"
                       Text="{loc:Loc ThemeBuilderWindow_Step1CopyTheAi}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{loc:Loc ThemeBuilderWindow_1AiPrompt}"
                       FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                       Foreground="{DynamicResource WhiteBrush}"
                       VerticalAlignment="Center" />
            <Button Style="{StaticResource CtaButtonStyle}" Grid.Column="1"
                    x:Name="CopyPromptButton"
                    Content="{loc:Loc ThemeBuilderWindow_CopyAiPrompt}"
                    Padding="12,6"
                    FontSize="{DynamicResource BodyFontSize}"
                    Click="OnCopyPromptClick"
                    ToolTip="{loc:Loc ThemeBuilderWindow_CopiesThePromptToYour}" />
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource RowBgBrush}" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{loc:Loc ThemeBuilderWindow_2PasteTheJsonThe}"
                           FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                           Foreground="{DynamicResource WhiteBrush}"
                           Margin="0,0,0,8" />
                <TextBox Grid.Row="1"
                         x:Name="JsonInput" AutomationProperties.Name="{loc:Loc ThemeBuilderWindow_ThemeJson}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="{DynamicResource MonoFontFamily}"
                         FontSize="{DynamicResource BodyFontSize}"
                         Background="{DynamicResource NavyBrush}"
                         CaretBrush="{DynamicResource CyanBrush}"
                         Padding="10"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Style="{StaticResource AppTextBoxStyle}"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   x:Name="StatusText"
                   FontSize="{DynamicResource BodyFontSize}"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap" />

        <!-- Two rows (task kw9psaaah, 2026-11-26): the five buttons on one right-aligned row ran past the left edge
             in every language, English included, and French needs more than the minimum width for the three
             folder/share/import buttons alone. Those wrap on their own row; Cancel and Save sit right, beneath.
             ThemeBuilderButtonRowFitTests holds every button inside the window at 640 and 540 in seven languages. -->
        <Grid Grid.Row="4" x:Name="ButtonRow" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" HorizontalAlignment="Left">
                <Button x:Name="OpenFolderButton"
                        Content="{loc:Loc ThemeBuilderWindow_OpenThemesFolder}"
                        Padding="12,8" Margin="0,0,8,8"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnOpenFolderClick" />
                <Button x:Name="ShareThemeButton"
                        Content="{loc:Loc ThemeShare_ShareButton}"
                        AutomationProperties.Name="{loc:Loc ThemeShare_ShareButtonAccessible}"
                        Padding="12,8" Margin="0,0,8,8"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnShareThemeClick" />
                <Button x:Name="ImportThemeButton"
                        Content="{loc:Loc ThemeShare_ImportButton}"
                        AutomationProperties.Name="{loc:Loc ThemeShare_ImportButtonAccessible}"
                        Padding="12,8" Margin="0,0,8,8"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnImportThemeClick" />
            </WrapPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Content="{loc:Loc ThemeBuilderWindow_Cancel}" Padding="14,8" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryStrongButtonStyle}"
                        IsCancel="True"
                        Click="OnCancelClick" />
                <Button Style="{StaticResource CtaButtonStyle}" x:Name="SaveButton"
                        Content="{loc:Loc ThemeBuilderWindow_SaveAndApply}"
                        Padding="18,8"
                        IsDefault="True"
                        Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
