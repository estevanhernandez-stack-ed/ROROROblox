<Window x:Class="ROROROblox.App.Theming.CaptionColorPickerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a title-bar color"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Icon="/ROROROblox.App;component/Tray/Resources/tray-on.ico">

    <Grid Margin="20,18">
        <!-- F-115: SizeToContent instead of a fixed height. The star row below was a SPACER that
             pushed the buttons to the bottom of a guessed frame, and it is what made clipping
             silent - a * row absorbs a shortfall by giving its child less than it asked for, so
             the layout succeeds and the text disappears. About shipped a trademark disclaimer cut
             mid-sentence that way (F-113). Every row is Auto now and the frame asks the content. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="HeaderText"
                   FontSize="{DynamicResource HeadingFontSize}" FontWeight="SemiBold"
                   Foreground="{DynamicResource WhiteBrush}" />

        <TextBlock Grid.Row="1"
                   Text="Click a swatch to apply. The Roblox window updates within ~1.5s."
                   FontSize="{DynamicResource BodyFontSize}"
                   Foreground="{DynamicResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,12" />

        <!-- Preset palette. 8 swatches + Auto, in 3 rows of 3. -->
        <UniformGrid Grid.Row="2" Columns="5" Rows="2" x:Name="SwatchGrid" Margin="0,0,0,12" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Custom hex:"
                       FontSize="{DynamicResource BodyFontSize}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBox Grid.Column="1"
                     x:Name="HexInput"
                     FontFamily="{DynamicResource MonoFontFamily}"
                     FontSize="{DynamicResource BodyFontSize}"
                     Padding="8,5"
                     Background="{DynamicResource NavyBrush}"
                     CaretBrush="{DynamicResource CyanBrush}" Style="{StaticResource AppTextBoxStyle}"/>
            <Button Style="{StaticResource CtaButtonStyle}" Grid.Column="2"
                    x:Name="ApplyHexButton"
                    Content="Apply"
                    Padding="12,5" Margin="6,0,0,0"
                    FontSize="{DynamicResource BodyFontSize}"
                    Click="OnApplyHexClick" />
        </Grid>

        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   FontSize="{DynamicResource BodyFontSize}"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ResetButton"
                    Content="Reset to auto"
                    Padding="12,6" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    FontSize="{DynamicResource BodyFontSize}"
                    Click="OnResetClick" />
            <!-- Dismissal takes the secondary treatment (prd Story 4.2). This window's own actions are
                 the swatches and Apply; Close is not one of them. F-041: the treatment now comes from
                 DialogCloseButtonStyle rather than being restated here, which is what made this the
                 fifth distinct padding among nine Close buttons. -->
            <Button Content="Close" Click="OnCloseClick" Style="{StaticResource DialogCloseButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
