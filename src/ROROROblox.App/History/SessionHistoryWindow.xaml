<Window x:Class="ROROROblox.App.History.SessionHistoryWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ROROROblox.App.Controls"
        Title="History"
        Height="600" Width="700"
        MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Icon="/ROROROblox.App;component/Tray/Resources/tray-on.ico">

    <Window.Resources>
    </Window.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <controls:PageHeader Heading="History" />

            <!-- F-038. Diagnostics has carried a line like this since it shipped ("Collecting…",
                 then a capture time or "Couldn't collect diagnostics: {message}") and History never
                 did — so a read that failed and a user with no launches produced the identical
                 screen. LiveSetting is Polite because this text changes without focus moving:
                 a screen reader would otherwise announce nothing at all when a load fails. -->
            <TextBlock x:Name="StatusText"
                       FontSize="{DynamicResource BodyFontSize}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,0"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HistoryList" Margin="8" />
                </ScrollViewer>
                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <!-- Text is set in code from SessionHistoryStatus.Placeholder — an empty
                         history and an unreadable one say different things (F-038). The literals
                         that used to live here were the "no launches yet" arm, which was shown for
                         both. TextWrapping matters now: the unreadable arm is two sentences. -->
                    <TextBlock x:Name="EmptyHeadline"
                               FontSize="{DynamicResource HeadingFontSize}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="420" />
                    <TextBlock x:Name="EmptyDetail"
                               FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               Margin="0,4,0,0"
                               Opacity="0.7" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <!-- Clear history is one of the three sites DestructiveButtonStyle is assigned to by name
                 (spec §6): it destroys the session log and there is no undo. Close takes the
                 secondary treatment per prd Story 4.2. Nothing in this window is filled, and that is
                 right — History performs no action, it reports one. -->
            <Button x:Name="ClearButton" Content="Clear history"
                    Padding="12,8" Margin="0,0,8,0"
                    Style="{StaticResource DestructiveButtonStyle}"
                    Click="OnClearClick" />
            <Button Content="Close" Click="OnCloseClick" Style="{StaticResource DialogCloseButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
