<Window x:Class="ROROROblox.App.Plugins.ConsentSheet"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install plugin"
        Width="560"
        SizeToContent="Height"
        MaxHeight="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Icon="/ROROROblox.App;component/Tray/Resources/tray-on.ico">

    <Grid Margin="32,28">
        <!-- F-115, and this one is NOT like the other ten. Row 3 holds a real scroller: the
             capability list is as long as the plugin's manifest says, so it cannot become Auto and
             grow the window without bound. But a star row under SizeToContent collapses to its
             minimum, which would hide the list entirely — so the cap moves onto the Border itself
             (MaxHeight there, below) and the row becomes Auto. A short manifest now gets a compact
             sheet instead of 560px of empty; a long one grows to the cap and the ScrollViewer takes
             over, which is what it was always for. The window MaxHeight is the backstop. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header — plugin name + version -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderTitle"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource WhiteBrush}"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="HeaderVersion"
                           FontFamily="{DynamicResource MonoFontFamily}"
                           FontSize="{DynamicResource MetaFontSize}"
                           Foreground="{DynamicResource CyanBrush}" />
                <TextBlock Text=" -- "
                           FontSize="{DynamicResource BodyFontSize}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center"
                           Margin="6,0,6,0" />
                <TextBlock x:Name="HeaderPublisher"
                           FontSize="{DynamicResource BodyFontSize}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- Description block -->
        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="14,10"
                Background="{DynamicResource RowBgBrush}"
                CornerRadius="8">
            <TextBlock x:Name="HeaderDescription"
                       Foreground="{DynamicResource WhiteBrush}"
                       Opacity="0.85"
                       FontSize="{DynamicResource BodyFontSize}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Capability heading -->
        <TextBlock Grid.Row="2"
                   Text="THIS PLUGIN ASKS FOR"
                   FontFamily="{DynamicResource MonoFontFamily}"
                   FontSize="{DynamicResource MetaFontSize}"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Margin="0,18,0,8" />

        <!-- Capability list -->
        <!-- MaxHeight lives HERE rather than on the row, because SizeToContent collapses a star row
             to its minimum and would have hidden this list entirely. The Border grows with the
             manifest up to this cap and the ScrollViewer takes it from there (F-115). -->
        <Border Grid.Row="3"
                MaxHeight="280"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CapabilityList" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource RowBgBrush}"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsGranted, Mode=TwoWay}"
                                              VerticalAlignment="Top"
                                              Margin="0,2,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <!-- The capability id is tinted by which namespace it is in.
                                             This was a NamespaceBrush property on the row model
                                             resolving brushes through TryFindResource with literal
                                             fallbacks (F-087). Two things were wrong with that: a
                                             converter or property that resolves a brush at read
                                             time hands back the instance it found, and
                                             ThemeService.ApplySlot REPLACES instances rather than
                                             mutating them, so the sheet kept whatever was current
                                             when the row was built; and the literal fallback
                                             silently painted brand hues onto a themed field when
                                             the dictionary was not loaded. A DynamicResource that
                                             fails to resolve is a bug to surface, not to paper
                                             over.
                                             The tint is a SECOND carrier, never the only one: under
                                             magenta-heat Cyan and Magenta are the same value, so
                                             the two namespaces render identically there. What
                                             actually distinguishes them is NamespaceLabel below,
                                             which says either "RoRoRo enforces this on every call."
                                             or "Runs on your machine". Same ruling as the warning
                                             banners this cycle — the words carry it. -->
                                        <TextBlock Text="{Binding Id}"
                                                   FontFamily="{DynamicResource MonoFontFamily}"
                                                   FontSize="{DynamicResource MetaFontSize}"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <!-- system.*: runs on the user's machine. -->
                                                    <Setter Property="Foreground" Value="{DynamicResource MagentaBrush}" />
                                                    <Style.Triggers>
                                                        <!-- host.*: RoRoRo enforces it at the interceptor. -->
                                                        <DataTrigger Binding="{Binding IsHostEnforced}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource CyanBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Display}"
                                                   FontSize="{DynamicResource BodyFontSize}"
                                                   Foreground="{DynamicResource WhiteBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding NamespaceLabel}"
                                                   FontSize="{DynamicResource MetaFontSize}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Starts-now hint. The plugin process launches immediately once consent is granted;
             the per-row Autostart toggle on the Plugins page governs future RoRoRo launches. -->
        <Border Grid.Row="4"
                Margin="0,14,0,0"
                Padding="12,8"
                Background="{DynamicResource RowBgBrush}"
                BorderBrush="{DynamicResource CyanBrush}"
                BorderThickness="0,0,0,2"
                CornerRadius="6">
            <TextBlock Text="This plugin starts as soon as you install it. Use the Autostart toggle on the Plugins page to control whether it also launches with RoRoRo."
                       Foreground="{DynamicResource WhiteBrush}"
                       FontSize="{DynamicResource BodyFontSize}"
                       TextWrapping="Wrap"
                       Opacity="0.9" />
        </Border>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Padding="18,8" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button Style="{StaticResource CtaButtonStyle}" Content="Install"
                    Padding="22,8"
                    IsDefault="True"
                    Click="OnInstallClick" />
        </StackPanel>
    </Grid>
</Window>
